  [AgNO₃ + NaCl → AgCl + NaNO₃],
  [Zn + 2HCl → ZnCl₂ + H₂],
  [CaCO₃ → CaO + CO₂]
)

#mcq(11, [In electrolysis, oxidation occurs at the],
  [cathode],
  [salt bridge],
  [electrolyte],
  [anode]
)

#mcq(12, [During the electrolysis of molten sodium chloride, the product at the cathode is],
  [chlorine],
  [oxygen],
