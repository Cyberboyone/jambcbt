#mcq(21, [A physical education teacher commonly], [excludes all beginners to maintain standards], [records only competitive scores], [makes all clinical diagnoses independently], [plans and assesses learning through movement])

#mcq(22, [A coach commonly helps participants], [guarantee performance without practice], [develop skills and performance in an activity], [apply the same training load to all participants], [provide clinical care outside their competence])

#mcq(23, [A health educator commonly supports], [restricting health learning to sports scores], [guaranteeing a particular health outcome], [replacing all individual clinical care], [learning about health and informed decisions])

#mcq(24, [Roles of teachers, coaches and health educators], [cannot overlap under any circumstances], [are identical regardless of training or setting], [remove the need for qualified clinical care], [can overlap depending on training and setting])

