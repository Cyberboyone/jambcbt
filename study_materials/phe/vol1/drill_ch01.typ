#mcq(37, [Rest and recovery], [can be part of an activity plan], [replace an appropriately planned training load], [must be eliminated from training to ensure progress], [guarantee that injuries cannot occur])

#mcq(38, [Health decisions can be influenced by], [knowledge alone regardless of resources], [resources, environment and support as well as knowledge], [sports performance alone], [individual choice regardless of environmental conditions])

#mcq(39, [Which example is primarily a social outcome?], [naming the femur in a diagram], [identifying the action at a joint], [respecting a teammate during a game], [counting pulse beats after activity])

