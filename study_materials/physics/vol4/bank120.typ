  ]

  #sol-item(25, "D", dense: true, pad: 4.57pt)[
    *Chapter 1.* $W = 1\/2 C V^2 = 0.5 times 4.0 times 10^(-6) times 2500 = 5.0 times 10^(-3)$ J.
  ]

  #sol-item(26, "C", dense: true, pad: 4.57pt)[
    *Chapter 2.* $I = P\/V = 60\/240 = 0.25$ A.
  ]

  #sol-item(27, "B", dense: true, pad: 4.57pt)[
