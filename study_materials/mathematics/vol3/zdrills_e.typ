#mcq(22, [In an isosceles triangle the vertex angle is $36^degree$. Find each base angle.], [$72^degree$], [$144^degree$], [$77^degree$], [$27^degree$])

#mcq(23, [In a cyclic quadrilateral, one angle is $109^degree$. Find the angle opposite to it.], [$109^degree$], [$71^degree$], [$84^degree$], [$54^degree$])

#mcq(24, [Points P are $8$ cm from A and $5$ cm from B, where AB $= 6$ cm. How many positions can P occupy?], [$4$], [$3$], [$2$], [$7$])

