== E.1 Questions

#mcq(1, [Two parallel lines are cut by a transversal. One interior angle is $71^degree$. Find the co-interior angle on the same side.], [$71^degree$], [$161^degree$], [$122^degree$], [$109^degree$])

#mcq(2, [Two angles of a triangle are $56^degree$ and $35^degree$. Find the exterior angle at the third vertex.], [$91^degree$], [$89^degree$], [$104^degree$], [$74^degree$])

#mcq(3, [PT is a tangent to a circle with centre O, touching it at T. If $angle T O P = 50^degree$, find $angle O P T$.], [$50^degree$], [$40^degree$], [$130^degree$], [$140^degree$])

#mcq(4, [Points P are $8$ cm from A and $3$ cm from B, where AB $= 2$ cm. How many positions can P occupy?], [$2$], [$4$], [$0$], [$3$])

#mcq(5, [Find the area of a rhombus whose diagonals are $9$ cm and $14$ cm.], [$63$ cm²], [$126$ cm²], [$252$ cm²], [$23$ cm²])

#mcq(6, [A pyramid has a square base of side $4$ cm and height $9$ cm. Find its volume.], [$144$ cm³], [$72$ cm³], [$36$ cm³], [$48$ cm³])

#mcq(7, [A meridian is], [a circle parallel to the equator], [a small circle through the poles], [a great circle passing through both poles], [the longest parallel of latitude])

#mcq(8, [Find the gradient of a line perpendicular to one of gradient $-2$.], [$-2$], [$frac(1, 2)$], [$2$], [$-frac(1, 2)$])

#mcq(9, [In a right-angled triangle the side opposite $theta$ is $9$ cm, the side adjacent is $40$ cm and the hypotenuse is $41$ cm. Find $tan theta$.], [$frac(9, 41)$], [$frac(9, 20)$], [$frac(27, 40)$], [$frac(9, 40)$])

#mcq(10, [From a point $12$ m from the foot of a vertical tower, the angle of elevation of the top is $45^degree$. Find the height of the tower.], [$12$ m], [$24$ m], [$6$ m], [$36$ m])

#mcq(11, [Two parallel lines are cut by a transversal, forming an angle of $149^degree$ with one of them. Find the alternate angle to it.], [$31^degree$], [$59^degree$], [$149^degree$], [$162^degree$])

#mcq(12, [Two angles of a triangle are $62^degree$ and $50^degree$. Find the exterior angle at the third vertex.], [$68^degree$], [$112^degree$], [$125^degree$], [$95^degree$])

#mcq(13, [Two tangents are drawn from an external point to a circle, and the angle between them is $112^degree$. Find the angle subtended by the chord of contact at the centre.], [$112^degree$], [$81^degree$], [$51^degree$], [$68^degree$])

#mcq(14, [Points P are $8$ cm from A and $8$ cm from B, where AB $= 3$ cm. How many positions can P occupy?], [$4$], [$2$], [$3$], [$7$])

#mcq(15, [Find the area of a rhombus whose diagonals are $19$ cm and $6$ cm.], [$57$ cm²], [$114$ cm²], [$228$ cm²], [$25$ cm²])

#mcq(16, [A pyramid has a square base of side $4$ cm and height $12$ cm. Find its volume.], [$192$ cm³], [$96$ cm³], [$64$ cm³], [$48$ cm³])

#mcq(17, [Two towns on the equator differ in longitude by $30^degree$. Find the distance between them along the equator. (Take $R = 6300$ km, $pi = 22/7$.)], [$1650$ km], [$3300$ km], [$6600$ km], [$110$ km])

#mcq(18, [Find the distance between $(0, 0)$ and $(8, 15)$.], [$23$], [$120$], [$17$], [$19$])

#mcq(19, [Evaluate $cos 30^degree$.], [$sqrt(3)/2$], [$1/2$], [$sqrt(2)/2$], [$0$])

#mcq(20, [A boat sails on a bearing of $"070"^degree$ and then turns through $90^degree$ clockwise. What is its new bearing?], [$"340"^degree$], [$"185"^degree$], [$"070"^degree$], [$"160"^degree$])

