== 2.8 Chapter 2 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Lagos was annexed by Britain in],
  [1861],
  [1851],
  [1900],
  [1886]
)

#mcq(2, [The British bombardment of Lagos took place in],
  [1914],
  [1851],
  [1861],
  [1897]
)

#mcq(3, [The Berlin Conference, at which the European powers agreed the rules for the partition of Africa, was held in],
  [1897],
  [1886],
  [1900],
  [1884–85]
)

#mcq(4, [The Royal Niger Company received its charter in],
  [1914],
  [1886],
  [1900],
  [1897]
)

#mcq(5, [In 1900 the territory of the Royal Niger Company was transferred to],
  [Germany],
  [the Sokoto Caliphate],
  [the British Crown],
  [France]
)

#mcq(6, [The Northern and Southern Protectorates were amalgamated in],
  [1914],
  [1906],
  [1946],
  [1922]
)

#mcq(7, [The colonial officer who carried out the 1914 amalgamation was],
  [Sir Hugh Clifford],
  [Sir John Macpherson],
  [Sir Arthur Richards],
  [Lord Frederick Lugard]
)

#mcq(8, [The system by which the British governed through existing chiefs and traditional institutions was called],
  [assimilation],
  [indirect rule],
  [direct rule],
  [association]
)

#mcq(9, [Indirect rule worked best in],
  [the east, where village republics had no rulers],
  [the north, where emirs already ruled through a hierarchy],
  [the Middle Belt],
  [Lagos colony]
)

#mcq(10, [The warrant chiefs in Eastern Nigeria were],
  [Islamic judges],
  [traditionally recognised kings],
  [elected by the village assembly],
  [men appointed by the British to act as chiefs where none existed]
)

#mcq(11, [The Aba women's riot of 1929 was provoked mainly by],
  [the creation of the regions],
  [the annexation of Lagos],
  [the amalgamation of 1914],
  [the taxation of women and the powers of the warrant chiefs]
)

#mcq(12, [The 1929 women's protest began in],
  [Aba],
  [Lagos],
  [Enugu],
  [Kano]
)

#mcq(13, [The colonial administrative hierarchy from the top was],
  [District Officer → Resident → Governor → Chief],
  [Resident → Governor → District Officer → Emir],
  [Emir → Governor → Resident → District Officer],
  [Governor → Resident → District Officer → Native Authority]
)

#mcq(14, [A Resident in the colonial administration was responsible for],
  [a province],
  [the whole federation],
  [a village],
  [a district]
)

#mcq(15, [The policy of indirect rule in the north relied on the emir's courts because],
  [the British had abolished all courts],
  [the courts were run by the Royal Niger Company],
  [the north had no traditional rulers],
  [the emirs already administered Sharia law]
)

#mcq(16, [The main purpose of colonial taxation was to],
  [fund education in Britain],
  [build the Suez Canal],
  [subsidise Nigerian farmers],
  [pay for the administration of the colony]
)

#mcq(17, [Cash crops were encouraged in colonial Nigeria mainly to],
  [feed the colony without trade],
  [supply British industry and pay for imports],
  [reduce the money supply],
  [replace all food crops]
)

#mcq(18, [Which of the following was a legacy of colonial rule in Nigeria?],
  [The end of foreign trade],
  [A unified legal system and a centralised administration],
  [The introduction of the Sharia across the south],
  [The abolition of all traditional institutions]
)

#mcq(19, [The colonial economy in Nigeria is best described as],
  [export-oriented and dependent on primary products],
  [based on oil],
  [industrial and self-sufficient],
  [socialist]
)

#mcq(20, [The Native Authority system gave traditional rulers],
  [complete independence],
  [limited powers under the supervision of the colonial officer],
  [control of foreign policy],
  [the power to make national law]
)

#mcq(21, [Which of the following was a criticism of indirect rule?],
  [It abolished chieftaincy entirely],
  [It created a federal constitution],
  [It preserved and strengthened chiefs who were not accountable to their people],
  [It gave women the vote]
)

#mcq(22, [The Dual Mandate, Lugard's justification for colonial rule, argued that Britain had a duty to],
  [transfer the colony to France],
  [grant immediate independence],
  [develop the colony's resources and to govern its people for their own good],
  [abolish chieftaincy]
)

#mcq(23, [The Southern Protectorate and the Lagos Colony were merged in],
  [1939],
  [1906],
  [1922],
  [1914]
)

#mcq(24, [The colonial government's headquarters before the move to Abuja was],
  [Kaduna],
  [Enugu],
  [Ibadan],
  [Lagos]
)

#mcq(25, [The 1914 amalgamation is important because it],
  [ended colonial rule],
  [introduced the elective principle],
  [united the northern and southern protectorates into one colony and protectorate],
  [created the regions]
)

#mcq(26, [The indirect rule system in the east broke down because],
  [there was no single traditional ruler to govern through],
  [the people were all Christians],
  [the British refused to tax the east],
  [the east had no trade]
)

#mcq(27, [Which of the following best describes the colonial administration's attitude to Nigerian traditional rulers?],
  [It used them as agents of local administration under supervision],
  [It abolished them everywhere],
  [It gave them seats in the British Parliament],
  [It consulted them on foreign policy]
)

#mcq(28, [The colonial railway in Nigeria was built mainly to],
  [carry tourists],
  [move export crops and minerals to the coast],
  [serve the army only],
  [connect Nigeria to Chad]
)

#mcq(29, [The main reason Britain wanted Nigeria was],
  [its industrial cities],
  [its large white settler population],
  [its markets, raw materials and strategic position in West Africa],
  [its oil, discovered in 1956]
)

#mcq(30, [The colonial legal system in Nigeria combined],
  [English law, customary law and Sharia in the north],
  [only customary law],
  [only English law],
  [only Sharia]
)

#mcq(31, [The 1922 Clifford Constitution is a colonial document because],
  [it was approved in a referendum],
  [it was made by an Order in Council in London],
  [it was ratified by the Nigerian people],
  [it was written by the National Assembly]
)

#mcq(32, [Which of the following was NOT a feature of colonial administration in Nigeria?],
  [A cabinet of elected Nigerian ministers],
  [Native authorities under district officers],
  [A Legislative Council with nominated members],
  [A Governor with wide powers]
)

#mcq(33, [The colonial policy of “assimilation” is associated with],
  [Belgium only],
  [France, not Britain],
  [Portugal only],
  [Britain, not France]
)

#mcq(34, [The transfer of the Royal Niger Company's territory to the Crown in 1900 was important because it],
  [created the Sokoto Caliphate],
  [ended British influence in Nigeria],
  [gave Nigeria independence],
  [began formal colonial administration by the British government]
)

#mcq(35, [The colonial government used the Native Revenue Ordinance of 1917 to],
  [abolish taxation],
  [introduce the elective principle],
  [create the regions],
  [introduce direct taxation in the south]
)

#mcq(36, [Which of the following was a consequence of the 1929 women's war?],
  [The capital moved to Abuja],
  [The north was amalgamated with the south],
  [The colonial government reformed the warrant chief system],
  [Nigeria became independent]
)

#mcq(37, [The British colonial administration in Nigeria was headed by a],
  [Prime Minister],
  [President],
  [Resident],
  [Governor, later Governor-General]
)

#mcq(38, [The colonial economy's dependence on a few export crops made Nigeria vulnerable because],
  [a fall in the world price of one crop cut revenue and imports],
  [it produced too much food],
  [it had no ports],
  [it refused to trade with Britain]
)

#mcq(39, [The main difference between the British and French colonial systems was that the British],
  [governed through traditional institutions while the French sought to assimilate],
  [had no colonies in West Africa],
  [gave immediate independence],
  [abolished all local customs]
)

#mcq(40, [Which of the following statements about the 1914 amalgamation is correct?],
  [It created a single unified civil service with no regional differences],
  [It gave Nigerians the vote],
  [It abolished the office of Governor-General],
  [It joined two protectorates but kept separate administrations for the north and south]
)

