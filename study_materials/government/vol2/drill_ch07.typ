== 7.8 Chapter 7 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A state's foreign policy is],
  [the budget of the foreign ministry],
  [the decisions a state takes towards other states in pursuit of its national interest],
  [the laws a state makes for its citizens],
  [the ceremonies attached to a head of state]
)

#mcq(2, [The permanent element in a state's foreign policy is its],
  [ruling party],
  [currency],
  [national interest],
  [ambassador]
)

#mcq(3, [Which of the following is a component of Nigeria's national interest?],
  [Territorial integrity],
  [The size of another state's army],
  [The language of a neighbouring country],
  [The outcome of a foreign election]
)

#mcq(4, [Nigeria's foreign policy is described as Afrocentric because],
  [Nigeria deals only with African states],
  [Nigeria has left the Commonwealth],
  [Nigeria refused to join the UN],
  [Africa is the centre-piece of the policy]
)

#mcq(5, [Nigeria's foreign policy is built on the principle of],
  [permanent alignment with the West],
  [isolation from all international organisations],
  [the export of revolution],
  [the Africa centre-piece, non-alignment and respect for sovereignty]
)

#mcq(6, [In the concentric-circles model, the circle closest to the centre is],
  [Africa],
  [West Africa],
  [the national interest],
  [the world]
)

#mcq(7, [The Treaty of Lagos of 1975 established],
  [the OAU],
  [the African Union],
  [ECOWAS],
  [the Commonwealth]
)

#mcq(8, [The year ECOWAS came into being was],
  [1963],
  [1975],
  [1990],
  [2002]
)

#mcq(9, [The OAU was founded in 1963 at],
  [Accra],
  [Lagos],
  [Addis Ababa],
  [Abuja]
)

#mcq(10, [The African Union replaced the OAU in],
  [2004],
  [2002],
  [2000],
  [1999]
)

#mcq(11, [Nigeria joined the United Nations in],
  [1945],
  [1971],
  [1960],
  [1963]
)

#mcq(12, [Nigeria became a member of OPEC in],
  [1960],
  [1963],
  [1971],
  [1975]
)

#mcq(13, [Nigeria's membership of OPEC is an example of],
  [a judicial instrument],
  [an economic instrument of foreign policy],
  [a military instrument],
  [a cultural instrument]
)

#mcq(14, [ECOMOG was the military force of],
  [the United Nations],
  [the Commonwealth],
  [the African Union],
  [ECOWAS]
)

#mcq(15, [ECOMOG intervened in Liberia in],
  [1990],
  [1960],
  [1975],
  [1999]
)

#mcq(16, [Nigeria's first major peacekeeping operation was in],
  [the Congo, in 1960],
  [Sierra Leone, in 1997],
  [Darfur, in 2003],
  [Liberia, in 1990]
)

#mcq(17, [The Technical Aid Corps was established in],
  [1999],
  [2002],
  [1975],
  [1987]
)

#mcq(18, [A Nigerian ambassador is],
  [the personal representative of the head of state in a foreign country],
  [an elected official of the host country],
  [an officer of the United Nations],
  [a judge of the International Court of Justice]
)

#mcq(19, [The ministry responsible for the conduct of Nigeria's foreign relations is the],
  [Ministry of Foreign Affairs],
  [Ministry of Defence],
  [Ministry of Interior],
  [Ministry of Trade]
)

#mcq(20, [Which of the following is a diplomatic instrument of foreign policy?],
  [The customs tariff],
  [A cultural festival],
  [The army],
  [The embassy and the note verbale]
)

#mcq(21, [Sanctions imposed on a state are an example of],
  [a diplomatic courtesy],
  [a judicial remedy],
  [a cultural exchange],
  [an economic instrument]
)

#mcq(22, [The Commonwealth suspended Nigeria in 1995 after],
  [the execution of Ken Saro-Wiwa and eight others],
  [the civil war],
  [the annulment of June 12],
  [the creation of the FCT]
)

#mcq(23, [The Commonwealth is],
  [a military alliance],
  [an African regional organisation],
  [a UN specialised agency],
  [a voluntary association of states, most of them formerly British]
)

#mcq(24, [Non-alignment in Nigeria's foreign policy meant],
  [leaving the United Nations],
  [refusing all foreign trade],
  [joining the Western alliance],
  [refusing to join either Cold War bloc]
)

#mcq(25, [Which of the following most limits Nigeria's influence in world affairs?],
  [Its seat on the AU],
  [Its membership of the Commonwealth],
  [Its dependence on a single export commodity],
  [Its large population]
)

#mcq(26, [Nigeria's economic diplomacy is handicapped by],
  [the monocultural export economy],
  [too many embassies],
  [the absence of a foreign ministry],
  [its membership of ECOWAS]
)

#mcq(27, [Which of the following is an achievement of Nigeria's foreign policy?],
  [Withdrawal from the United Nations],
  [Leadership of the anti-apartheid campaign and of ECOWAS peacekeeping],
  [The abolition of the AU],
  [The colonisation of a neighbouring state]
)

#mcq(28, [Nigeria served as a non-permanent member of the UN Security Council in],
  [2010–11],
  [2002–03],
  [1960–61],
  [1994–95]
)

#mcq(29, [The principle of sovereign equality in international relations means that],
  [all states have equal legal standing regardless of size],
  [the strongest state decides],
  [only the permanent members of the Security Council count],
  [states may not sign treaties]
)

#mcq(30, [Nigeria's foreign policy towards South Africa during apartheid was to],
  [ignore the issue],
  [send troops to defend it],
  [campaign for sanctions and isolation],
  [trade openly with the apartheid government]
)

#mcq(31, [The African Continental Free Trade Area was signed by Nigeria in],
  [2015],
  [2017],
  [2019],
  [2021]
)

#mcq(32, [The diaspora is important to Nigerian foreign policy because],
  [they vote in foreign elections],
  [they are all diplomats],
  [they are excluded from consular services],
  [Nigerians abroad send remittances and can lobby for the country]
)

#mcq(33, [Which of the following is a constraint on Nigeria's leadership in Africa?],
  [Its membership of ECOWAS],
  [Domestic instability and human-rights criticisms],
  [Its large population],
  [Its oil reserves]
)

#mcq(34, [A foreign policy that reacts to events without a settled strategy is described as],
  [ad hoc],
  [multilateral],
  [bilateral],
  [Afrocentric]
)

#mcq(35, [Bilateral diplomacy is conducted between],
  [two states],
  [a state and an international organisation],
  [three or more states],
  [two organs of one government]
)

#mcq(36, [The UN organ that admits new member states is the],
  [International Court of Justice],
  [Secretariat],
  [Trusteeship Council],
  [General Assembly, on the recommendation of the Security Council]
)

#mcq(37, [Which of the following best explains Nigeria's interest in West Africa?],
  [Neighbouring instability spills across its borders],
  [The region supplies most of its oil],
  [West Africa controls the UN],
  [The region is a source of nuclear weapons]
)

#mcq(38, [Nigeria's mediation in Sierra Leone in the late 1990s shows],
  [the irrelevance of ECOWAS],
  [the use of the military and diplomatic instruments together],
  [the end of Nigerian peacekeeping],
  [the dominance of the cultural instrument]
)

#mcq(39, [A state's foreign policy is made by],
  [the civil service alone],
  [the executive, through the head of state and the foreign ministry],
  [the judiciary alone],
  [foreign governments]
)

#mcq(40, [Which of the following statements about Nigeria and the UN is correct?],
  [Nigeria has never been a UN member],
  [Nigeria has served on the Security Council but does not hold a permanent seat],
  [Nigeria holds a permanent seat with a veto],
  [Nigeria left the UN in 1999]
)

