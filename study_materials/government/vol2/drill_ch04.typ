== 4.8 Chapter 4 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A system in which power is divided between a central government and component units, each supreme in its own sphere, is called],
  [a confederation],
  [a unitary system],
  [a federal system],
  [a parliamentary system]
)

#mcq(2, [Nigeria adopted federalism partly because],
  [the country is large and ethnically diverse],
  [it wanted to join a confederation],
  [the colonial government had governed it as a unitary state],
  [it had a single ethnic group]
)

#mcq(3, [Only the National Assembly may legislate on subjects contained in the],
  [exclusive list],
  [residual list],
  [local government list],
  [concurrent list]
)

#mcq(4, [Which of the following is on the exclusive legislative list?],
  [Markets],
  [Education],
  [Defence],
  [Agriculture]
)

#mcq(5, [Which of the following is a concurrent legislative matter?],
  [Foreign affairs],
  [Chieftaincy],
  [Education],
  [Currency and coinage]
)

#mcq(6, [Chieftaincy is a matter for the states because it is on the],
  [federal list],
  [concurrent list],
  [exclusive list],
  [residual list]
)

#mcq(7, [Where a state law is inconsistent with a federal law on a concurrent matter, the state law is],
  [supreme],
  [void to the extent of the inconsistency],
  [referred to the Supreme Court automatically],
  [void in its entirety]
)

#mcq(8, [The doctrine applied when federal and state laws conflict on a concurrent matter is],
  [ultra vires],
  [judicial notice],
  [stare decisis],
  [covering the field]
)

#mcq(9, [The number of states in Nigeria is],
  [37],
  [36],
  [30],
  [19]
)

#mcq(10, [The Federal Capital Territory was created in],
  [1976],
  [1967],
  [1991],
  [1996]
)

#mcq(11, [The last creation of states in Nigeria took place in],
  [1991],
  [1999],
  [1987],
  [1996]
)

#mcq(12, [How many local government areas are there in Nigeria?],
  [744],
  [774],
  [776],
  [768]
)

#mcq(13, [A new state is created by],
  [the state house of assembly],
  [the National Assembly with a two-thirds majority of the states],
  [the President by executive order],
  [the Supreme Court]
)

#mcq(14, [A new local government area is created by],
  [the state house of assembly],
  [the National Assembly],
  [the Federal Executive Council],
  [the local government council alone]
)

#mcq(15, [The main reason for creating more states in Nigeria has been],
  [to reduce the number of local governments],
  [to increase the size of each unit],
  [to bring government closer to the people and satisfy minority demands],
  [to weaken the federal government]
)

#mcq(16, [In 1967 the regions were replaced by],
  [four regions],
  [nineteen states],
  [thirty states],
  [twelve states]
)

#mcq(17, [The revenue of the federation is shared among the tiers of government by],
  [the National Assembly],
  [the Federal Inland Revenue Service],
  [the Central Bank of Nigeria],
  [the Federation Account Allocation Committee]
)

#mcq(18, [The 13 per cent of oil revenue paid to the oil-producing states is based on the principle of],
  [population],
  [need],
  [derivation],
  [equality of states]
)

#mcq(19, [Which principle of revenue allocation favours the most populous states?],
  [Internal revenue effort],
  [Population],
  [Equality of states],
  [Derivation]
)

#mcq(20, [The principle of equality of states in revenue allocation],
  [rewards a state that raises more tax],
  [gives every state an equal share],
  [pays the producing state],
  [gives the poorest states the largest share]
)

#mcq(21, [The federal character principle is intended to],
  [ensure that federal appointments reflect Nigeria's diversity],
  [abolish the civil service],
  [guarantee each state a share of oil],
  [make all states equal in size]
)

#mcq(22, [A criticism of the federal character principle is that it],
  [weakens the federal government],
  [prevents revenue sharing],
  [abolishes state governments],
  [can sacrifice merit to a quota]
)

#mcq(23, [Local governments in Nigeria derive their statutory revenue from],
  [the state house of assembly],
  [the Central Bank],
  [foreign donors],
  [the Federation Account]
)

#mcq(24, [Which of these services is provided by a local government council?],
  [Making treaties],
  [Defence of the country],
  [Collection of market tolls and rates],
  [Coining money]
)

#mcq(25, [The main problem of local government in Nigeria is],
  [excessive financial autonomy],
  [inadequate finance and undue state control],
  [the absence of any functions],
  [too few councils]
)

#mcq(26, [A federal system differs from a confederation in that in a federation],
  [there is no constitution],
  [the central government can act directly on citizens],
  [the states may secede at will],
  [the centre is the creature of the states]
)

#mcq(27, [Which of the following is a feature of Nigerian federalism?],
  [A single constitution for the whole country],
  [The right of states to make treaties],
  [The absence of a Supreme Court],
  [Separate constitutions for each state]
)

#mcq(28, [The Supreme Court's role in Nigerian federalism is to],
  [settle disputes between the federal and state governments],
  [appoint state governors],
  [create states],
  [collect federal revenue]
)

#mcq(29, [Fiscal federalism refers to],
  [the appointment of judges],
  [the federal character principle],
  [the division of taxing and spending powers between the levels of government],
  [the creation of states]
)

#mcq(30, [The argument for a strong federal government in Nigeria is that it],
  [holds the country together and redistributes revenue to poorer states],
  [abolishes local government],
  [weakens the states],
  [ends the need for a constitution]
)

#mcq(31, [The argument against a strong federal government is that it],
  [concentrates power and makes the states dependent],
  [weakens the army],
  [creates too many states],
  [abolishes the courts]
)

#mcq(32, [Which of the following subjects is on the concurrent list?],
  [Agriculture],
  [Chieftaincy],
  [Currency],
  [Citizenship]
)

#mcq(33, [The exclusive list contains all of the following except],
  [defence],
  [foreign affairs],
  [police],
  [markets and motor parks]
)

#mcq(34, [The federal government's power to legislate for the peace, order and good government of the federation is found in],
  [section 42],
  [section 8],
  [section 4 of the 1999 Constitution],
  [section 14]
)

#mcq(35, [A state in Nigeria may legislate on a matter on the residual list because],
  [the Supreme Court permits it],
  [the list is not assigned to the federation],
  [the National Assembly delegates it],
  [the Constitution expressly grants it]
)

#mcq(36, [Which of the following is a consequence of the creation of more states?],
  [A smaller federal government],
  [More administrative units and a larger share of federal revenue going to state administrations],
  [The end of revenue allocation],
  [The abolition of local government]
)

#mcq(37, [The Federal Capital Territory is administered by],
  [a local government chairman],
  [a state governor],
  [the Senate],
  [a minister appointed by the President]
)

#mcq(38, [The Nigerian federation is described as “centripetal” because],
  [the states have become stronger],
  [local government has been abolished],
  [power and revenue have moved towards the centre over time],
  [the regions were restored]
)

#mcq(39, [One difference between the 1963 and 1999 federal arrangements is that],
  [the 1963 Constitution had a unitary system],
  [the 1963 Constitution had regions while the 1999 Constitution has states],
  [the 1963 Constitution had no federal government],
  [the 1999 Constitution abolished the states]
)

#mcq(40, [A boundary dispute between two states is settled by],
  [the local government council],
  [the National Assembly],
  [the Supreme Court],
  [the President's directive]
)

