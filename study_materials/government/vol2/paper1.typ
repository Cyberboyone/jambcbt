== Section A — The pre-colonial systems and colonial rule (Questions 1–10)

#mcq(1, [In the Sokoto Caliphate, an emir held his emirate as],
  [an appointment from the caliph, who could depose him],
  [a hereditary kingdom independent of Sokoto],
  [an office elected by the emirate council],
  [a grant from the British Resident]
)

#mcq(2, [The jihad of 1804 was directed primarily against],
  [the British colonial administration],
  [the Igbo village republics],
  [the Hausa kingdoms of the north],
  [the Yoruba kingdoms]
)

#mcq(3, [An appeal from an Alkali court in the emirate system went to],
  [the Oyomesi],
  [the emir, and ultimately the caliph],
  [the British Resident],
  [the village assembly]
)

#mcq(4, [The Oyomesi of Oyo were made up of],
  [the commanders of the cavalry],
  [seven senior chiefs led by the Bashorun],
  [the king's household slaves],
  [three regional governors]
)

#mcq(5, [The ofo title in Igboland symbolised],
  [membership of the emirate council],
  [military command],
  [the right to collect taxes],
  [truth and ancestral authority]
)

#mcq(6, [The oracle at Arochukwu was known as],
  [Ibini Ukpabi],
  [Alkali],
  [Alaafin],
  [Ofo]
)

#mcq(7, [Indirect rule was adapted in Yorubaland because],
  [Obas and chiefs existed but their authority was more limited than that of the emirs],
  [the region was governed by Sharia],
  [there were no traditional rulers at all],
  [the British had abolished chieftaincy]
)

#mcq(8, [A Native Authority in Northern Nigeria exercised],
  [only judicial functions],
  [executive, judicial and fiscal functions under British supervision],
  [only military functions],
  [no functions at all]
)

#mcq(9, [After the 1929 women's war, the colonial government replaced many warrant chiefs with],
  [elected members of parliament],
  [emirs],
  [clan councils],
  [British district officers]
)

#mcq(10, [The Royal Niger Company lost its governing charter when its territory was transferred to the Crown in],
  [1922],
  [1886],
  [1900],
  [1914]
)

