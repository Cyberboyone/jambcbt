== 6.8 Chapter 6 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [The term public administration refers to],
  [the management of private companies],
  [the study of government revenue and expenditure],
  [the machinery and process by which the state implements its policies],
  [the conduct of elections]
)

#mcq(2, [Which of the following distinguishes public administration from private administration?],
  [Public administration is funded by taxation and accountable to the legislature],
  [Public administration seeks profit],
  [Private administration serves citizens who cannot choose],
  [Public administration has no employees]
)

#mcq(3, [The civil service is made up of],
  [the judges of the superior courts],
  [the elected members of parliament],
  [the officers of the ruling party],
  [the body of permanent officials who advise ministers and administer departments]
)

#mcq(4, [Which of the following is a tier of the civil service?],
  [The administrative class],
  [The legislature],
  [The judiciary],
  [The electorate]
)

#mcq(5, [The permanent secretary in a ministry is],
  [the minister's private secretary],
  [the political head of the ministry],
  [the administrative head of the ministry],
  [an elected official]
)

#mcq(6, [The civil service canon of permanence means that],
  [civil servants cannot retire],
  [the service is above the law],
  [civil servants are elected],
  [the service continues through changes of government]
)

#mcq(7, [The canon of anonymity means that a civil servant],
  [cannot join a union],
  [must be anonymous in the office],
  [cannot vote],
  [does not speak publicly for government policy]
)

#mcq(8, [The canon of impartiality requires a civil servant to],
  [join the ruling party],
  [serve whichever party is in power with equal loyalty],
  [avoid all political discussion in private],
  [refuse to serve a government he did not vote for]
)

#mcq(9, [Recruitment into the Nigerian civil service is expected to be based on],
  [ethnic quota alone],
  [political loyalty alone],
  [merit through examination and record],
  [purchase of office]
)

#mcq(10, [The body that appoints and disciplines federal civil servants is the],
  [Federal Civil Service Commission],
  [National Assembly],
  [Federal Executive Council],
  [Supreme Court]
)

#mcq(11, [The Udoji Commission of 1972–74 is remembered for],
  [the review of the public service and its remuneration],
  [the creation of local government],
  [the introduction of the elective principle],
  [the creation of states]
)

#mcq(12, [The Steve Oronsaye Committee of 2011–12 recommended],
  [the merging and scrapping of agencies to cut the cost of governance],
  [the end of the federal system],
  [the creation of more agencies],
  [the abolition of the civil service]
)

#mcq(13, [A public corporation is],
  [a private company listed on the stock exchange],
  [a department of the civil service],
  [a statutory body owned by the state and run on commercial lines],
  [a local government council]
)

#mcq(14, [Public corporations in Nigeria are established by],
  [an Act of the legislature],
  [a ministerial directive],
  [a resolution of the council of ministers],
  [a court order]
)

#mcq(15, [Which of the following is a reason for creating a public corporation?],
  [To provide a service that private capital cannot profitably provide],
  [To make a profit for shareholders],
  [To avoid accountability],
  [To abolish the civil service]
)

#mcq(16, [Which of the following is a problem of public corporations in Nigeria?],
  [Overstaffing and political interference],
  [Too little government funding],
  [The absence of any board],
  [Excessive competition]
)

#mcq(17, [Privatisation means],
  [the merging of two public corporations],
  [the abolition of a corporation's board],
  [the transfer of ownership from private shareholders to the state],
  [the transfer of ownership from the state to private shareholders]
)

#mcq(18, [Commercialisation differs from privatisation in that commercialisation],
  [transfers it to a local government],
  [abolishes the enterprise],
  [sells the enterprise to private owners],
  [keeps the enterprise in public ownership but requires it to cover its costs]
)

#mcq(19, [Deregulation in the context of public enterprise means],
  [increasing subsidies],
  [removing legal barriers to private participation],
  [abolishing all laws],
  [nationalising the banks]
)

#mcq(20, [Local government in Nigeria is the],
  [third tier of government],
  [second tier of government],
  [first tier of government],
  [fourth tier of government]
)

#mcq(21, [Which of the following is a source of local government revenue?],
  [Oil royalties],
  [Company income tax],
  [Import duty],
  [Statutory allocation from the Federation Account]
)

#mcq(22, [Which of the following is a local government function in Nigeria?],
  [Defence of the country],
  [Refuse disposal and sanitation],
  [Making treaties],
  [Coining money]
)

#mcq(23, [The main problem of local government finance in Nigeria is],
  [excessive internally generated revenue],
  [dependence on allocations that arrive late and are inadequate],
  [too much foreign aid],
  [the absence of any statutory allocation]
)

#mcq(24, [Undue state control of local government is shown by],
  [the election of councillors],
  [the council's power to collect rates],
  [the state's power to dissolve a council and appoint a caretaker committee],
  [the council's power to make by-laws]
)

#mcq(25, [The Public Complaints Commission is],
  [a department of the police],
  [a prosecuting agency],
  [the Nigerian ombudsman],
  [a court of law]
)

#mcq(26, [The main weakness of the Public Complaints Commission is that its findings are],
  [appealable only to the President],
  [secret],
  [limited to the army],
  [not binding]
)

#mcq(27, [The Code of Conduct Bureau is responsible for],
  [receiving the asset declarations of public officers],
  [auditing the accounts of the federation],
  [conducting elections],
  [prosecuting armed robbers]
)

#mcq(28, [The Auditor-General of the Federation is responsible for],
  [appointing civil servants],
  [auditing the public accounts and reporting to the National Assembly],
  [preparing the budget],
  [collecting taxes]
)

#mcq(29, [The EFCC and the ICPC differ from the Public Complaints Commission because they],
  [are part of the civil service],
  [investigate and prosecute crime rather than recommend remedies],
  [deal only with the army],
  [are courts]
)

#mcq(30, [Which of the following is a form of legislative control over the civil service?],
  [The transfer of permanent secretaries],
  [The promotion of directors],
  [The appointment of the head of service],
  [Approval of the budget and summoning of officials]
)

#mcq(31, [Judicial control of the administration is exercised through],
  [judicial review of administrative acts],
  [the budget],
  [the census],
  [the appointment of ministers]
)

#mcq(32, [The head of the Nigerian civil service is the],
  [Auditor-General],
  [Head of the Civil Service of the Federation],
  [Secretary to the Government of the Federation],
  [President]
)

#mcq(33, [Which of the following best describes the relationship between a minister and a permanent secretary?],
  [The permanent secretary is political and the minister administrative],
  [Both are elected],
  [The minister is political and the permanent secretary is administrative],
  [Both are judges]
)

#mcq(34, [The civil service is said to be “permanent” but not “sovereign” because],
  [it can dismiss the president],
  [it serves the government of the day and cannot override it],
  [it makes the laws],
  [it commands the army]
)

#mcq(35, [A ministry differs from a parastatal in that a ministry],
  [has its own board and accounts],
  [is owned by private shareholders],
  [is created by an Act of the legislature],
  [is a department of government without separate legal personality]
)

#mcq(36, [The main argument for privatisation in Nigeria has been that],
  [the state should own more enterprises],
  [private firms always lose money],
  [state enterprises are inefficient and drain public funds],
  [privatisation creates more civil servants]
)

#mcq(37, [Which of the following is an accountability institution in Nigeria?],
  [The Code of Conduct Bureau],
  [The Federal Civil Service Commission],
  [The National Population Commission],
  [The Nigerian Railway Corporation]
)

#mcq(38, [The main criticism of the civil service in Nigeria has been],
  [excessive speed in decision-making],
  [inefficiency, corruption and resistance to reform],
  [the absence of any rules],
  [too few ministries]
)

#mcq(39, [The 1988 civil service reform under Babangida is remembered for],
  [the abolition of local government],
  [the creation of the FCT],
  [the introduction of the elective principle],
  [the attempt to make permanent secretaries political appointees]
)

#mcq(40, [The Treasury Single Account was introduced to],
  [create more public corporations],
  [replace the Auditor-General],
  [abolish the civil service],
  [consolidate government accounts at the Central Bank and control leakages]
)

