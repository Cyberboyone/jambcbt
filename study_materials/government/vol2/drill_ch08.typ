== 8.8 Chapter 8 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [An election may be defined as],
  [a formal procedure by which eligible citizens choose their rulers],
  [the counting of the census],
  [a debate between candidates],
  [the registration of political parties]
)

#mcq(2, [Which of the following is a function of elections?],
  [To collect taxes],
  [To legitimise a government],
  [To write the constitution],
  [To appoint judges]
)

#mcq(3, [The electoral system in which the candidate with the highest number of votes in a constituency wins is called],
  [proportional representation],
  [the party list system],
  [the single transferable vote],
  [first past the post]
)

#mcq(4, [Nigeria uses which electoral system for the National Assembly?],
  [A pure party list],
  [First past the post],
  [Proportional representation],
  [The single transferable vote]
)

#mcq(5, [Under proportional representation, seats are allocated],
  [to the candidate with the most votes in a constituency],
  [by the president],
  [to the party that wins the most constituencies],
  [in proportion to the votes a party receives]
)

#mcq(6, [The advantage of proportional representation is that it],
  [is fair to small parties],
  [abolishes the need for parties],
  [always produces a single-party majority],
  [is simple for the voter]
)

#mcq(7, [The main disadvantage of first past the post is that it],
  [prevents a clear winner],
  [always produces a coalition],
  [wastes votes and can exaggerate a party's majority],
  [is too complicated for voters]
)

#mcq(8, [The Independent National Electoral Commission was established in],
  [2010],
  [1999],
  [1998],
  [2002]
)

#mcq(9, [Which of the following is a function of INEC?],
  [Prosecuting armed robbers],
  [Registering voters and political parties],
  [Auditing public accounts],
  [Appointing judges]
)

#mcq(10, [INEC does NOT conduct],
  [National Assembly elections],
  [presidential elections],
  [local government elections],
  [gubernatorial elections]
)

#mcq(11, [The independence of INEC rests on],
  [the support of the ruling party],
  [a direct charge on the Consolidated Revenue Fund and security of tenure],
  [the appointment of its chairman by the Chief Justice],
  [foreign funding]
)

#mcq(12, [The Permanent Voter Card is issued to],
  [a candidate],
  [an election observer],
  [a registered voter],
  [a party chairman]
)

#mcq(13, [The continuous voter registration exercise is conducted by],
  [the political parties],
  [the state governments],
  [INEC],
  [the police]
)

#mcq(14, [BIVAS stands for],
  [Bimodal Verification and Accreditation System],
  [Bimodal Voter Accreditation System],
  [Basic Voter Accreditation System],
  [Biometric Voter Authentication Service]
)

#mcq(15, [The Electoral Act 2022 introduced all of the following except],
  [the smart card reader],
  [the over-voting review],
  [BIVAS],
  [electronic transmission of results]
)

#mcq(16, [Electronic transmission of results under the 2022 Act is subject to],
  [a court order in each state],
  [the approval of the opposition],
  [the consent of the polling agents],
  [the network coverage certified by the regulator]
)

#mcq(17, [The seven stages of the electoral cycle begin with],
  [collation],
  [voting],
  [registration],
  [the petition]
)

#mcq(18, [Accreditation at the polling unit is the stage at which],
  [the petition is filed],
  [the voter's identity is verified],
  [the result is announced],
  [the candidates are nominated]
)

#mcq(19, [Collation is the process of],
  [adding up and reconciling the results from the polling units],
  [nominating candidates],
  [printing ballot papers],
  [registering voters]
)

#mcq(20, [An election is described as free when],
  [the rules apply equally to all parties],
  [the commission is funded by the state],
  [the voter can choose without fear or payment],
  [the result is announced on time]
)

#mcq(21, [An election is described as fair when],
  [the turnout is high],
  [the rules apply equally and the count is transparent],
  [the voter is not intimidated],
  [the ruling party wins]
)

#mcq(22, [Vote-buying is an attack on which value of an election?],
  [The freedom of the voter's choice],
  [The accuracy of the register],
  [The independence of the judiciary],
  [The speed of collation]
)

#mcq(23, [SNatching of ballot boxes is an attack on],
  [the nomination stage],
  [the registration stage],
  [the petition stage],
  [the voting stage]
)

#mcq(24, [The alteration of result figures at a collation centre is an attack on],
  [the accreditation stage],
  [the collation stage],
  [the campaign stage],
  [the registration stage]
)

#mcq(25, [A petition against a National Assembly election is filed at the],
  [Supreme Court],
  [Court of Appeal],
  [National Assembly Election Petitions Tribunal],
  [Federal High Court]
)

#mcq(26, [A petition against a presidential election is first filed at the],
  [High Court of the FCT],
  [Court of Appeal, sitting as the Presidential Election Petition Court],
  [Federal High Court],
  [Supreme Court]
)

#mcq(27, [A presidential election petition must be filed within],
  [30 days],
  [180 days],
  [60 days],
  [21 days of the declaration of the result]
)

#mcq(28, [The tribunal must deliver judgment in an election petition within],
  [the life of the parliament],
  [90 days],
  [180 days],
  [one year]
)

#mcq(29, [The rule that a declared result cannot exceed the number of accredited voters is known as],
  [the plurality rule],
  [the covering-the-field rule],
  [the federal character rule],
  [the over-voting rule]
)

#mcq(30, [A returning officer is responsible for],
  [hearing the petition],
  [registering voters],
  [declaring the result of an election in a constituency],
  [nominating candidates]
)

#mcq(31, [Which of the following is an election offence?],
  [Registering to vote],
  [Multiple voting],
  [Attending a campaign rally],
  [Casting a single ballot]
)

#mcq(32, [The principle of the secret ballot means that],
  [the register is secret],
  [candidates are chosen in secret],
  [the count is secret],
  [no one can know how a voter voted]
)

#mcq(33, [Election observers are accredited to],
  [declare the result],
  [nominate candidates],
  [observe and report on the conduct of the election],
  [count the votes]
)

#mcq(34, [The main purpose of delimiting constituencies is to],
  [help the ruling party],
  [increase the number of parties],
  [reduce the number of voters],
  [ensure roughly equal representation for equal populations]
)

#mcq(35, [Gerrymandering means],
  [the disqualification of a candidate],
  [the disruption of collation],
  [the buying of votes],
  [the manipulation of constituency boundaries for political advantage]
)

#mcq(36, [Which of the following best explains why local government elections are often criticised?],
  [They are observed by the UN],
  [They are conducted by commissions controlled by the state government],
  [They are conducted by INEC],
  [They use proportional representation]
)

#mcq(37, [A free and fair election requires all of the following except],
  [a transparent count],
  [an independent electoral commission],
  [a single candidate],
  [an accurate register]
)

#mcq(38, [The 2023 general election was significant because it was the first to use],
  [proportional representation],
  [the smart card reader],
  [electronic voting machines],
  [BIVAS nationwide]
)

#mcq(39, [The main reason a candidate goes to an election petition tribunal is to],
  [register to vote],
  [challenge the validity of the result],
  [nominate a running mate],
  [observe the election]
)

#mcq(40, [Which of the following is a consequence of a flawed register?],
  [Eligible voters are excluded and ghost voters are included],
  [The count becomes more accurate],
  [The tribunal is abolished],
  [The parties are dissolved]
)

