== 1.8 Chapter 1 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [The Sokoto Caliphate was founded in 1804 by],
  [Muhammad Bello],
  [Muhammad Rumfa],
  [Usman dan Fodio],
  [Shehu al-Kanemi]
)

#mcq(2, [In the Hausa–Fulani emirate, the emir was appointed by],
  [the district heads],
  [the Alkali court],
  [the emirate council],
  [the caliph, and could be deposed by him]
)

#mcq(3, [The emirate council in the Hausa–Fulani system was made up of],
  [the Alkali judges alone],
  [senior officials and title holders who advised the emir],
  [the army commanders alone],
  [elected representatives of the villages]
)

#mcq(4, [The Alkali courts in the emirate system applied],
  [the law of the caliphate's traders],
  [English common law],
  [customary law only],
  [Sharia law]
)

#mcq(5, [Which of the following was the basic unit of administration below the emir?],
  [The council of elders],
  [The parliament],
  [The age grade],
  [The district, headed by a district head]
)

#mcq(6, [One important check on the power of an emir was],
  [the absence of any court],
  [the right of the emir to legislate alone],
  [the right of the emirate council to advise and restrain him],
  [the election of the emir by the army]
)

#mcq(7, [The Yoruba political system is best described as],
  [a pure democracy],
  [a centralised monarchy with checks on the Oba],
  [a stateless society],
  [a military dictatorship]
)

#mcq(8, [The Alaafin of Oyo was checked by],
  [the Alkali court],
  [the Oyomesi, led by the Bashorun],
  [the emirate council],
  [the British governor]
)

#mcq(9, [The head of the Oyomesi in Oyo was the],
  [Bashorun],
  [Alaafin],
  [Oba],
  [Are-Ona-Kakanfo]
)

#mcq(10, [The Are-Ona-Kakanfo in the Oyo empire was],
  [the chief of the market],
  [the king's eldest son],
  [the commander of the army],
  [the head of the judiciary]
)

#mcq(11, [Which Yoruba institution gave women a recognised political voice?],
  [The Iyalode],
  [The Alkali],
  [The Emirate Council],
  [The Ozo]
)

#mcq(12, [The Igbo political system is usually described as],
  [a military state],
  [acephalous and segmentary],
  [a theocracy],
  [a centralised monarchy]
)

#mcq(13, [The council of elders in an Igbo community derived its authority mainly from],
  [age, wisdom and the ofo title],
  [appointment by a king],
  [election by the army],
  [the colonial governor]
)

#mcq(14, [The Ozo title society in Igboland was important because it],
  [commanded the army],
  [gave its holders status and a voice in the assembly],
  [judged cases under Sharia],
  [collected taxes for the emir]
)

#mcq(15, [Which Igbo institution regulated the conduct of young men and carried out public works?],
  [The Alkali court],
  [The emirate council],
  [The Oyomesi],
  [The age grade]
)

#mcq(16, [The oracle at Arochukwu was significant in pre-colonial Igboland because it],
  [appointed the emir],
  [collected the emir's taxes],
  [commanded the Oyo army],
  [served as a court of appeal in disputes]
)

#mcq(17, [In the Igbo village republic, decisions were generally taken by],
  [the king's decree],
  [consensus reached in the assembly of elders and title holders],
  [a majority vote in a parliament],
  [the oracle alone]
)

#mcq(18, [A major difference between the Igbo and the Hausa–Fulani systems was that the Igbo system],
  [was ruled by an emir],
  [had a written constitution],
  [was based on Sharia law],
  [had no single ruler at the head of the community]
)

#mcq(19, [The pre-colonial Yoruba and Hausa–Fulani systems were similar in that both],
  [had no courts],
  [were acephalous],
  [were governed by age grades],
  [had a ruler advised by a council of chiefs]
)

#mcq(20, [The pre-colonial economy of the emirate was financed mainly by],
  [income tax on salaries],
  [foreign aid],
  [tribute, taxes and trade],
  [oil revenue]
)

#mcq(21, [Trans-Saharan trade was important to the Hausa–Fulani states because it],
  [brought salt, horses and manufactured goods in exchange for leather and slaves],
  [replaced agriculture entirely],
  [was conducted only by Europeans],
  [was banned by the caliph]
)

#mcq(22, [The sokoto caliphate's system of government is best described as],
  [a federation of emirates under a caliph],
  [a single unitary province],
  [a stateless society],
  [a colonial protectorate]
)

#mcq(23, [Which of the following was NOT a feature of the Igbo village republic?],
  [The Ozo title society],
  [Age-grade associations],
  [A hereditary emir with a council],
  [A council of elders]
)

#mcq(24, [The office of the Oba in Yorubaland was usually filled by],
  [purchase of the title],
  [appointment by the British],
  [election by the whole town],
  [appointment by the Oyomesi from the ruling house]
)

#mcq(25, [The main judicial institution in the Yoruba towns was],
  [the market association],
  [the Oba's court, with chiefs sitting as judges],
  [the age grade],
  [the Alkali court]
)

#mcq(26, [Pre-colonial administration in Nigeria is best studied because it],
  [explains the institutions that indirect rule later used],
  [shows that all Nigerian societies were the same],
  [proves that Nigeria had a written constitution],
  [shows that the British created every Nigerian institution]
)

#mcq(27, [Under the emirate system, the caliph's authority over an emir was exercised through],
  [the Alkali courts alone],
  [a written constitution],
  [advice, appointment and the power of deposition],
  [a parliament]
)

#mcq(28, [The Yoruba system of checks on the Alaafin included],
  [a referendum],
  [impeachment by the Senate],
  [the presentation of an empty calabash, signalling rejection],
  [a vote of no confidence in parliament]
)

#mcq(29, [The Igbo village assembly was usually held],
  [in the emir's palace],
  [in the Alkali court],
  [in the Oba's palace],
  [in the market square or the village square]
)

#mcq(30, [Which of the following statements about pre-colonial Nigerian societies is correct?],
  [None of them had any courts],
  [All of them had a single king],
  [All of them were governed by Sharia],
  [They differed in structure, from centralised emirates to stateless villages]
)

#mcq(31, [The position of women in pre-colonial Yoruba politics was recognised through the office of],
  [the Iyalode],
  [the Ozo],
  [the Alkali],
  [the Bashorun]
)

#mcq(32, [The emir's judicial authority was exercised through],
  [the market association],
  [the Alkali courts and his own court of appeal],
  [the Oyomesi],
  [the age grades]
)

#mcq(33, [A district head in the emirate system was responsible to],
  [the village assembly],
  [the British Resident],
  [the emir],
  [the caliph directly]
)

#mcq(34, [The Igbo system is called “stateless” because],
  [it had no laws],
  [it had no centralised government with a single sovereign ruler],
  [it had no population],
  [it had no territory]
)

#mcq(35, [The main source of slaves in the pre-colonial Nigerian states was],
  [the age-grade system],
  [the Ozo society],
  [voluntary emigration],
  [warfare and raids]
)

#mcq(36, [The council of elders in Igboland performed all of the following functions except],
  [advising on matters of custom],
  [settling disputes],
  [commanding the army in a centralised hierarchy],
  [regulating relations between villages]
)

#mcq(37, [Which of the following best explains why the emirate system survived colonial rule more intact than the Igbo system?],
  [It was Christian],
  [It had no courts to interfere],
  [It already had a hierarchy of rulers through whom the colonial power could govern],
  [It had a written constitution the British admired]
)

#mcq(38, [The pre-colonial systems of Nigeria are important to the study of federalism because],
  [they created the thirty-six states],
  [they abolished the emirates],
  [they show that power was never exercised without some check],
  [they wrote the 1999 Constitution]
)

#mcq(39, [A village head in the emirate system was usually],
  [chosen by the emir from the village's ruling family],
  [elected by the village assembly],
  [chosen by the Alkali],
  [appointed by the caliph]
)

#mcq(40, [Which statement about the Igbo village republic is FALSE?],
  [It had age-grade associations],
  [It settled disputes through elders and oracles],
  [It had a single hereditary ruler with a council of chiefs],
  [It had titled societies]
)

