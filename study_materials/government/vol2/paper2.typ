== Section A — Public administration and the civil service (Questions 1–10)

#mcq(1, [Public administration differs from private administration mainly in its],
  [need for records],
  [use of office equipment],
  [use of salaried staff],
  [accountability to the public and its political direction]
)

#mcq(2, [The administrative head of a Nigerian ministry is the],
  [director of finance],
  [permanent secretary],
  [head of the civil service],
  [minister]
)

#mcq(3, [The civil service principle that the minister, not the official, defends policy in public is called],
  [impartiality],
  [permanence],
  [seniority],
  [anonymity]
)

#mcq(4, [Recruitment into the federal civil service is the responsibility of the],
  [Federal Civil Service Commission],
  [National Assembly],
  [Federal Executive Council],
  [Supreme Court]
)

#mcq(5, [The 1974 Udoji Awards are associated with],
  [a review of public service pay and structure],
  [the introduction of BIVAS],
  [the creation of states],
  [the abolition of local government]
)

#mcq(6, [The 1988 civil service reform is criticised because it],
  [ended the anonymity of ministers],
  [politicised the top of the service],
  [reduced the number of ministries],
  [abolished the civil service commission]
)

#mcq(7, [The Treasury Single Account requires ministries and agencies to],
  [abolish their budgets],
  [keep their money in commercial banks],
  [borrow from foreign banks],
  [operate a single account at the Central Bank]
)

#mcq(8, [The main purpose of the civil service reform reports since 1974 has been to],
  [make the service smaller, cheaper and more efficient],
  [create more public corporations],
  [increase the number of ministries],
  [abolish the federal character principle]
)

#mcq(9, [The Auditor-General reports on the public accounts to the],
  [Supreme Court],
  [President alone],
  [National Assembly],
  [Central Bank]
)

#mcq(10, [A civil servant who takes a gift to award a contract has broken the canon of],
  [seniority],
  [permanence],
  [anonymity],
  [integrity]
)

== Section B — Public enterprise and local government (Questions 11–18)

#mcq(11, [A public corporation differs from a ministry in that it],
  [is funded only by taxation],
  [has separate legal personality and its own board and accounts],
  [has no employees],
  [is subject to no law]
)

#mcq(12, [The Bureau of Public Enterprises is responsible for],
  [conducting elections],
  [implementing the privatisation programme],
  [auditing public accounts],
  [collecting taxes]
)

#mcq(13, [Commercialisation of a public enterprise means that it],
  [is sold to private investors],
  [is closed down],
  [must cover its costs while remaining publicly owned],
  [is transferred to a local government]
)

#mcq(14, [Under the 1999 Constitution, local government is responsible for],
  [Issuing international passports],
  [provision and maintenance of local markets],
  [Defence of the federation],
  [Coining the national currency]
)

#mcq(15, [The 1976 local government reform is important because it],
  [created the regions],
  [established a uniform system of local government throughout the country],
  [abolished local government],
  [introduced the 1999 Constitution]
)

#mcq(16, [A caretaker committee in a local government is appointed by the],
  [Independent National Electoral Commission],
  [local government council],
  [state governor],
  [President]
)

#mcq(17, [The financial dependence of local government is shown by the fact that],
  [most of its revenue comes from allocations it does not control],
  [it refuses federal grants],
  [it has no budget],
  [it collects too much tax]
)

#mcq(18, [Which of the following is a source of internally generated revenue for a local government?],
  [Import duty],
  [Company income tax],
  [Market tolls and rates],
  [Oil royalties]
)

== Section C — Foreign policy and the international bodies (Questions 19–30)

#mcq(19, [The national interest in foreign policy refers to],
  [the interest of the ruling party],
  [the interest of the foreign ministry's staff],
  [the security, prosperity and prestige of the state],
  [the interest of foreign investors]
)

#mcq(20, [Which of the following is a determinant of Nigeria's foreign policy?],
  [The colour of its flag],
  [The size of its civil service],
  [Its colonial history and membership of the Commonwealth],
  [The number of its political parties]
)

#mcq(21, [The second circle in the concentric-circles model is],
  [the United Nations],
  [the national interest],
  [Africa as a whole],
  [West Africa]
)

#mcq(22, [ECOWAS's supreme policy-making organ is the],
  [Authority of Heads of State and Government],
  [ECOWAS Parliament],
  [Community Court of Justice],
  [Council of Ministers]
)

#mcq(23, [The OAU was replaced by the African Union because],
  [the UN abolished the OAU],
  [the OAU had never met],
  [the OAU was seen as unable to respond to conflicts and economic problems],
  [Nigeria withdrew from the OAU]
)

#mcq(24, [Nigeria's contribution to UN peacekeeping began in],
  [the Congo in 1960],
  [Sierra Leone in 1997],
  [Liberia in 1990],
  [Darfur in 2003]
)

#mcq(25, [Which of the following is a military instrument of Nigeria's foreign policy?],
  [The ECOMOG deployment in Liberia],
  [The OPEC quota],
  [The Technical Aid Corps],
  [The embassy in London]
)

#mcq(26, [Nigeria's membership of the Commonwealth was suspended in 1995 because of],
  [the 1993 election],
  [the civil war],
  [the creation of the FCT],
  [the execution of Ken Saro-Wiwa and eight others]
)

#mcq(27, [OPEC's main instrument is],
  [the issue of a common currency],
  [the setting of world interest rates],
  [the setting of production quotas among member states],
  [the command of peacekeeping forces]
)

#mcq(28, [The principle of non-alignment meant that Nigeria],
  [left the United Nations],
  [joined the Warsaw Pact],
  [banned all Western trade],
  [refused to join either Cold War bloc]
)

#mcq(29, [A Nigerian embassy in a foreign country is best described as],
  [an economic sanction],
  [a cultural festival],
  [a military mission],
  [a diplomatic instrument of foreign policy]
)

#mcq(30, [Which of the following is the best example of economic diplomacy?],
  [Negotiating oil production quotas within OPEC],
  [Deploying troops to a neighbouring state],
  [Sending an ambassador abroad],
  [Holding a cultural festival]
)

== Section D — Elections and electoral administration (Questions 31–40)

#mcq(31, [Nigeria's foreign policy is constrained by],
  [its large population],
  [dependence on oil exports and a limited industrial base],
  [its membership of ECOWAS],
  [its seat in the AU]
)

#mcq(32, [Nigeria operates which electoral system for the National Assembly?],
  [The single transferable vote],
  [A mixed member system],
  [Proportional representation],
  [First past the post]
)

#mcq(33, [The presidential election requires a candidate to win],
  [a majority of the popular vote only],
  [the highest number of votes and 25 per cent in two-thirds of the states and the FCT],
  [a majority in the Senate only],
  [the votes of the state houses of assembly]
)

#mcq(34, [INEC's independence is supported by],
  [its power to make the constitution],
  [its control of the police],
  [security of tenure and a direct charge on the Consolidated Revenue Fund],
  [the appointment of its chairman by the ruling party]
)

#mcq(35, [Local government elections in Nigeria are conducted by],
  [the police],
  [state independent electoral commissions],
  [INEC],
  [the state house of assembly]
)

#mcq(36, [BIVAS was introduced to],
  [transmit the result to the tribunal],
  [print the ballot papers],
  [count the votes automatically],
  [verify a voter by fingerprint and facial recognition]
)

#mcq(37, [Electronic transmission of results under the 2022 Act is permitted where],
  [the network coverage has been certified by the regulator],
  [the polling unit is in a city],
  [the opposition agrees],
  [the tribunal orders it]
)

#mcq(38, [A petition against a governorship election is filed at the],
  [Court of Appeal],
  [Federal High Court],
  [Supreme Court],
  [Governorship Election Petitions Tribunal]
)

#mcq(39, [The 21-day filing window for an election petition is intended to],
  [allow the tribunal to draft the result],
  [postpone the election],
  [ensure that a petition is heard within the life of the mandate],
  [give the winner time to celebrate]
)

#mcq(40, [An election is free when],
  [the voter can choose without fear or payment],
  [the result is announced early],
  [the count is transparent],
  [the register is accurate]
)

