  [1985 to 1993]
)

#mcq(12, [Ibrahim Babangida became head of state in],
  [1983],
  [1998],
  [1993],
  [1985]
)

#mcq(13, [The June 12, 1993 presidential election was annulled by],
  [Sani Abacha],
  [Ibrahim Babangida],
  [Abdulsalami Abubakar],
  [Ernest Shonekan]
)

#mcq(14, [The interim government of 1993 was headed by],
  [Ernest Shonekan],
  [Sani Abacha],
  [Moshood Abiola],
  [Ibrahim Babangida]
)

#mcq(15, [Sani Abacha became head of state in],
  [1993],
  [1999],
  [1985],
  [1998]
)

#mcq(16, [Civilian rule returned to Nigeria in 1999 under],
  [Ernest Shonekan],
  [Olusegun Obasanjo],
  [Abdulsalami Abubakar],
  [Shehu Shagari]
)

#mcq(17, [An ouster clause in a military decree],
  [grants amnesty to soldiers],
  [removes the jurisdiction of the courts over the decree],
  [creates a new state],
  [transfers power to civilians]
)

#mcq(18, [A law made by a state military administrator is called],
  [a decree],
  [an act],
  [a by-law],
  [an edict]
)

#mcq(19, [Special military tribunals were used to],
  [collect taxes],
  [conduct elections],
  [try civilians outside the ordinary courts],
  [appoint judges]
)

#mcq(20, [Which of the following is a reason for military intervention in Nigerian politics?],
  [Electoral malpractice and corruption],
  [A powerful parliament],
  [Strong and independent civilian institutions],
  [A loyal judiciary]
)

#mcq(21, [Military rule in Nigeria is often said to have centralised the country because],
  [the states were given more power],
  [local government was abolished],
  [the army withdrew from politics],
