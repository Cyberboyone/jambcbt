#mcq(33, [The War Against Indiscipline was launched by],
  [Ibrahim Babangida],
  [Olusegun Obasanjo],
  [Muhammadu Buhari],
  [Sani Abacha]
)

#mcq(34, [A major criticism of military government is that it],
  [holds too many elections],
  [cannot be removed by the ballot],
  [has no army],
  [makes too many laws]
)

#mcq(35, [Which of the following bodies was used by the military to try civilians?],
