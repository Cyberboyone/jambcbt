  [Murtala Muhammed],
  [Olusegun Obasanjo],
  [Yakubu Gowon]
)

#mcq(9, [The Second Republic began in],
  [1979],
  [1993],
  [1999],
  [1983]
)

#mcq(10, [The government of Shehu Shagari was overthrown in],
  [1983],
  [1993],
  [1979],
  [1985]
)

#mcq(11, [The military government of Muhammadu Buhari lasted from],
