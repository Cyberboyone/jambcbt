== 2.8 Chapter 2 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A constitution is best described as],
  [the record of a country's court judgments],
  [the programme of the ruling party],
  [the body of fundamental rules by which a state is governed],
  [an Act of the National Assembly]
)

#mcq(2, [Which of the following is a function of a constitution?],
  [To create the organs of government],
  [To conduct elections],
  [To collect taxes],
  [To appoint ambassadors]
)

#mcq(3, [A constitution that is contained in one document is said to be],
  [flexible],
  [written],
  [unwritten],
  [rigid]
)

#mcq(4, [The constitution of the United Kingdom is an example of],
  [an unwritten and rigid constitution],
  [a written and rigid constitution],
  [an unwritten and flexible constitution],
  [a written and flexible constitution]
)

#mcq(5, [A constitution is rigid when it],
  [is enforced by the courts],
  [can be amended only by a special procedure],
  [cannot be amended at all],
  [is written down]
)

#mcq(6, [The main disadvantage of a flexible constitution is that],
  [it cannot be written down],
  [it cannot be changed],
  [it requires a referendum for every change],
  [rights may be altered by a simple majority]
)

#mcq(7, [The constitution that first introduced the elective principle into Nigeria was the],
  [Macpherson Constitution of 1951],
  [Lyttleton Constitution of 1954],
  [Clifford Constitution of 1922],
  [Richards Constitution of 1946]
)

#mcq(8, [Under the Clifford Constitution, elected members represented],
  [all the provinces of Nigeria],
  [the whole of West Africa],
  [the northern emirates],
  [Lagos and Calabar]
)

#mcq(9, [The Richards Constitution of 1946 is remembered chiefly for],
  [introducing the elective principle],
  [creating the regions],
  [creating the Federal Capital Territory],
  [creating the office of Prime Minister]
)

#mcq(10, [Nigerians first held ministerial office with responsibility for departments under the],
  [Macpherson Constitution],
  [Republican Constitution],
  [Richards Constitution],
  [Clifford Constitution]
)

#mcq(11, [Nigeria became a true federation with a federal Prime Minister and regional premiers under the],
  [Independence Constitution of 1960],
  [Lyttleton Constitution of 1954],
  [Macpherson Constitution of 1951],
  [Richards Constitution of 1946]
)

#mcq(12, [The constitution that made Lagos a Federal Territory was the],
  [Richards Constitution],
  [Macpherson Constitution],
  [Lyttleton Constitution],
  [1979 Constitution]
)

#mcq(13, [At independence in 1960, Nigeria adopted],
  [a confederal system],
  [the Westminster parliamentary system],
  [a presidential system],
  [a one-party system]
)

#mcq(14, [The main change made by the 1963 Republican Constitution was the],
  [replacement of the Queen as head of state by a Nigerian President],
  [creation of the Federal Capital Territory],
  [introduction of the elective principle],
  [creation of the office of an executive President]
)

#mcq(15, [The office of an executive President elected by the people was created by the],
  [1989 Constitution],
  [1963 Constitution],
  [1979 Constitution],
  [1999 Constitution]
)

#mcq(16, [The Federal Capital Territory of Abuja was created in],
  [1967],
  [1979],
  [1991],
  [1976]
)

#mcq(17, [The present Constitution of the Federal Republic of Nigeria came into force in],
  [1999],
  [1963],
  [1979],
  [1989]
)

#mcq(18, [Nigeria currently has],
  [12 states],
  [36 states and the Federal Capital Territory],
  [30 states],
  [19 states]
)

#mcq(19, [The number of local government areas in Nigeria is],
  [449],
  [589],
  [774],
  [301]
)

#mcq(20, [The Senate of Nigeria has 109 members because there are],
  [one senator for each of the 109 senatorial districts],
  [two senators for each of 36 states plus one for the FCT],
  [three senators for each of 36 states plus one for the FCT],
  [three senators for each of 36 states plus one for each territory]
)

#mcq(21, [The procedure for amending the Nigerian Constitution is set out in],
  [section 14],
  [section 1],
  [section 4],
  [section 9]
)

#mcq(22, [The supremacy of the Nigerian Constitution is declared in],
  [section 1],
  [section 9],
  [section 2],
  [section 6]
)

#mcq(23, [Which of the following is a matter on the exclusive legislative list?],
  [Agriculture],
  [Education],
  [Defence],
  [Chieftaincy]
)

#mcq(24, [Which of the following is a matter on the concurrent legislative list?],
  [Education],
  [Foreign affairs],
  [Currency and coinage],
  [Markets and motor parks]
)

#mcq(25, [Which of the following is a residual matter?],
  [Chieftaincy],
  [Citizenship],
  [Customs and excise],
  [Police]
)

#mcq(26, [Where a state law conflicts with a federal law on a matter in the concurrent list],
  [the federal law prevails],
  [both laws remain in force],
  [the state law prevails],
  [the Constitution is amended]
)

#mcq(27, [Federalism is best defined as a system in which],
  [the central government may abolish the units],
  [all power is held by the central government],
  [the units may secede at will],
  [governmental power is divided between a central government and constituent units, each deriving its authority from the constitution]
)

#mcq(28, [Which of the following is a reason for adopting federalism in Nigeria?],
  [To concentrate power at the centre],
  [To abolish the regions],
  [To accommodate the country's ethnic and cultural diversity],
  [To simplify the court system]
)

#mcq(29, [The body responsible for revenue allocation in Nigeria is the],
  [Federal Inland Revenue Service],
  [Central Bank of Nigeria],
  [Federal Character Commission],
  [Revenue Mobilisation, Allocation and Fiscal Commission]
)

#mcq(30, [The 13 per cent derivation principle in Nigerian revenue allocation applies to],
  [value added tax],
  [mineral revenue, principally oil],
  [company income tax],
  [customs duties]
)

#mcq(31, [The first twelve states in Nigeria were created in],
  [1954],
  [1967],
  [1976],
  [1987]
)

#mcq(32, [The principle of federal character is intended to],
  [share revenue equally among states],
  [create new local government areas],
  [ensure that all states are equal in population],
  [reflect the diversity of the federation in appointments]
)

#mcq(33, [Under military rule in Nigeria, decrees were],
  [amendments to the Constitution],
  [superior to the Constitution and often immune from review],
  [passed by the National Assembly],
  [subject to judicial review]
)

#mcq(34, [Which of the following is a feature of the 1999 Constitution?],
  [A bicameral National Assembly and an executive President],
  [A unicameral legislature],
  [A one-party system],
  [A ceremonial President elected by the legislature]
)

#mcq(35, [The fundamental human rights in Nigeria are contained in],
  [Chapter II],
  [Chapter I],
  [Chapter IV],
  [Chapter VIII]
)

#mcq(36, [Indirect rule in Nigeria is associated with],
  [Obafemi Awolowo],
  [Herbert Macaulay],
  [Nnamdi Azikiwe],
  [Lord Lugard]
)

#mcq(37, [The Aba Women's Riots of 1929 were a protest against],
  [the imposition of direct taxation and warrant chiefs],
  [the deportation of a chief],
  [the Clifford Constitution],
  [the creation of the regions]
)

#mcq(38, [Which of the following is NOT a reason for the rigidity of the Nigerian Constitution?],
  [It allows the President to amend it by decree],
  [It prevents hasty amendment],
  [It protects fundamental rights],
  [It safeguards the federal structure]
)

#mcq(39, [A constitution that is written but amendable by ordinary legislation is],
  [written and flexible],
  [unwritten and flexible],
  [unwritten and rigid],
  [written and rigid]
)

#mcq(40, [The legislative list on which only the National Assembly may legislate is the],
  [concurrent list],
  [residual list],
  [exclusive list],
  [federal character list]
)

