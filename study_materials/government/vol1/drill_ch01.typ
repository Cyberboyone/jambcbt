== 1.8 Chapter 1 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Government is best defined as the],
  [body of citizens who elect their rulers],
  [territory over which a state exercises control],
  [institution through which a state is ruled],
  [group of people who rule a state at a particular time]
)

#mcq(2, [Which of the following is an element of the state?],
  [Army],
  [Sovereignty],
  [Flag],
  [Constitution]
)

#mcq(3, [The four elements of the state are population, territory, government and],
  [citizenship],
  [sovereignty],
  [constitution],
  [recognition]
)

#mcq(4, [A nation differs from a state in that a nation],
  [is a people sharing a common history and culture],
  [must be recognised by the United Nations],
  [has a defined territory],
  [exercises sovereignty over its affairs]
)

#mcq(5, [Nigeria is best described as],
  [a confederation of nations],
  [a state of many nations],
  [a nation-state],
  [a single nation with one culture]
)

#mcq(6, [Society differs from the state because society],
  [exercises sovereignty],
  [is created by the constitution],
  [is older and wider than the state],
  [has a defined territory]
)

#mcq(7, [A change of government in a country does not necessarily mean that],
  [the constitution has changed],
  [the president has changed],
  [the state has changed],
  [the ruling party has changed]
)

#mcq(8, [Sovereignty is best defined as],
  [the power to make laws],
  [the right to vote in elections],
  [the power to tax citizens],
  [supreme authority within a territory and independence from external control]
)

#mcq(9, [In a federation, sovereignty is],
  [held by the constituent states],
  [exercised only by the federal government],
  [indivisible, although governmental powers are divided],
  [shared between the federal and state governments]
)

#mcq(10, [The doctrine that all political authority comes from the people is called],
  [legal sovereignty],
  [popular sovereignty],
  [external sovereignty],
  [parliamentary sovereignty]
)

#mcq(11, [A government that is lawful but whose right to rule is widely rejected lacks],
  [a constitution],
  [territory],
  [legitimacy],
  [sovereignty]
)

#mcq(12, [The mandate of a government is],
  [the budget it presents to parliament],
  [its legal right to exist],
  [the authority it claims from its election victory],
  [the oath taken by its officials]
)

#mcq(13, [Which of the following is a feature of democracy?],
  [Periodic free and fair elections],
  [Rule by the military],
  [Rule by a hereditary monarch],
  [Government by a single party]
)

#mcq(14, [A monarchy in which the monarch reigns but does not rule is called],
  [an absolute monarchy],
  [a constitutional monarchy],
  [a republic],
  [an oligarchy]
)

#mcq(15, [Government by a small group of people is called],
  [oligarchy],
  [theocracy],
  [monarchy],
  [democracy]
)

#mcq(16, [Which of the following best describes a dictatorship?],
  [Government by judges],
  [Government by an elected assembly],
  [Rule by a hereditary ruler under a constitution],
  [Rule by one person or party without effective constitutional limits]
)

#mcq(17, [The main difference between a republic and a monarchy is that in a republic],
  [there are no elections],
  [the people have no rights],
  [the head of state is not a hereditary monarch],
  [the rule of law does not apply]
)

#mcq(18, [A system in which political authority is exercised by religious leaders and law is derived from a sacred text is called],
  [an aristocracy],
  [a bureaucracy],
  [a plutocracy],
  [a theocracy]
)

#mcq(19, [Capitalism is an economic system in which],
  [all property is held in common],
  [the means of production are privately owned and profit is the motive],
  [land is the only source of wealth],
  [the state owns the major means of production]
)

#mcq(20, [Socialism is best distinguished from communism by the fact that socialism],
  [is a system of hereditary rule],
  [allows some private ownership and does not require the abolition of class],
  [rejects all forms of planning],
  [abolishes private property entirely]
)

#mcq(21, [In which system is land the principal source of wealth, status and power?],
  [Capitalism],
  [Socialism],
  [Welfarism],
  [Feudalism]
)

#mcq(22, [Fascism is characterised by],
  [the supremacy of the state over the individual],
  [the supremacy of the individual over the state],
  [rule by a religious authority],
  [the abolition of the state]
)

#mcq(23, [A system that keeps private ownership of the means of production but provides health care, education and a minimum income through the state is called],
  [welfarism],
  [communism],
  [mercantilism],
  [socialism]
)

#mcq(24, [The Nigerian economy is best described as],
  [feudal],
  [mixed, with private ownership and state participation and regulation],
  [purely capitalist],
  [purely socialist]
)

#mcq(25, [The rule of law, as stated by Dicey, includes all of the following except],
  [the supremacy of the executive over the courts],
  [supremacy of the law],
  [equality before the law],
  [the constitution as the result of the ordinary law]
)

#mcq(26, [The principle that a person may not be punished except for a breach of the law established in the ordinary courts is part of the],
  [doctrine of sovereignty],
  [rule of law],
  [federal principle],
  [separation of powers]
)

#mcq(27, [The doctrine of separation of powers is usually associated with],
  [Hobbes],
  [Rousseau],
  [Dicey],
  [Montesquieu]
)

#mcq(28, [Separation of powers is intended chiefly to],
  [reduce the cost of government],
  [speed up legislation],
  [increase the power of the executive],
  [prevent the concentration of power in one organ]
)

#mcq(29, [A constitution is best defined as],
  [the manifesto of the ruling party],
  [a treaty between states],
  [the body of fundamental rules by which a state is governed],
  [a law passed by the legislature]
)

#mcq(30, [Constitutionalism means],
  [the existence of a written constitution],
  [the practice of governing within the rules of the constitution],
  [the amendment of the constitution],
  [the suspension of the constitution]
)

#mcq(31, [A constitution contained in a single document is said to be],
  [customary],
  [flexible],
  [written],
  [unwritten]
)

#mcq(32, [The constitution of the United Kingdom is usually described as],
  [written and flexible],
  [written and rigid],
  [unwritten and flexible],
  [unwritten and rigid]
)

#mcq(33, [A constitution that can be amended only by a special majority or a referendum is],
  [rigid],
  [flexible],
  [customary],
  [unwritten]
)

#mcq(34, [The main advantage of a rigid constitution is that it],
  [protects rights against a temporary majority],
  [can be changed quickly in a crisis],
  [is easier to understand],
  [does not need a legislature]
)

#mcq(35, [Government is studied mainly in order to understand],
  [the laws of other countries],
  [the economy of a country],
  [power, order, the citizen and political change],
  [the history of political parties]
)

#mcq(36, [A state in which the borders of the state and the boundaries of a single nation roughly coincide is called],
  [a confederation],
  [a nation-state],
  [a federation],
  [an empire]
)

#mcq(37, [External sovereignty means],
  [independence from the control of other states],
  [the power to make treaties],
  [the right to send ambassadors],
  [the power to tax imports]
)

#mcq(38, [Which of the following would most clearly show that a government has lost legitimacy?],
  [It reshuffles the cabinet],
  [It loses a vote on a minor bill],
  [A general strike and mass protests reject its authority],
  [It loses a court case]
)

#mcq(39, [A government elected with 30 per cent of the vote but 60 per cent of the seats may claim],
  [a mandate],
  [judicial review],
  [sovereignty],
  [federal character]
)

#mcq(40, [Which of the following is NOT a form of government?],
  [Oligarchy],
  [Monarchy],
  [Democracy],
  [Sovereignty]
)

