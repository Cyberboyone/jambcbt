== Section A — The state, forms and ideologies (Questions 1–15)

#mcq(1, [Government is the institution through which a state is],
  [ruled],
  [divided],
  [represented abroad],
  [taxed only]
)

#mcq(2, [A state must possess all of the following except],
  [a territory],
  [a written constitution],
  [a government],
  [a population]
)

#mcq(3, [The four elements of the state are population, territory, government and],
  [sovereignty],
  [recognition],
  [constitution],
  [citizenship]
)

#mcq(4, [A people sharing a common history and culture, whether or not they have a state, is called],
  [a state],
  [a nation],
  [a society],
  [a government]
)

#mcq(5, [Which of the following is a form of government?],
  [Sovereignty],
  [Federalism],
  [Legitimacy],
  [Oligarchy]
)

#mcq(6, [A republic is distinguished from a monarchy by the fact that in a republic],
  [the people are sovereign],
  [power is decentralised],
  [the head of state is not a hereditary monarch],
  [there is a written constitution]
)

#mcq(7, [The ideology that advocates public ownership of the major means of production is],
  [capitalism],
  [socialism],
  [feudalism],
  [welfarism]
)

#mcq(8, [Which ideology places the nation and the state above the individual?],
  [Fascism],
  [Communism],
  [Welfarism],
  [Capitalism]
)

#mcq(9, [The principle that the government itself is bound by the law is called],
  [sovereignty],
  [federalism],
  [electoralism],
  [constitutionalism]
)

#mcq(10, [The rule of law includes all of the following except],
  [equality before the law],
  [punishment only for a breach of the law],
  [the ordinary courts as the forum for disputes],
  [the subordination of the courts to the executive]
)

#mcq(11, [Separation of powers was propounded by],
  [Aristotle],
  [Machiavelli],
  [Rousseau],
  [Montesquieu]
)

#mcq(12, [The power of the Senate to confirm a ministerial nominee is an example of],
  [checks and balances],
  [judicial review],
  [federalism],
  [separation of powers]
)

#mcq(13, [Sovereignty is best described as],
  [the power to make laws],
  [the control of the army],
  [the right to vote],
  [supreme authority within a territory and independence from outside control]
)

#mcq(14, [The statement that sovereignty belongs to the people is found in],
  [section 14 of the 1999 Constitution],
  [the Electoral Act],
  [section 1 of the 1999 Constitution],
  [section 42 of the 1999 Constitution]
)

#mcq(15, [A government that is accepted by the governed as having the right to rule has],
  [sovereignty],
  [federal character],
  [legitimacy],
  [a mandate]
)

