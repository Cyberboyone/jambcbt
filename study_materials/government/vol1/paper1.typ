== Section C — Rigid, federal, and the lists (Questions 23–29)

#mcq(23, [A constitution that cannot easily be amended is described as],
  [written],
  [rigid],
  [federal],
  [unwritten]
)

#mcq(24, [The procedure for amending the Nigerian Constitution is contained in],
  [section 1],
  [section 4],
  [section 9],
  [section 14]
)

#mcq(25, [Which of the following is an exclusive legislative matter?],
  [Health],
  [Education],
  [Currency and coinage],
  [Chieftaincy]
)

#mcq(26, [Which of the following is a residual matter?],
  [Defence],
  [Customs and excise],
  [Foreign affairs],
  [Markets and motor parks]
)

#mcq(27, [Where a state law conflicts with a federal law on the concurrent list, the doctrine applied is],
  [stare decisis],
  [ultra vires],
  [judicial review],
  [covering the field]
)

#mcq(28, [The body that recommends the revenue-sharing formula in Nigeria is the],
  [CBN],
  [FCC],
  [RMAFC],
  [FIRS]
)

#mcq(29, [The 1976 local government reform is remembered for],
  [creating the regions],
  [creating a uniform system of local government councils],
  [creating the FCT only],
  [abolishing local government]
)

== Section D — The organs and delegated legislation (Questions 30–40)

#mcq(30, [Legislative power in Nigeria is vested in the National Assembly by],
  [section 4],
  [section 9],
  [section 6],
  [section 5]
)

#mcq(31, [The Nigerian Senate consists of],
  [774 members],
  [469 members],
  [360 members],
  [109 members]
)

#mcq(32, [The chief function of the legislature is to],
  [command the army],
  [make law],
  [execute policy],
