  [the Supreme Court],
  [a simple majority of the Senate],
  [a referendum],
  [a two-thirds majority of each House]
)

#mcq(35, [In a parliamentary system the executive is],
  [drawn from the legislature and answerable to it],
  [appointed by the judiciary],
  [separately elected],
  [chosen by the army]
)

#mcq(36, [Judicial review is the power of the courts to],
  [hear appeals],
  [declare an act unconstitutional],
  [advise the government],
  [appoint judges]
)

#mcq(37, [The highest court in Nigeria is the],
  [Federal High Court],
  [Supreme Court],
  [Sharia Court of Appeal],
  [Court of Appeal]
)

#mcq(38, [Judges in Nigeria are protected from arbitrary removal by],
  [security of tenure],
  [the Police Service Commission],
  [the Senate's daily oversight],
  [the President's discretion]
