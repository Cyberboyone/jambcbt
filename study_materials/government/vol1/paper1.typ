)

#mcq(20, [An executive President elected by the people was first provided for by the],
  [1999 Constitution],
  [1963 Constitution],
  [1979 Constitution],
  [1989 Constitution]
)

#mcq(21, [The present Constitution of Nigeria came into force in],
