== 5.8 Chapter 5 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Citizenship is best defined as],
  [legal membership of a state],
  [residence in a country],
  [the payment of taxes],
  [the right to vote]
)

#mcq(2, [Which of the following is NOT a way of acquiring Nigerian citizenship?],
  [By naturalisation],
  [By descent],
  [By residence for five years],
  [By birth]
)

#mcq(3, [A person born outside Nigeria either of whose parents is a Nigerian citizen acquires citizenship by],
  [registration],
  [naturalisation],
  [descent],
  [birth]
)

#mcq(4, [A foreign woman married to a Nigerian citizen may acquire Nigerian citizenship by],
  [birth],
  [descent],
  [naturalisation],
  [registration]
)

#mcq(5, [The period of residence required for citizenship by naturalisation in Nigeria is],
  [fifteen years],
  [twenty years],
  [ten years],
  [five years]
)

#mcq(6, [Which of the following is a condition for citizenship by naturalisation?],
  [Good character and acceptance by the community],
  [Service in the armed forces],
  [Ownership of landed property],
  [Membership of a political party]
)

#mcq(7, [Nigerian law permits],
  [no dual citizenship],
  [dual citizenship only for persons born abroad],
  [dual citizenship only for women],
  [dual citizenship]
)

#mcq(8, [Which of the following is a duty of a citizen?],
  [To pay taxes lawfully imposed],
  [To serve as a minister],
  [To vote in every election],
  [To join a political party]
)

#mcq(9, [Fundamental human rights in Nigeria are contained in],
  [the Electoral Act],
  [Chapter IV of the Constitution],
  [Chapter II of the Constitution],
  [Chapter I of the Constitution]
)

#mcq(10, [Which of the following is a fundamental human right under the Nigerian Constitution?],
  [Right to fair hearing],
  [Right to free education],
  [Right to employment],
  [Right to shelter]
)

#mcq(11, [A person whose fundamental right has been breached may apply for redress to],
  [a High Court],
  [the police],
  [the President],
  [the National Assembly]
)

#mcq(12, [The right to life in Nigeria may lawfully be taken],
  [by the President's order],
  [in execution of a sentence of a court for a capital offence],
  [by a private citizen in self-defence only],
  [at any time by the police]
)

#mcq(13, [The right to freedom of expression in Nigeria does not include the right to],
  [publish a newspaper],
  [receive and impart information],
  [incite violence or publish false information likely to cause a breach of the peace],
  [hold opinions]
)

#mcq(14, [The right to freedom of movement in Nigeria may be restricted],
  [in the interest of defence, public safety or public health],
  [never, under any circumstances],
  [by a private employer],
  [only by the Supreme Court]
)

#mcq(15, [The National Human Rights Commission is best described as],
  [an investigative and reporting body],
  [a department of the police],
  [a committee of the National Assembly],
  [a court of law]
)

#mcq(16, [The Public Complaints Commission is otherwise known as the],
  [chief whip],
  [auditor-general],
  [ombudsman],
  [attorney-general]
)

#mcq(17, [Public administration is best defined as],
  [the adjudication of disputes],
  [the making of public policy],
  [the conduct of elections],
  [the machinery by which government policy is carried out]
)

#mcq(18, [Which of the following is a feature of the civil service?],
  [Election by the people],
  [Profit-making],
  [Partisanship],
  [Permanence]
)

#mcq(19, [The civil service is described as impartial because its officials],
  [do not vote],
  [serve whichever government is in power],
  [are appointed by the courts],
  [cannot be dismissed]
)

#mcq(20, [The body that appoints and disciplines federal civil servants in Nigeria is the],
  [National Assembly],
  [Federal Civil Service Commission],
  [Judicial Service Commission],
  [Federal Character Commission]
)

#mcq(21, [Which of the following is a control on the civil service?],
  [The Chief Justice's approval of promotions],
  [The army's approval of appointments],
  [A referendum],
  [The Auditor-General's annual audit]
)

#mcq(22, [The Code of Conduct Bureau requires public officers to],
  [join a political party],
  [declare their assets],
  [serve for life],
  [live in the capital]
)

#mcq(23, [A public corporation is best described as],
  [a local government council],
  [a private company owned by shareholders],
  [a statutory body created to provide a service, with its own legal personality],
  [a department of a ministry]
)

#mcq(24, [Which of the following is a reason for establishing a public corporation?],
  [To provide essential services where private capital will not go],
  [To reduce the size of government],
  [To avoid accountability],
  [To maximise profit for shareholders]
)

#mcq(25, [A major problem of public corporations in Nigeria has been],
  [the absence of any board],
  [political interference and losses],
  [shortage of staff],
  [excessive competition]
)

#mcq(26, [Local government in Nigeria is guaranteed by],
  [a decree of 1999],
  [the Electoral Act],
  [section 1 of the Constitution],
  [section 7 of the Constitution]
)

#mcq(27, [The number of local government areas in Nigeria is],
  [801],
  [589],
  [774],
  [449]
)

#mcq(28, [Which of the following is a function of a local government council?],
  [Issuing currency],
  [Conducting federal elections],
  [Defence of the country],
  [Collection of market tolls and rates]
)

#mcq(29, [The main source of local government revenue in Nigeria is],
  [loans from foreign banks],
  [statutory allocation from the Federation Account],
  [grants from political parties],
  [proceeds from the sale of crude oil]
)

#mcq(30, [The 1976 local government reform is remembered for],
  [creating the regions],
  [establishing a uniform system of local government councils],
  [creating the Federal Capital Territory],
  [abolishing local government]
)

#mcq(31, [A local government chairman in Nigeria is],
  [chosen by the councillors alone],
  [appointed by the state governor],
  [appointed by the President],
  [elected by the people of the local government area]
)

#mcq(32, [Which of the following is a Chapter II objective rather than a Chapter IV right?],
  [Right to freedom of movement],
  [Right to freedom of religion],
  [Right to fair hearing],
  [Right to adequate shelter]
)

#mcq(33, [The right to freedom from discrimination in Nigeria protects against differential treatment on grounds of],
  [wealth only],
  [height and weight],
  [age only],
  [ethnic group, sex, religion and political opinion]
)

#mcq(34, [Citizenship by honorary award is conferred by],
  [the state governor],
  [the Chief Justice],
  [the President],
  [the Senate]
)

#mcq(35, [A citizen who acquires the citizenship of another country],
  [does not lose Nigerian citizenship],
  [must renounce it within a year],
  [loses the right to vote only],
  [automatically loses Nigerian citizenship]
)

#mcq(36, [Which of the following best explains why the civil service is permanent?],
  [It is funded by foreign donors],
  [It carries institutional memory and continuity across changes of government],
  [Its officials are elected],
  [Its officials cannot retire]
)

#mcq(37, [The doctrine of ministerial responsibility means that],
  [the minister answers to the legislature for the conduct of the ministry],
  [the minister personally performs every duty of the ministry],
  [the minister cannot be dismissed],
  [the civil servants are responsible to the courts alone]
)

#mcq(38, [Which of the following is NOT a source of local government revenue?],
  [Statutory allocation],
  [Market tolls],
  [Company income tax],
  [Tenement rates]
)

#mcq(39, [Which of the following is a merit of a public corporation over a government department?],
  [It is run by civil servants],
  [It is not accountable to anyone],
  [It has a separate legal personality and can sue and be sued],
  [It cannot make a loss]
)

#mcq(40, [The fundamental objectives and directive principles in Chapter II are],
  [superior to Chapter IV],
  [amendments to the Constitution],
  [enforceable in the courts],
  [a guide to state policy that the courts will not enforce directly]
)

