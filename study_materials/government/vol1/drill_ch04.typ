== 4.7 Chapter 4 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A political party is best defined as],
  [the body that conducts elections],
  [any group that seeks to influence government policy],
  [a group of people with the same religion],
  [an organised group that seeks to win power by contesting elections]
)

#mcq(2, [Which of the following is a function of a political party?],
  [Conducting the census],
  [Aggregating interests into a programme],
  [Issuing currency],
  [Settling election petitions]
)

#mcq(3, [The function of a party that involves selecting candidates and leaders is called],
  [political education],
  [interest aggregation],
  [interest articulation],
  [political recruitment]
)

#mcq(4, [A party that is small, elite-led and financed by a few wealthy supporters is called],
  [a coalition],
  [a cadre party],
  [a pressure group],
  [a mass party]
)

#mcq(5, [A mass party is distinguished from a cadre party by its],
  [large membership and branch organisation],
  [lack of a manifesto],
  [refusal to contest elections],
  [reliance on a single leader]
)

#mcq(6, [Which of the following is a merit of a two-party system?],
  [It prevents any party from winning a majority],
  [It offers the electorate a clear choice between alternative governments],
  [It requires coalitions after every election],
  [It gives every small group a seat]
)

#mcq(7, [A major disadvantage of a one-party system is that it],
  [gives small parties too much power],
  [produces too many coalitions],
  [makes government unstable],
  [provides no effective opposition or choice]
)

#mcq(8, [A party system in which several parties compete but one party wins every election is called],
  [a dominant-party system],
  [a two-party system],
  [a coalition system],
  [a one-party system]
)

#mcq(9, [Nigeria's Fourth Republic is best described as],
  [a two-party system by law],
  [a one-party system],
  [a no-party system],
  [a multi-party system with a dominant party]
)

#mcq(10, [The main difference between a political party and a pressure group is that a pressure group],
  [does not seek to form a government],
  [has no interest in politics],
  [must be registered by INEC],
  [cannot influence legislation]
)

#mcq(11, [The Nigeria Labour Congress is an example of],
  [a promotional pressure group],
  [a political party],
  [a sectional pressure group],
  [an electoral commission]
)

#mcq(12, [Which of the following is a method available to a pressure group?],
  [Nominating candidates for election],
  [Lobbying legislators and organising strikes],
  [Conducting the census],
  [Declaring a law unconstitutional]
)

#mcq(13, [An election is best defined as],
  [a vote in the legislature],
  [the registration of political parties],
  [a process by which the adult population chooses people to hold public office],
  [a debate between candidates]
)

#mcq(14, [The franchise is],
  [the right to contest an election],
  [the method of counting votes],
  [the right to vote],
  [the body that conducts elections]
)

#mcq(15, [In Nigeria, the right to vote is granted to every citizen who],
  [has paid tax for five years],
  [can read and write],
  [owns property],
  [is at least eighteen and registered]
)

#mcq(16, [Universal adult suffrage in Nigeria was introduced in],
  [1979],
  [1922],
  [1954],
  [1960]
)

#mcq(17, [A system in which the candidate with the highest number of votes in a constituency wins is called],
  [first past the post],
  [proportional representation],
  [the second ballot],
  [the single transferable vote]
)

#mcq(18, [The main advantage claimed for proportional representation is that it],
  [is simpler to administer than any other system],
  [gives parties seats in proportion to their votes],
  [always produces a single-party majority],
  [removes the need for constituencies]
)

#mcq(19, [Which electoral system is used for elections to Nigeria's National Assembly?],
  [The single transferable vote],
  [First past the post],
  [A mixed member system],
  [Proportional representation]
)

#mcq(20, [The body responsible for conducting federal elections in Nigeria is],
  [the Federal Character Commission],
  [the Supreme Court],
  [INEC],
  [the National Assembly]
)

#mcq(21, [The independence of INEC is protected mainly by],
  [its funding from the Consolidated Revenue Fund and the security of tenure of its members],
  [the President's control of its budget],
  [its subordination to the National Assembly],
  [the appointment of its chairman by the Chief Justice]
)

#mcq(22, [Which of the following is an example of electoral malpractice?],
  [Ballot-box snatching and stuffing],
  [A public count at the polling unit],
  [A secret ballot],
  [The use of an updated register]
)

#mcq(23, [Gerrymandering is],
  [the buying of votes],
  [the intimidation of voters],
  [the drawing of constituency boundaries to favour a party],
  [the stuffing of ballot boxes]
)

#mcq(24, [A free and fair election requires],
  [the army to announce the results],
  [an independent commission, a current register and a secret ballot],
  [a single party on the ballot],
  [the incumbent to control the media]
)

#mcq(25, [Public opinion is best defined as],
  [the editorial line of a newspaper],
  [the sum of the views held by the adult population on a public question],
  [the view of the government],
  [the result of the last election]
)

#mcq(26, [Which of the following is an agent of public opinion?],
  [The Supreme Court],
  [The central bank],
  [The census board],
  [The mass media]
)

#mcq(27, [The mass media perform all of the following functions except],
  [providing a platform for debate],
  [educating the electorate],
  [adjudicating election petitions],
  [informing the public]
)

#mcq(28, [A political party in opposition performs the function of],
  [criticising and checking the government],
  [appointing judges],
  [conducting elections],
  [forming the government]
)

#mcq(29, [One reason a multi-party system may produce unstable government is that],
  [coalitions may collapse when a partner withdraws],
  [the electorate cannot vote],
  [the constitution forbids majorities],
  [parties never disagree]
)

#mcq(30, [A party's manifesto is],
  [the list of its members],
  [the programme of policies it promises if elected],
  [the record of its finances],
  [its constitution]
)

#mcq(31, [Which of the following best explains why pressure groups are important in a democracy?],
  [They give organised expression to interests between elections],
  [They conduct elections],
  [They make laws],
  [They appoint ministers]
)

#mcq(32, [The single transferable vote is a form of],
  [a referendum],
  [first past the post],
  [the second ballot],
  [proportional representation]
)

#mcq(33, [The requirement that a presidential candidate win at least a quarter of the votes in two-thirds of the states is intended to],
  [favour small parties],
  [reduce the cost of elections],
  [ensure a national spread of support],
  [prevent the use of the secret ballot]
)

#mcq(34, [Which of the following is NOT a function of a political party?],
  [Conducting elections],
  [Educating the electorate],
  [Aggregating interests],
  [Recruiting political leaders]
)

#mcq(35, [An opinion poll is best described as],
  [a list of registered voters],
  [a sample survey used to infer the views of a population],
  [a count of the votes cast],
  [a meeting of party leaders]
)

#mcq(36, [A mandate is best defined as],
  [the power to dissolve parliament],
  [the oath taken by a public officer],
  [the legal right of a government to exist],
  [the authority a government claims from its election victory]
)

#mcq(37, [Which of the following would most weaken the claim that an election was free and fair?],
  [A turnout of 45 per cent],
  [Results announced at the polling unit],
  [Opposition agents excluded from the count],
  [The use of a biometric register]
)

#mcq(38, [A bye-law made by a local government council is made under],
  [a resolution of the Senate],
  [the authority of the army],
  [powers conferred by law on the council],
  [the Criminal Code]
)

#mcq(39, [Which of the following statements about pressure groups is correct?],
  [They may use strikes and demonstrations as well as lobbying],
  [They nominate candidates for public office],
  [They must contest elections to be recognised],
  [They are banned in a democracy]
)

#mcq(40, [An electoral system that combines single-member constituencies with a proportional top-up is called],
  [first past the post],
  [a mixed member system],
  [the second ballot],
  [the single transferable vote]
)

