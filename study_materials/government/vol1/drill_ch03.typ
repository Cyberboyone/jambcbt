== 3.8 Chapter 3 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [The three organs of government are the],
  [federal, state and local governments],
  [army, police and customs],
  [legislature, executive and judiciary],
  [senate, house and presidency]
)

#mcq(2, [Separation of powers means that],
  [the judiciary makes law],
  [the executive controls the courts],
  [the three organs are independent in their own sphere],
  [the legislature appoints judges]
)

#mcq(3, [Checks and balances are best described as],
  [the powers each organ has to restrain the others],
  [the federal division of powers],
  [the rules of parliamentary procedure],
  [the division of functions among three organs]
)

#mcq(4, [Legislative power in Nigeria is vested in the National Assembly by],
  [section 4],
  [section 9],
  [section 5],
  [section 6]
)

#mcq(5, [Executive power in Nigeria is vested in],
  [the Federal Executive Council],
  [the National Assembly],
  [the President],
  [the Supreme Court]
)

#mcq(6, [Judicial power in Nigeria is vested in],
  [the courts],
  [the President],
  [the National Assembly],
  [the Judicial Service Commission]
)

#mcq(7, [The legislature is chiefly responsible for],
  [making the law],
  [executing the law],
  [interpreting the law],
  [prosecuting offenders]
)

#mcq(8, [Which of the following is a function of the legislature?],
  [Issuing currency],
  [Approving the annual budget],
  [Deciding election petitions],
  [Commanding the armed forces]
)

#mcq(9, [The Nigerian National Assembly consists of],
  [a Senate of 100 and a House of 360],
  [a Senate of 36 and a House of 774],
  [a single chamber of 469 members],
  [a Senate of 109 and a House of Representatives of 360]
)

#mcq(10, [A bicameral legislature is one with],
  [three chambers],
  [no chamber],
  [two chambers],
  [one chamber]
)

#mcq(11, [Which of the following is an advantage of a bicameral legislature?],
  [It removes the need for committees],
  [It is cheaper than a single chamber],
  [It makes law-making faster],
  [It allows a second look at legislation]
)

#mcq(12, [The President's refusal to sign a bill is called],
  [a veto],
  [an amendment],
  [a filibuster],
  [a resolution]
)

#mcq(13, [The power of the National Assembly to remove the President for gross misconduct is called],
  [censure],
  [impeachment],
  [recall],
  [veto]
)

#mcq(14, [Which of the following is a function of the executive?],
  [Adjudicating election petitions],
  [Interpreting the constitution],
  [Executing laws and formulating policy],
  [Making laws]
)

#mcq(15, [In a parliamentary system, the executive is],
  [elected separately from the legislature],
  [appointed by the judiciary],
  [chosen by the army],
  [drawn from and answerable to the legislature]
)

#mcq(16, [In a presidential system of government],
  [the executive and legislature are separately elected],
  [the cabinet is drawn from parliament],
  [the President is a member of the legislature],
  [the President is chosen by the legislature]
)

#mcq(17, [The head of government in a parliamentary system is the],
  [Speaker],
  [Prime Minister],
  [monarch],
  [Chief Justice]
)

#mcq(18, [Which of the following is a function of the judiciary?],
  [Interpreting the law and adjudicating disputes],
  [Approving the budget],
  [Formulating policy],
  [Making law]
)

#mcq(19, [The power of a court to declare an Act unconstitutional is called],
  [delegated legislation],
  [judicial precedent],
  [judicial review],
  [the covering-the-field doctrine]
)

#mcq(20, [An appeal differs from a judicial review because an appeal],
  [tests the validity of a statute],
  [asks a higher court whether a decision was right],
  [is decided by the legislature],
  [is heard only by a magistrate]
)

#mcq(21, [The highest court in Nigeria is the],
  [Federal High Court],
  [National Industrial Court],
  [Supreme Court],
  [Court of Appeal]
)

#mcq(22, [The number of justices of the Supreme Court of Nigeria is],
  [twenty-one, plus the Chief Justice],
  [fifteen],
  [seven],
  [twelve]
)

#mcq(23, [Judicial independence in Nigeria is protected by],
  [security of tenure and salaries charged to the Consolidated Revenue Fund],
  [the control of the courts by the Ministry of Justice],
  [the President's power to dismiss judges],
  [the appointment of judges by the Senate alone]
)

#mcq(24, [A judge of the Supreme Court of Nigeria may be removed by],
  [the Chief Justice],
  [a simple majority of the National Assembly],
  [the President on an address supported by two-thirds of the Senate],
  [the President alone]
)

#mcq(25, [Which of the following courts is at the base of the Nigerian judicial hierarchy?],
  [The Court of Appeal],
  [The magistrate and district courts],
  [The Supreme Court],
  [The Federal High Court]
)

#mcq(26, [The judicial body that advises on the appointment of judges in Nigeria is the],
  [Federal Executive Council],
  [National Assembly],
  [Nigerian Bar Association],
  [Federal Judicial Service Commission]
)

#mcq(27, [Fundamental human rights in Nigeria may be enforced by an application to],
  [a High Court],
  [the National Assembly],
  [the President],
  [the police]
)

#mcq(28, [Delegated legislation is law made by],
  [the National Assembly],
  [the courts],
  [the electorate at a referendum],
  [a body to which the legislature has granted the power]
)

#mcq(29, [Which of the following is a reason for delegated legislation?],
  [It makes the courts unnecessary],
  [It allows ministers to amend the constitution],
  [It saves parliamentary time and uses technical expertise],
  [It removes the need for a legislature]
)

#mcq(30, [A regulation made by a minister beyond the powers granted by the enabling Act is said to be],
  [intra vires],
  [ultra vires],
  [a constitutional amendment],
  [a precedent]
)

#mcq(31, [Which of the following is a control on delegated legislation?],
  [The army's approval],
  [A referendum on every regulation],
  [Publication in the gazette],
  [The Speaker's signature]
)

#mcq(32, [The civil service is best described as],
  [the personal staff of the President],
  [the permanent body of officials who administer government departments],
  [the judges and magistrates],
  [the elected officials of the executive]
)

#mcq(33, [The civil service is said to be anonymous because],
  [its officials are unknown to the public],
  [its records are secret from the courts],
  [its officials cannot be disciplined],
  [its officials do not publicly defend policy, which is the minister's responsibility]
)

#mcq(34, [The doctrine of the rule of law requires that],
  [public officials are above the law],
  [the executive may override the courts],
  [the law applies equally to the government and the governed],
  [judges make policy]
)

#mcq(35, [Which of the following best illustrates a check by the legislature on the executive?],
  [The President vetoing a bill],
  [INEC conducting an election],
  [A court striking down a decree],
  [The Senate confirming a ministerial nominee]
)

#mcq(36, [The President's power to grant a pardon is an example of],
  [a check on the judiciary],
  [a legislative function],
  [a delegated power of the courts],
  [a prerogative of mercy exercised on the advice of the Council of State]
)

#mcq(37, [A bill becomes law in Nigeria when],
  [it is introduced in the Senate],
  [it is debated at the second reading],
  [the Speaker signs it],
  [it has passed both Houses and received the President's assent, or the veto is overridden]
)

#mcq(38, [Which of the following is NOT a function of the legislature?],
  [Adjudicating criminal cases],
  [Representing the electorate],
  [Overseeing the executive],
  [Appropriating public funds]
)

#mcq(39, [The independence of the judiciary is threatened when],
  [judges' salaries are charged to the Consolidated Revenue Fund],
  [appointments are made on the Judicial Service Commission's advice],
  [judges have security of tenure],
  [the executive ignores court orders]
)

#mcq(40, [The Chief Justice of Nigeria is appointed by],
  [the Judicial Service Commission alone],
  [the Senate alone],
  [the House of Representatives],
  [the President on the recommendation of the National Judicial Council, subject to Senate confirmation]
)

