== 7.8 Chapter 7 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Farm records are kept mainly to],
  [measure performance and plan the next season],
  [impress visitors],
  [satisfy the tax office only],
  [fill the office shelves]
)

#mcq(2, [A record showing the number of animals, their ages and their values is called a],
  [production record],
  [livestock inventory],
  [cash book],
  [labour record]
)

#mcq(3, [A record of eggs collected each day is a],
  [production record],
  [inventory],
  [labour record],
  [financial record]
)

#mcq(4, [Every entry in a farm's books must begin with],
  [a bank loan],
  [a telephone call],
  [a guess],
  [a source document]
)

#mcq(5, [The cash book is kept so that the farmer can see],
  [money received and money paid out],
  [the animals owned],
  [the eggs produced],
  [the workers employed]
)

#mcq(6, [The ledger is used to],
  [count the birds],
  [milk the cows],
  [weigh the feed],
  [sort the transactions into accounts]
)

#mcq(7, [A trial balance is prepared to],
  [value the animals],
  [check that debits equal credits],
  [calculate the profit],
  [record the labour]
)

#mcq(8, [A receipt is best described as],
  [a list of goods sent],
  [a request for payment],
  [a record of wages],
  [evidence that money was paid]
)

#mcq(9, [The yearly loss in the value of a sprayer through use and age is called],
  [money set aside for replacement],
  [the interest on a loan],
  [the fall in the value of an asset through use and age],
  [the cost of repairs]
)

#mcq(10, [Depreciation is calculated as],
  [cost × useful life],
  [salvage ÷ cost],
  [cost ÷ profit],
  [(cost − salvage) ÷ useful life]
)

#mcq(11, [A sprayer costs ₦65 000 with a salvage value of ₦5 000 and a life of 6 years. Its annual depreciation is],
  [₦10 000],
  [₦60 000],
  [₦5 000],
  [₦12 000]
)

#mcq(12, [Land is not depreciated because it],
  [is too cheap],
  [does not wear out],
  [is rented],
  [has no value]
)

#mcq(13, [A feed bill is an example of],
  [a variable cost],
  [a fixed cost],
  [a capital cost],
  [an income]
)

#mcq(14, [Rent on the farm is an example of],
  [a variable cost],
  [an asset],
  [a revenue],
  [a fixed cost]
)

#mcq(15, [Gross margin is calculated as],
  [profit plus fixed cost],
  [revenue plus cost],
  [output minus variable cost],
  [output minus total cost]
)

#mcq(16, [Net profit is],
  [revenue plus cost],
  [gross margin minus fixed cost],
  [output minus variable cost],
  [the cash in the bank]
)

#mcq(17, [Break-even is calculated as],
  [fixed cost ÷ gross margin per unit],
  [output ÷ cost],
  [gross margin ÷ fixed cost],
  [profit ÷ capital]
)

#mcq(18, [Profit expressed as a percentage of the money invested is],
  [revenue ÷ cost],
  [cost ÷ profit],
  [(profit ÷ capital) × 100],
  [profit ÷ revenue]
)

#mcq(19, [A balance sheet shows],
  [the money that moved],
  [the profit of the season],
  [the eggs produced],
  [assets, liabilities and capital on one day]
)

#mcq(20, [The accounting identity states that],
  [liabilities minus capital],
  [revenue minus cost],
  [capital minus liabilities],
  [liabilities plus capital]
)

#mcq(21, [A bank loan taken by a farmer is recorded as],
  [revenue],
  [a profit],
  [a liability],
  [an asset]
)

#mcq(22, [A cash-flow statement records],
  [the depreciation],
  [money actually received and paid, month by month],
  [the value of the assets],
  [the yield per hectare]
)

#mcq(23, [A profitable farm can still fail because],
  [profit is illegal],
  [it pays too little tax],
  [it runs out of cash before the harvest is sold],
  [it owns too much land]
)

#mcq(24, [A budget is],
  [a list of assets],
  [a bank statement],
  [a plan of expected income and expenditure],
  [a record of what happened]
)

#mcq(25, [The main reason a lender asks for farm records is to],
  [value the land],
  [count the animals],
  [judge whether the farm can repay],
  [check the farmer's handwriting]
)

#mcq(26, [A stock card records],
  [the daily egg collection],
  [the wages paid],
  [the loans received],
  [the movement of feed, seed and drugs]
)

#mcq(27, [A waybill accompanies],
  [goods in transit],
  [money paid],
  [a wage sheet],
  [a loan agreement]
)

#mcq(28, [A labour record shows],
  [the animals sold],
  [the eggs laid],
  [the feed bought],
  [who worked, for how long and for what pay]
)

#mcq(29, [If a farm's revenue is ₦800 000 and its total cost is ₦650 000, the profit is],
  [₦650 000],
  [₦1 450 000],
  [₦800 000],
  [₦150 000]
)

#mcq(30, [If fixed cost is ₦180 000 and the gross margin per bird is ₦900, the break-even number of birds is],
  [200],
  [900],
  [20],
  [180]
)

#mcq(31, [A farm has capital of ₦2 000 000 and a profit of ₦300 000. Its return on capital is],
  [6.7 per cent],
  [1.5 per cent],
  [30 per cent],
  [15 per cent]
)

#mcq(32, [Which of these is a fixed cost in a poultry enterprise?],
  [Drugs],
  [Depreciation of the house],
  [Casual labour],
  [Feed]
)

#mcq(33, [Which of these is a variable cost in a layer enterprise?],
  [Insurance],
  [Rent],
  [Feed],
  [Depreciation]
)

#mcq(34, [The trial balance is prepared from],
  [the ledger balances],
  [the stock cards],
  [the labour records],
  [the production records]
)

#mcq(35, [A farm plan is best described as],
  [a list of the tools],
  [the combination of enterprises, land, labour and capital into a programme],
  [a record of the harvest],
  [a map of the farm]
)

#mcq(36, [Keeping a record of milk yield per cow per day allows the farmer to],
  [avoid feeding the cows],
  [identify the poor milkers for culling],
  [increase the herd at once],
  [sell the farm]
)

#mcq(37, [The accounting equation is],
  [capital = profit + cost],
  [assets = liabilities + capital],
  [liabilities = assets + capital],
  [assets = revenue − cost]
)

#mcq(38, [A sinking fund is],
  [the depreciation charge],
  [a loan from a bank],
  [money set aside to replace an asset],
  [the salvage value]
)

#mcq(39, [An enterprise budget is prepared for],
  [the whole farm only],
  [the tax office],
  [one enterprise, such as the layers or the maize],
  [the bank only]
)

#mcq(40, [The balance sheet is a statement of],
  [the cash that moved],
  [what the farm owns and owes on a given date],
  [the profit of the season],
  [the eggs produced]
)

