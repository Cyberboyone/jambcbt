  [18 parts maize to 40 parts cake],
  [40 parts maize to 18 parts cake],
  [22 parts maize to 9 parts cake],
  [9 parts maize to 22 parts cake]
)

#mcq(12, [The first step in using the Pearson square is to],
  [multiply the feeds],
  [write the two feeds and the target],
  [add the feeds],
  [weigh the bag]
)

#mcq(13, [A laying hen's ration should contain about],
  [40 per cent protein],
  [5 per cent protein],
  [16–18 per cent protein],
  [60 per cent protein]
)

#mcq(14, [Calcium for a laying hen is supplied mainly by],
  [maize],
  [groundnut cake],
  [cassava peel],
  [oyster shell or limestone]
)

#mcq(15, [A mineral that is essential for bone formation is],
  [nitrogen],
  [calcium],
  [cellulose],
  [starch]
)

#mcq(16, [Vitamin A deficiency in farm animals causes],
  [poor clotting],
  [anaemia],
  [night blindness],
  [rickets]
)

