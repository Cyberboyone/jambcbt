== 1.9 Chapter 1 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Livestock production is important to Nigeria mainly because it],
  [employs no labour],
  [replaces crop farming],
  [needs no land],
  [supplies animal protein]
)

#mcq(2, [The farm animal is best described as a converter of],
  [capital into land],
  [soil into crops],
  [feed into animal products],
  [water into rain]
)

#mcq(3, [A ruminant animal is one that],
  [has no stomach],
  [has a single stomach],
  [chews only grain],
  [has a four-compartment stomach]
)

#mcq(4, [Which of these is a monogastric animal?],
  [Cow],
  [Sheep],
  [Goat],
  [Pig]
)

#mcq(5, [The scientific name of cattle is],
  [Ovis aries],
  [Capra hircus],
  [Bos indicus],
  [Sus scrofa]
)

#mcq(6, [The scientific name of the domestic fowl is],
  [Meleagris gallopavo],
  [Anas platyrhynchos],
  [Numida meleagris],
  [Gallus gallus domesticus]
)

#mcq(7, [Guinea fowl is kept in Nigeria mainly for],
  [wool],
  [milk],
  [draught power],
  [meat and eggs]
)

#mcq(8, [The system in which animals are housed all their lives and feed is carried to them is],
  [nomadic],
  [extensive],
  [intensive],
  [semi-intensive]
)

#mcq(9, [Cattle moved from place to place in search of pasture are kept under the],
  [zero-grazing system],
  [intensive system],
  [battery system],
  [extensive system]
)

#mcq(10, [A farmer who keeps goats and grows maize on the same holding is practising],
  [mixed cropping],
  [plantation agriculture],
  [mixed farming],
  [monoculture]
)

#mcq(11, [Ranching differs from nomadic herding because ranching involves],
  [movement with the season],
  [housing all year],
  [no management at all],
  [fenced range and planned grazing]
)

#mcq(12, [The White Fulani cattle breed is kept mainly for],
  [wool],
  [eggs],
  [beef and milk],
  [draught only]
)

#mcq(13, [The Muturu cattle are valued in southern Nigeria because they are],
  [hornless],
  [trypanotolerant],
  [the best milkers],
  [the heaviest breed]
)

#mcq(14, [The Red Sokoto goat is famous for its],
  [wool],
  [skin],
  [size],
  [milk yield]
)

#mcq(15, [The West African Dwarf goat is suited to the south because it is],
  [tall and fast],
  [a good draught animal],
  [small and trypanotolerant],
  [woolly]
)

#mcq(16, [The exotic pig breeds kept in Nigeria include],
  [White Fulani and Muturu],
  [Large White and Landrace],
  [Yankasa and Balami],
  [Yankasa and Uda]
)

#mcq(17, [One animal unit is usually taken as],
  [one goat],
  [one mature cow of about 450 kg],
  [one hectare of pasture],
  [one fowl]
)

#mcq(18, [A goat is about how many animal units?],
  [0.01],
  [1.0],
  [0.2],
  [2.0]
)

#mcq(19, [Stocking rate is expressed as],
  [animal units per hectare],
  [kilograms per animal],
  [animals per farmer],
  [hectares per animal]
)

#mcq(20, [Overstocking a pasture leads to],
  [erosion and a feed shortage],
  [higher rainfall],
  [fewer diseases],
  [better grass growth]
)

#mcq(21, [The main feed problem of the livestock industry in the dry season is],
  [a shortage of water only],
  [too much rain],
  [a shortage of forage],
  [too many animals]
)

#mcq(22, [Trypanosomiasis limits cattle production in Nigeria because it is spread by],
  [the housefly],
  [the mosquito],
  [the tick],
  [the tsetse fly]
)

#mcq(23, [The most important product of poultry apart from meat is],
  [eggs],
  [wool],
  [hides],
  [honey]
)

#mcq(24, [Draught animals are most important in Nigeria for],
  [milk production],
  [egg production],
  [ploughing and carting],
  [wool]
)

#mcq(25, [Manure from livestock is valuable because it],
  [kills weeds],
  [replaces water],
  [improves soil structure and supplies nutrients],
  [lowers the pH]
)

#mcq(26, [The keeping of bees is called],
  [aquaculture],
  [silviculture],
  [sericulture],
  [apiculture]
)

#mcq(27, [The keeping of fish is called],
  [apiculture],
  [arboriculture],
  [horticulture],
  [aquaculture]
)

#mcq(28, [Snail farming is known as],
  [pisciculture],
  [apiculture],
  [heliciculture],
  [sericulture]
)

#mcq(29, [A dual-purpose animal is one kept for],
  [two products, such as milk and meat],
  [two owners],
  [two farms],
  [two seasons]
)

#mcq(30, [The commonest cattle breed in the northern savanna is the],
  [White Fulani],
  [Large White],
  [Muturu],
  [Ndama]
)

#mcq(31, [Which of these is NOT a reason for keeping livestock?],
  [To reduce the farm's labour force],
  [To supply protein],
  [To spread risk],
  [To supply manure]
)

#mcq(32, [The livestock industry in Nigeria is held back by],
  [too much veterinary care],
  [poor genetic quality of local stock],
  [too much pasture],
  [too few animals]
)

#mcq(33, [A farmer with 20 hectares carrying 2 AU per hectare can keep how many cows?],
  [40],
  [10],
  [80],
  [20]
)

#mcq(34, [How many goats of 0.2 AU will a 5 ha pasture at 3 AU/ha carry?],
  [15],
  [75],
  [30],
  [150]
)

#mcq(35, [Semi-intensive production is best illustrated by],
  [village poultry housed at night and scavenging by day],
  [nomadic cattle],
  [a fenced ranch],
  [battery-cage layers]
)

#mcq(36, [The main advantage of the intensive system is],
  [cheap housing],
  [free feed],
  [no labour needed],
  [control of feed, climate and disease]
)

#mcq(37, [A major disadvantage of the extensive system is],
  [exposure to disease, theft and feed shortage],
  [the animals cannot move],
  [high housing cost],
  [high feed cost]
)

#mcq(38, [Cross-breeding a local dam with an exotic sire is done to obtain],
  [purebred stock],
  [a sterile animal],
  [hybrid vigour],
  [a smaller animal]
)

#mcq(39, [The branch of agriculture that deals with farm animals is],
  [animal science],
  [horticulture],
  [agronomy],
  [soil science]
)

#mcq(40, [Zero-grazing is a system in which],
  [forage is cut and carried to housed animals],
  [animals are kept on a ranch],
  [animals are moved with the season],
  [animals graze the open range]
)

