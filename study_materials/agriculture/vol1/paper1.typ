== Section A — Soil science (Questions 1–12)

#mcq(1, [A soil sample from a plot is 60 per cent sand, 25 per cent silt and 15 per cent clay. The texture class is],
  [silt loam],
  [pure sand],
  [heavy clay],
  [sandy loam]
)

#mcq(2, [The horizon in which a farmer's roots and fertiliser are concentrated is the],
  [A horizon],
  [R horizon],
  [B horizon],
  [C horizon]
)

#mcq(3, [Which pair of rock types is matched correctly with the soil it tends to give?],
  [granite — alkaline and heavy],
  [shale — coarse sand],
  [limestone — base-rich and near neutral],
  [sandstone — heavy clay]
)

#mcq(4, [Soil formation is slowest where],
  [the climate is hot and wet],
  [the rock is soft],
  [the climate is cold and dry],
  [the slope is gentle]
)

#mcq(5, [A soil that holds water so tightly that plants wilt has reached],
  [the wilting point],
  [saturation],
  [field capacity],
  [the water table]
)

#mcq(6, [The main benefit of humus in a sandy soil is that it],
  [increases the sand fraction],
  [increases water-holding and nutrient retention],
  [raises the pH to 8],
  [prevents root growth]
)

#mcq(7, [Which practice would most quickly raise the pH of an acid soil?],
  [apply ammonium sulphate],
  [applying agricultural lime],
  [adding sulphur],
  [applying urea]
)

#mcq(8, [A profile with a deep, dark A horizon and no hardpan is likely to be],
  [a waterlogged clay],
  [a saline soil],
  [a shallow, stony soil],
  [a fertile, well-drained soil]
)

#mcq(9, [Soil structure is destroyed most quickly by],
  [adding compost],
  [growing a cover crop],
  [mulching the surface],
  [working the soil when it is wet]
)

#mcq(10, [The mineral fraction that gives a soil its reddish colour in the tropics is rich in],
  [calcium carbonate],
  [iron oxides],
  [silica only],
  [sodium chloride]
)

#mcq(11, [Which of these soils would you expect on a river floodplain that floods each year?],
  [alluvial soil, renewed and fertile],
  [laterite, hard when dry],
  [volcanic soil, dark and stony],
  [mangrove soil, saline]
)

#mcq(12, [Soil colour, texture and depth are all properties used in],
  [grading the harvest],
  [calculating the seed rate],
  [describing and classifying a soil],
  [measuring the rainfall]
)

== Section B — Land preparation and cultural practice (Questions 13–22)

#mcq(13, [Which sequence puts the operations in the right order?],
  [mark out, clear, plant, plough],
  [plough, clear, plant, harrow],
  [clear, plough, harrow, mark out, plant],
  [harrow, plough, clear, plant]
)

#mcq(14, [A farmer ploughs a field for ten years at the same depth. The likely result is],
  [an increase in organic matter],
  [a fall in the pH],
  [a compacted pan below the plough],
  [a deeper topsoil each year]
)

#mcq(15, [Broadcasting seed is least suitable where the farmer],
  [has no seed drill],
  [wants to cover a large area quickly],
  [is sowing a pasture grass],
  [needs a precise plant population]
)

#mcq(16, [If a crop is spaced at 60 cm by 30 cm, the number of stands on one hectare is about],
  [5 556],
  [1 800],
  [55 556],
  [555 556]
)

#mcq(17, [A farmer plants 20 000 stands but only 17 400 survive. He should],
  [thin the remaining plants],
  [apply more nitrogen only],
  [harvest early],
  [supply the gaps to restore the planned population]
)

#mcq(18, [Earthing up benefits a yam crop by],
  [lowering the pH],
  [raising the plant population],
  [giving the tubers more soil to swell into],
  [reducing the seed rate]
)

#mcq(19, [Staking is least necessary for],
  [groundnut],
  [yam with vines],
  [climbing bean],
  [tomato]
)

#mcq(20, [The purpose of shading a nursery bed is to],
  [prevent scorching and heavy rain damage],
  [increase the temperature],
  [dry the medium],
  [encourage weeds]
)

#mcq(21, [Which cultural practice removes competition without removing plants?],
  [weeding],
  [thinning],
  [supplying],
  [staking]
)

#mcq(22, [Which practice would be most useful on a field that floods in the rainy season?],
  [deep ploughing only],
  [removing the drains],
  [planting on ridges with surface drains],
  [planting on the flat]
)

== Section C — Propagation and nursery (Questions 23–30)

#mcq(23, [A seed that floats in water is usually],
  [hollow or poorly filled],
  [fully mature],
  [the heaviest seed in the lot],
  [the most viable seed]
)

#mcq(24, [The endosperm of a maize grain functions to],
  [absorb water from the soil],
  [protect the seed],
  [store food for the seedling],
  [become the root]
)

#mcq(25, [A germination test gave 45 seedlings from 50 seeds. The germination percentage is],
  [90],
  [45],
  [50],
  [9]
)

#mcq(26, [Which of these would break the dormancy of a hard-coated seed?],
  [adding fertiliser],
  [scarifying the coat with sand or a file],
  [keeping it in the dark],
  [soaking it in water only]
)

#mcq(27, [A farmer wants uniform, early-bearing avocado trees. He should use],
  [seed from the best tree],
  [grafting or budding],
  [tissue culture only],
  [root cuttings]
)

#mcq(28, [Which of these is propagated from a leaf?],
  [cassava],
  [banana],
  [yam],
  [bryophyllum]
)

#mcq(29, [The advantage of using certified seed is that it],
  [is always cheaper],
  [needs no fertiliser],
  [has known purity, viability and freedom from seed-borne disease],
  [cannot be attacked by pests]
)

#mcq(30, [A nursery medium of topsoil, sand and rotted manure is used because it is],
  [sterile and nutrient-free],
  [heavy and waterlogged],
  [fine, fertile and free-draining],
  [pure clay]
)

== Section D — Fertility, manure and fertiliser (Questions 31–36)

#mcq(31, [Applying 100 kg of NPK 20-10-10 per hectare supplies how much K₂O?],
  [10 kg],
  [20 kg],
  [50 kg],
  [5 kg]
)

#mcq(32, [Which fertiliser would you choose for a leafy vegetable crop?],
  [lime],
  [single superphosphate],
  [muriate of potash],
  [urea, for nitrogen]
)

#mcq(33, [Which practice adds nitrogen to the soil without buying fertiliser?],
  [deep ploughing],
  [burning the crop residue],
  [removing the crop residue],
  [ploughing in a leguminous green manure]
)

#mcq(34, [Placement of fertiliser rather than broadcasting is preferred where],
  [the crop is a close-planted pasture],
  [the soil is sandy and leaching is rapid],
  [the field is steep],
  [the farmer has no labour]
)

#mcq(35, [Contour ploughing is used on a slope in order to],
  [deepen the rills],
  [reduce the speed of runoff and soil loss],
  [increase the angle of the slope],
  [remove the topsoil]
)

#mcq(36, [Which of these is the best measure against sheet erosion on a bare slope?],
  [ploughing down the slope],
  [removing all vegetation],
  [bare fallowing],
  [maintaining a cover of mulch or a cover crop]
)

== Section E — Tools and machines (Questions 37–40)

#mcq(37, [Which implement is used to make the ridges on which yam is planted?],
  [harrow],
  [ridger],
  [subsoiler],
  [roller]
)

#mcq(38, [The knapsack sprayer must be calibrated before use so that],
  [the nozzle wears out],
  [the correct dose reaches each hectare],
  [the operator works faster],
  [it uses more chemical]
)

#mcq(39, [A disc harrow is preferred to a spike-tooth harrow on],
  [level pasture],
  [waterlogged fields],
  [light sandy seedbeds],
  [heavy or trashy ground]
)

#mcq(40, [The wheelbarrow is most useful on a farm for],
  [irrigating beds],
  [ploughing the field],
  [spraying crops],
  [moving manure, tools and harvested produce]
)

