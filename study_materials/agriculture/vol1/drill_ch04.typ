== 4.10 Chapter 4 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Primary tillage is carried out with a],
  [ridger],
  [plough],
  [harrow],
  [roller]
)

#mcq(2, [Secondary tillage that breaks the clods left by ploughing is],
  [harrowing],
  [levelling],
  [subsoiling],
  [clearing]
)

#mcq(3, [The correct sequence of land preparation is],
  [harrowing, clearing, ploughing, planting],
  [clearing, ploughing, harrowing, levelling, planting],
  [clearing, harrowing, ploughing, planting],
  [ploughing, clearing, planting, harrowing]
)

#mcq(4, [A plough pan is formed by],
  [harrowing in dry weather],
  [repeated ploughing at the same depth],
  [planting a cover crop],
  [adding organic matter]
)

#mcq(5, [A subsoiler is used to],
  [level the field],
  [break clods on the surface],
  [invert the topsoil],
  [shatter a compacted layer below plough depth]
)

#mcq(6, [Which plough is best suited to stony or rooty ground?],
  [subsoiler],
  [chisel plough],
  [mouldboard plough],
  [disc plough]
)

#mcq(7, [Controlled burning of the cleared trash is discouraged in good practice because it],
  [raises the pH too high],
  [takes too long],
  [needs too much labour],
  [destroys organic matter and soil organisms]
)

#mcq(8, [Ridging is done mainly to],
  [improve drainage and give room for tubers],
  [mark the spacing],
  [level the field],
  [break clods]
)

#mcq(9, [Planting at 75 cm × 25 cm gives a plant population per hectare of about],
  [5 333],
  [133 333],
  [13 333],
  [53 333]
)

#mcq(10, [Cassava planted at 1 m × 1 m has a plant population per hectare of],
  [1 000],
  [10 000],
  [100 000],
  [5 000]
)

#mcq(11, [Seed rate must be increased when the germination percentage is],
  [high],
  [above 90],
  [low],
  [exactly 100]
)

#mcq(12, [Dibbling is the method of planting in which seed is],
  [dropped into holes made at each stand],
  [dropped in continuous furrows],
  [raised in a nursery first],
  [scattered over the surface]
)

#mcq(13, [Transplanting is used for crops such as],
  [cowpea and groundnut],
  [maize and sorghum],
  [tomato, pepper and rice],
  [millet and sesame]
)

#mcq(14, [Thinning is carried out in order to],
  [fill gaps in the stand],
  [remove excess seedlings and reduce competition],
  [control weeds between rows],
  [add fertiliser]
)

#mcq(15, [Supplying is the practice of],
  [adding fertiliser],
  [removing excess plants],
  [replanting gaps to maintain the plant population],
  [watering the seedlings]
)

#mcq(16, [The first weeding of a crop is the most critical because],
  [weeding improves the soil],
  [weeds are impossible to kill later],
  [it prevents flowering],
  [the young crop competes poorly for light, water and nutrients]
)

#mcq(17, [Mulching is the covering of the soil surface with],
  [a plastic sheet only],
  [ploughed-in manure],
  [crop residue or other material],
  [a layer of fertiliser]
)

#mcq(18, [Mulching conserves soil moisture mainly by],
  [reducing evaporation from the surface],
  [improving germination],
  [raising the water table],
  [increasing rainfall]
)

#mcq(19, [Staking is practised on tomato and yam vines mainly to],
  [raise the soil pH],
  [increase the plant population],
  [control weeds chemically],
  [keep the fruit off the ground and improve light]
)

#mcq(20, [Pruning is carried out mainly to],
  [reduce the need for water entirely],
  [remove unwanted branches and shape the plant],
  [increase the seed rate],
  [increase the plant population]
)

#mcq(21, [Earthing up is the practice of],
  [flattening the ridges],
  [applying manure to the surface],
  [removing soil from the ridges],
  [drawing soil up around the base of the stem]
)

#mcq(22, [Drip irrigation is preferred where water is scarce because it],
  [is the cheapest to install],
  [requires no maintenance],
  [floods the whole field],
  [delivers water to the root zone with little loss]
)

#mcq(23, [Which irrigation method is most suitable for rice?],
  [drip irrigation],
  [sprinkler irrigation],
  [sub-surface irrigation],
  [basin or flood irrigation]
)

#mcq(24, [Sprinkler irrigation is less efficient than drip because of],
  [the cost of the pipes],
  [evaporation and wind drift],
  [too little water delivery],
  [soil compaction]
)

#mcq(25, [Surface drainage is achieved by],
  [open channels and raised beds],
  [tile drains under the soil],
  [mulching the surface],
  [irrigating at night]
)

#mcq(26, [Which crop would be most damaged by poor drainage?],
  [sugarcane],
  [rice],
  [cassava],
  [cocoyam in a swamp]
)

#mcq(27, [The cutlass is used mainly for],
  [clearing bush and harvesting],
  [applying fertiliser],
  [spraying pesticides],
  [levelling seedbeds]
)

#mcq(28, [A knapsack sprayer is used for],
  [applying herbicides, insecticides and foliar feeds],
  [watering nursery beds],
  [carrying harvested produce],
  [marking the plant spacing]
)

#mcq(29, [Which implement would a farmer use to break clods and level a seedbed after ploughing?],
  [ridger],
  [mouldboard plough],
  [harrow],
  [subsoiler]
)

#mcq(30, [A roller is used in land preparation to],
  [firm and level the surface],
  [make ridges],
  [cut the furrow slice],
  [shatter a hardpan]
)

#mcq(31, [Animal traction is most appropriate for],
  [small fields where a tractor is uneconomic],
  [irrigated rice schemes],
  [large estates],
  [orchard establishment]
)

#mcq(32, [Which of these is a disadvantage of mechanised land clearing with a bulldozer?],
  [it is too slow],
  [it leaves too many stumps],
  [it cannot be used on flat land],
  [it compacts the soil and removes the topsoil]
)

#mcq(33, [A fine tilth is important for small seeds because],
  [the seed must make close contact with moist soil],
  [it prevents germination],
  [it makes the field look neat],
  [it increases the plant population]
)

#mcq(34, [Which operation comes immediately after marking out a field for planting?],
  [harvesting the previous crop],
  [harrowing the seedbed again],
  [making the holes or furrows at the marked stands],
  [applying the first weeding]
)

#mcq(35, [Weeds are controlled mechanically by],
  [releasing an insect enemy],
  [hoeing and hand pulling],
  [smothering with a cover crop],
  [applying herbicide]
)

#mcq(36, [Which practice best protects a sloping field from both erosion and drought?],
  [ploughing down the slope],
  [contour ridging with mulch],
  [removing all vegetation],
  [burning the crop residue]
)

#mcq(37, [Planting on the flat rather than on ridges is preferred when],
  [the crop is yam],
  [the soil is well drained and the crop is a cereal],
  [the farmer wants deeper tubers],
  [the field is waterlogged]
)

#mcq(38, [The main reason for levelling a field before planting rice is to],
  [increase the plant population],
  [control weeds],
  [spread the irrigation water evenly],
  [reduce the seed rate]
)

#mcq(39, [A farmer who plants at a closer spacing than recommended should expect],
  [fewer weeds automatically],
  [more plants but a lower yield per plant],
  [a higher yield with no cost],
  [no change in the yield]
)

#mcq(40, [A farmer planting a legume on a plot that has grown maize for three years is mainly],
  [levelling the field],
  [increasing the seed rate],
  [rotating crops to restore nitrogen and break the pest cycle],
  [irrigating the field]
)

