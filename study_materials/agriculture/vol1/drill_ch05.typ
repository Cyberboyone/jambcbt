== 5.7 Chapter 5 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [The part of a germinating seed that emerges first is the],
  [testa],
  [cotyledon],
  [plumule],
  [radicle]
)

#mcq(2, [The part of the seed that becomes the shoot is the],
  [radicle],
  [plumule],
  [hilum],
  [endosperm]
)

#mcq(3, [The tough outer covering of a seed is the],
  [radicle],
  [hilum],
  [testa],
  [cotyledon]
)

#mcq(4, [The food store outside the embryo in many monocot seeds is the],
  [endosperm],
  [plumule],
  [testa],
  [cotyledon]
)

#mcq(5, [Which of the following is NOT required for germination?],
  [moisture],
  [a suitable temperature],
  [oxygen],
  [light]
)

#mcq(6, [A seed planted in waterlogged soil fails to germinate because of a shortage of],
  [heat],
  [oxygen],
  [light],
  [moisture]
)

#mcq(7, [Germination in which the cotyledons are carried above the soil is],
  [epigeal],
  [hypogeal],
  [dormant],
  [viviparous]
)

#mcq(8, [Maize germination is hypogeal because the cotyledon],
  [remains below the soil surface],
  [carries the seed leaves up],
  [is shed at once],
  [turns green above the soil]
)

#mcq(9, [If 180 out of 200 seeds germinate, the germination percentage is],
  [90],
  [180],
  [45],
  [18]
)

#mcq(10, [Seed viability means the seed is],
  [dry enough to store],
  [large in size],
  [free of chaff],
  [alive and capable of germinating]
)

#mcq(11, [The tetrazolium test is used to determine seed],
  [purity],
  [viability],
  [moisture content],
  [size]
)

#mcq(12, [Scarification is carried out to],
  [break a hard seed coat],
  [increase the moisture content],
  [reduce the seed rate],
  [kill a fungus]
)

#mcq(13, [Inoculation of a legume seed before sowing is done with],
  [urea],
  [rhizobium bacteria],
  [lime],
  [a fungicide only]
)

#mcq(14, [Cassava is normally propagated by],
  [seed],
  [layering],
  [budding],
  [stem cuttings]
)

#mcq(15, [Yam is normally propagated by],
  [setts cut from the tuber],
  [grafting],
  [leaf cuttings],
  [seed]
)

#mcq(16, [Banana and plantain are propagated by],
  [suckers],
  [seed],
  [budding],
  [stem cuttings]
)

#mcq(17, [Budding and grafting are used mainly to],
  [combine a desirable scion with a hardy rootstock],
  [control weeds],
  [increase the number of seeds],
  [avoid planting]
)

#mcq(18, [A grafted mango fruits earlier than a seedling because the scion],
  [needs no water],
  [grows a deeper taproot],
  [is already mature when it is joined],
  [is immune to disease]
)

#mcq(19, [Marcotting is also known as],
  [tissue culture],
  [air layering],
  [grafting],
  [budding]
)

#mcq(20, [The main advantage of vegetative propagation is that the new plant],
  [is always disease-free],
  [has a taproot],
  [needs no water],
  [is identical to the parent]
)

#mcq(21, [The main disadvantage of vegetative propagation is that],
  [it carries viruses from parent to offspring],
  [it produces variable plants],
  [it is too expensive],
  [it cannot be done in Nigeria]
)

#mcq(22, [Tissue culture is used in crop production to],
  [store tubers],
  [control weeds],
  [produce many disease-free plantlets quickly],
  [increase the seed size]
)

#mcq(23, [A nursery is best sited],
  [near a water supply on level ground with some shade],
  [in a waterlogged hollow],
  [at the lowest point of the farm],
  [on a hilltop in full sun]
)

#mcq(24, [Nursery beds are raised above the paths mainly to],
  [keep the seed dry],
  [reduce the shade],
  [increase the plant population],
  [improve drainage and make watering easy]
)

#mcq(25, [The nursery medium should be],
  [pure clay],
  [fine, fertile and free of weed seed],
  [the subsoil from the field],
  [coarse gravel]
)

#mcq(26, [Shade is provided over a nursery bed in order to],
  [protect seedlings from scorching sun and heavy rain],
  [kill insects],
  [dry the soil],
  [increase the temperature]
)

#mcq(27, [Pricking out is the transfer of seedlings],
  [from the nursery to the field],
  [from the field to the store],
  [from the store to the market],
  [from the seed tray to wider spacing in the nursery]
)

#mcq(28, [Hardening off is carried out in order to],
  [speed up germination],
  [increase the seed rate],
  [prepare seedlings for the harsher conditions of the field],
  [kill soil pests]
)

#mcq(29, [Transplanting is best done],
  [at midday in full sun],
  [in a heavy rainstorm],
  [in the evening or on a cloudy day],
  [after the soil has dried out]
)

#mcq(30, [Seedlings are lifted with a ball of soil at transplanting in order to],
  [reduce the seed rate],
  [keep the roots moist and undamaged],
  [increase their weight],
  [make them easier to count]
)

#mcq(31, [A seed lot described as having 95 per cent purity],
  [has 95 per cent viability],
  [will germinate at 95 per cent],
  [is 95 per cent moisture free],
  [contains 5 per cent inert matter and other seed]
)

#mcq(32, [The seed rate for a crop is calculated from the plant population and the],
  [depth of planting],
  [colour of the seed],
  [germination percentage and seed weight],
  [price of the seed]
)

#mcq(33, [Which of these crops is propagated by tubers or setts rather than by seed?],
  [sorghum],
  [cowpea],
  [cocoyam],
  [maize]
)

#mcq(34, [A nursery is protected from damping-off chiefly by],
  [sowing more densely],
  [watering more often],
  [using a sterilised medium and clean seed],
  [adding more shade]
)

#mcq(35, [Which of the following would NOT be a reason to raise seedlings in a nursery?],
  [to reduce the plant population in the field],
  [to use a small area for intensive care],
  [to protect the young plants],
  [to raise plants for transplanting]
)

#mcq(36, [Layering differs from cutting because in layering the new plant],
  [is detached before rooting],
  [roots while still attached to the parent],
  [is grown in water only],
  [is grown from seed]
)

#mcq(37, [Which practice would most improve the survival of transplants?],
  [planting at midday],
  [watering immediately after planting and shading for a few days],
  [trimming all the roots],
  [planting deeper than the collar]
)

#mcq(38, [Seed dormancy is best described as],
  [the loss of the seed coat],
  [the death of the embryo],
  [a state in which a viable seed will not germinate though conditions are suitable],
  [the start of germination]
)

#mcq(39, [Which of these is a stem cutting crop?],
  [millet],
  [sugar cane],
  [groundnut],
  [cowpea]
)

#mcq(40, [The main reason for treating seed with a fungicide before sowing is to],
  [attract insects for pollination],
  [make the seed heavier],
  [protect the germinating seed from soil fungi],
  [increase the germination percentage]
)

