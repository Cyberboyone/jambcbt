  [Fear, Flight, Fate],
  [Crime, Trial, Appeal],
  [Winter, Spring, Summer]
)

#mcq(2, [The novel opens with],
  [a newspaper headline],
  [a car journey],
  [the killing of a rat in a one-room kitchenette],
  [a courtroom scene]
)

#mcq(3, [Bigger's job with the Daltons is arranged by],
  [the relief agency],
  [his mother's church],
  [his friend Gus],
  [Mary Dalton]
)

#mcq(4, [The Daltons are significant because they],
  [knew Bigger's father],
