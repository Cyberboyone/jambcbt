  [Alfred, Lord Tennyson],
  [Kofi Awoonor],
  [Gbemisola Adeoti]
)

#mcq(2, [Diop's poem belongs to which movement?],
  [Négritude],
  [Romanticism],
  [the Harlem Renaissance],
  [the Metaphysical school]
)

#mcq(3, [Vanity is written in],
  [a sonnet form],
  [rhyme royal],
  [free verse],
  [blank verse]
)

#mcq(4, [The number of stanzas in Vanity is],
  [seven],
  [four],
  [five],
