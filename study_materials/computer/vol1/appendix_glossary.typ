#import "template.typ": *
#current-chapter.update("Appendix F: Glossary")
= Appendix F — Computing Glossary

Use these short definitions for retrieval practice. Cover the right-hand column, explain the term aloud, and then check your answer against the relevant chapter.

#table(columns: (1fr, 2.8fr), inset: 5pt, stroke: 0.5pt + jamb-border,
  table.header([*Term*], [*Meaning in this volume*]),
  [Algorithm], [A finite sequence of steps for solving a problem.],
  [ALU], [The processor component that performs arithmetic and logical operations.],
  [Analog], [Represented using a continuously varying quantity.],
  [Application], [Software designed to help users perform particular tasks.],
  [Backup], [A separate recoverable copy of data.],
  [Binary], [A base-two number system using the digits 0 and 1.],
  [Bit], [One binary digit.],
  [Browser], [Software used to access and display web resources.],
  [Byte], [A group of eight bits.],
  [Cache], [Fast memory that holds copies of useful data or instructions closer to processing.],
  [Cell], [The intersection of a spreadsheet row and column.],
  [Compiler], [A translator that converts source code into another representation.],
  [CPU], [The central processing unit that executes instructions.],
  [Data], [Raw facts or symbols, before interpretation in a particular context.],
  [Digital], [Represented using discrete values.],
  [DNS], [A system that helps resolve domain names to information such as IP addresses.],
  [Driver], [Software that helps an operating system use a hardware device.],
  [File], [A named collection of stored data.],
  [Firmware], [Software closely associated with a device and its low-level operation.],
  [Folder], [A container used to organise files and other folders.],
  [Hardware], [The physical components of a computer system.],
  [HDD], [A storage drive that uses rotating magnetic platters.],
  [HTTPS], [A protocol that protects web communication in transit.],
  [Input], [Data or instructions supplied to a system.],
  [LAN], [A local area network, commonly covering a limited area.],
  [OCR], [Optical character recognition, used to recognise characters in images.],
  [OMR], [Optical mark recognition, used to detect marks in specified positions.],
  [Operating system], [System software that manages resources and provides services.],
  [Output], [Information presented by a system.],
  [Peripheral], [A device connected to provide a function such as input or output.],
  [Phishing], [An attempt to deceive a person into disclosure or another unsafe action.],
  [Pixel], [A picture element in a raster image.],
  [RAM], [Volatile working memory used by active programs and data.],
  [Register], [A small processor storage location for immediately needed values.],
  [Router], [A device that forwards packets between networks.],
  [Software], [Programs and related instructions that direct a computer.],
  [SSD], [A solid-state drive, commonly using non-volatile flash memory.],
  [URL], [An identifier for a resource such as a web page.],
  [Utility], [Software that supports maintenance, management or protection.],
  [Volatile], [Describing memory that loses its contents when power is removed.],
)
