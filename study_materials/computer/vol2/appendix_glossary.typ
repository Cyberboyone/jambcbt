#import "template.typ": *
#current-chapter.update("Appendix F: Glossary")
= Appendix F — Computing Glossary

#table(columns: (1fr, 2.8fr), inset: 5pt, stroke: 0.5pt + jamb-border,
  table.header([*Term*], [*Meaning in this volume*]),
  [Algorithm], [A finite ordered set of unambiguous steps for solving a problem.],
  [Pseudocode], [A structured, human-readable description of an algorithm.],
  [Flowchart], [A graphical representation of steps and control paths.],
  [Sequence], [Steps performed in order.],
  [Selection], [Choosing a path according to a condition.],
  [Iteration], [Repeating steps according to a rule.],
  [Trace table], [A record of variable values as an algorithm executes.],
  [Variable], [A name for a value that can be used and, where permitted, changed.],
  [Constant], [A value intended not to change in its relevant scope.],
  [Boolean], [A type or value representing true or false.],
  [Assembler], [A translator for assembly-language instructions.],
  [Compiler], [A translator from source code into another representation.],
  [Syntax error], [A violation of a language's grammar.],
  [Runtime error], [A fault occurring during execution, subject to language behaviour.],
  [Logic error], [An error in the procedure that causes an unintended result.],
  [Requirement], [A statement of needed behaviour or a constraint.],
  [Feasibility], [Practicality under relevant constraints such as resources and time.],
  [Test case], [A specified input and expected outcome used to assess behaviour.],
  [Boundary], [An endpoint or edge of a specified range or condition.],
  [Deployment], [Making a system available in its intended environment.],
  [Maintenance], [Correction, adaptation or improvement after deployment.],
  [AI], [A broad field involving systems that perform tasks associated with abilities such as recognition or reasoning.],
  [Machine learning], [Approaches that fit models using data.],
  [Training data], [Examples used to fit a model.],
  [Test set], [Cases used to evaluate a trained model.],
  [Accuracy], [The fraction of evaluated cases classified correctly, under the stated evaluation.],
  [Sensor], [A component that detects or measures a condition.],
  [Actuator], [A component that produces physical action.],
  [Feedback], [Information about an outcome used to guide subsequent control.],
  [Confidentiality], [Protection against unauthorised disclosure.],
  [Integrity], [Protection against unauthorised or improper alteration.],
  [Availability], [Access for authorised users when needed.],
  [Vulnerability], [A weakness that can be exploited.],
  [Phishing], [Deception intended to induce unsafe disclosure or action.],
  [Backup], [A separate recoverable copy of data.],
  [Attribution], [Acknowledgement of a source.],
  [Plagiarism], [Presenting another person's work or ideas as one's own without appropriate acknowledgement.],
  [Accessibility], [Design and provision that supports use by people with differing abilities.],
  [Digital divide], [Unequal access to digital technology, connectivity or skills.],
)
