== Section A — Basic Concepts and Definitions (Questions 1–4)

#mcq(1, [Economics is chiefly concerned with],
  [how governments can collect more tax],
  [how the prices of shares are forecast],
  [how scarce resources are allocated among competing wants],
  [how firms can maximise their profits]
)

#mcq(2, [The statement that the government should spend more on education is],
  [a positive statement],
  [a hypothesis that data can test],
  [a normative statement],
  [a definition]
)

#mcq(3, [A free good is best described as one that],
  [is given away by the government],
  [is produced only by the public sector],
  [has no opportunity cost because it is not scarce],
  [carries a zero price but is still scarce]
)

#mcq(4, [The reward for the factor of production called entrepreneurship is],
  [interest],
  [profit],
  [rent],
  [wages]
)

== Section B — Demand, Supply and Price (Questions 5–12)

#mcq(5, [A change in the price of a good, other things being equal, produces],
  [a shift of its demand curve],
  [a shift of its supply curve],
  [a movement along its demand curve],
  [a change in consumers' tastes]
)

#mcq(6, [Which of the following will shift the supply curve of maize but not the demand curve?],
  [a rise in consumers' incomes],
  [a rise in the price of fertiliser],
  [a fall in the price of a substitute food],
  [a change in consumers' tastes]
)

#mcq(7, [Demand for a good falls while its supply rises. Which outcome is certain?],
  [the quantity traded falls],
  [the price rises],
  [the quantity traded rises],
  [the price falls]
)

#mcq(8, [A maximum price fixed below the equilibrium price will most likely produce],
  [a surplus and a black market],
  [no change, because the market ignores the law],
  [a shortage and a black market],
  [a surplus and a fall in price]
)

#mcq(9, [A subsidy paid to producers of a good will],
  [shift supply to the right and lower the price],
  [shift demand to the right and raise the price],
  [leave both price and quantity unchanged],
  [shift supply to the left and raise the price]
)

#mcq(10, [Demand for a good rises while its supply is perfectly inelastic. The result is],
  [a higher price and an unchanged quantity],
  [a higher price and a larger quantity],
  [a lower price and a larger quantity],
  [no change in price, because supply cannot respond]
)

#mcq(11, [Given Qd = 80 − 2P and Qs = 20 + 2P, the equilibrium price and quantity are],
  [₦15 and 50 units],
  [₦10 and 60 units],
  [₦20 and 40 units],
  [₦25 and 30 units]
)

#mcq(12, [Which of the following will NOT shift the demand curve for bread?],
  [a successful advertising campaign for bread],
  [a fall in the price of butter, a complement],
  [a rise in the price of bread],
  [a rise in the incomes of bread eaters]
)

== Section C — Elasticity (Questions 13–16)

#mcq(13, [The price of a good falls from ₦20 to ₦18 and quantity demanded rises from 100 to 120 units. The price elasticity of demand is],
  [20.0],
  [2.0],
  [0.5],
  [1.0]
)

#mcq(14, [A supply curve that is perfectly inelastic is drawn as],
  [a line sloping upward to the right],
  [a curve bowed towards the origin],
  [a horizontal line],
  [a vertical line]
)

#mcq(15, [When the demand for a good is elastic, a fall in its price will],
  [raise total cost],
  [lower total revenue],
  [leave total revenue unchanged],
  [raise total revenue]
)

#mcq(16, [The price of good Y rises by 10 per cent and the quantity of good X demanded falls by 5 per cent. The cross elasticity of demand is],
  [−0.5 and the goods are complements],
  [−2.0 and the goods are substitutes],
  [+2.0 and the goods are substitutes],
  [+0.5 and the goods are complements]
)

== Section D — Production and Cost (Questions 17–20)

#mcq(17, [The law of diminishing returns applies],
  [in the short run, when at least one factor is fixed],
  [only when output falls],
  [only in agriculture],
  [in the long run, when all factors change]
)

#mcq(18, [A firm's fixed cost is ₦200 and its average variable cost is ₦30 at an output of 10 units. Its total cost is],
  [₦2,300],
  [₦300],
  [₦230],
  [₦500]
)

#mcq(19, [A firm sells every unit at ₦40 and its total cost is TC = 300 + 25Q. Its break-even output is],
  [12 units],
  [20 units],
  [40 units],
  [15 units]
)

#mcq(20, [Economies of scale are present when],
  [long-run average cost falls as output rises],
  [short-run marginal cost rises as output rises],
  [total fixed cost rises with output],
  [average variable cost is constant]
)

== Section E — Market Structures (Questions 21–23)

#mcq(21, [Which of the following is NOT a feature of perfect competition?],
  [many buyers and sellers],
  [a homogeneous product],
  [product differentiation],
  [free entry and exit]
)

#mcq(22, [A monopolist faces the demand curve P = 60 − Q and has a constant marginal cost of ₦10. Its profit-maximising output is],
  [50 units],
  [30 units],
  [20 units],
  [25 units]
)

#mcq(23, [Deadweight loss arises under monopoly because the monopolist],
  [charges a price equal to marginal cost],
  [faces a horizontal demand curve],
  [produces less than the allocatively efficient output],
  [earns only normal profit]
)

== Section F — The National Economy (Questions 24–38)

#mcq(24, [Gross domestic product is the],
  [value of a country's exports minus its imports],
  [total income earned by a country's citizens anywhere in the world],
  [total value of all goods and services sold in a country in a year],
  [market value of final goods and services produced within a country in a year]
)

#mcq(25, [Gross national product differs from gross domestic product by],
  [net factor income from abroad],
  [depreciation],
  [indirect taxes],
  [the rate of inflation]
)

