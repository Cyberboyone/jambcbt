  [removes the effect of price changes]
)

#mcq(27, [Per capita income is obtained by dividing national income by],
  [the population],
  [the labour force],
  [the value of exports],
  [the number of households]
)

#mcq(28, [Which of the following is excluded from GDP?],
  [a pension paid to a retired teacher],
  [a tractor sold to a farm],
  [a haircut paid for at a salon],
  [a new house built by a construction firm]
)

#mcq(29, [When money is used to compare the values of different goods, it is functioning as a],
  [store of value],
  [unit of account],
  [medium of exchange],
  [standard of deferred payment]
)

