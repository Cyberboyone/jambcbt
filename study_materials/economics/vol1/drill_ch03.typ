#mcq(9, [Equilibrium in a market occurs where],
  [the price is fixed by government],
  [quantity demanded equals quantity supplied],
  [supply is at its maximum],
  [demand equals supply in price terms]
)

#mcq(10, [If the market price is above the equilibrium price, there will be],
