#mcq(11, [If the market price is below the equilibrium price, there will be],
  [a shortage, and the price will fall],
  [equilibrium],
  [a surplus, and the price will fall],
  [a shortage, and the price will rise]
)

#mcq(12, [At ₦5, quantity demanded is 80 and quantity supplied is 40. The market is experiencing],
  [a shortage of 40],
