== 4.7 Chapter 4 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [International trade differs from internal trade mainly because],
  [exchange rates never change],
  [foreign goods are not taxed],
  [goods are always cheaper abroad],
  [factors of production are less mobile between countries]
)

#mcq(2, [A country has an absolute advantage in a good when it can],
  [produce more of it with the same resources],
  [produce it without any imports],
  [produce it at a lower opportunity cost],
  [sell it more cheaply abroad]
)

#mcq(3, [A country has a comparative advantage in a good when its],
  [exports of the good exceed its imports],
  [opportunity cost of producing the good is lower than its trading partner's],
  [government subsidises the industry],
  [output per worker is higher than any other country's]
)

#mcq(4, [Nigeria needs 2 hours to produce a bag of rice and Ghana needs 3; Nigeria needs 4 hours to produce a bale of cloth and Ghana needs 3. Nigeria has a comparative advantage in],
  [neither good],
  [cloth],
  [rice],
  [both goods]
)

#mcq(5, [Using the figures above, the opportunity cost of one bale of cloth in Ghana is],
  [1 bag of rice],
  [3 bags of rice],
  [half a bag of rice],
  [2 bags of rice]
)

#mcq(6, [Two countries can both gain from trade even if one is absolutely more efficient in every good, because],
  [trade always raises prices],
  [each has a comparative advantage in something],
  [the less efficient country has lower wages],
  [governments subsidise exports]
)

#mcq(7, [The main gain from specialisation and trade is that],
  [each country produces everything it needs],
  [prices always fall],
  [employment always rises everywhere],
  [world output rises as each country uses its resources where they are relatively most productive]
)

#mcq(8, [Which of the following is an argument for protection?],
  [the gains from comparative advantage],
  [economies of scale in world markets],
  [protection of infant industries],
  [the wider choice available to consumers]
)

#mcq(9, [An infant industry argument is weakest when],
  [the country is large],
  [the industry is genuinely new],
  [the industry never becomes competitive and protection becomes permanent],
  [the industry exports]
)

#mcq(10, [A tariff is],
  [a tax on imported goods],
  [a subsidy to domestic producers],
  [a ban on trade with a country],
  [a limit on the quantity of imports]
)

#mcq(11, [A quota differs from a tariff in that a quota],
  [limits the quantity imported directly and yields no revenue],
  [lowers the domestic price],
  [applies only to exports],
  [raises revenue for the government]
)

#mcq(12, [The main effect of a tariff on an imported good is to],
  [lower its domestic price and raise the quantity imported],
  [raise the quantity imported without changing price],
  [raise its domestic price and reduce the quantity imported],
  [leave both price and quantity unchanged]
)

#mcq(13, [A complete ban on trade with a particular country is called],
  [a tariff],
  [an embargo],
  [a quota],
  [a subsidy]
)

#mcq(14, [Dumping occurs when a foreign firm],
  [sells abroad below the cost of production],
  [refuses to export],
  [is subsidised by its own government],
  [charges the same price at home and abroad]
)

#mcq(15, [Protection is likely to raise the price consumers pay because],
  [the tariff or quota reduces the supply of the cheaper import],
  [tariffs are paid by consumers directly to government],
  [consumers prefer domestic goods],
  [domestic producers are always less efficient than foreign ones]
)

#mcq(16, [Devaluation means],
  [a deliberate reduction in the value of a currency against other currencies],
  [an increase in the value of a currency],
  [the abolition of exchange controls],
  [a market-driven fall in a currency's value]
)

#mcq(17, [Devaluation of the naira is intended to],
  [reduce the volume of exports],
  [make Nigerian exports cheaper abroad and imports dearer at home],
  [make exports dearer and imports cheaper],
  [raise the external value of the naira]
)

#mcq(18, [The trade balance improves after a devaluation only if],
  [imports are banned],
  [the country exports oil],
  [the sum of export and import demand elasticities exceeds one],
  [the government fixes the exchange rate]
)

#mcq(19, [The J-curve describes the tendency of the trade balance to],
  [improve immediately after devaluation],
  [improve before devaluation],
  [worsen first and improve later after devaluation],
  [stay unchanged after devaluation]
)

#mcq(20, [The balance of trade is the difference between],
  [total exports and total imports including services],
  [government revenue and expenditure],
  [visible exports and visible imports],
  [the current and capital accounts]
)

#mcq(21, [An invisible item in the balance of payments is],
  [shipping and insurance services],
  [imported machinery],
  [cocoa exports],
  [crude oil exports]
)

#mcq(22, [The current account of the balance of payments includes],
  [changes in the external reserves],
  [portfolio investment],
  [direct investment],
  [remittances from citizens abroad]
)

#mcq(23, [The balance of payments always balances because],
  [exports always equal imports],
  [the exchange rate is fixed],
  [a current-account deficit is matched by a capital-account surplus],
  [governments balance their budgets]
)

#mcq(24, [A country with a current-account deficit of ₦9 billion and capital inflows of ₦12 billion has],
  [a trade surplus of ₦3 billion],
  [an overall balance of payments deficit of ₦21 billion],
  [a balanced payments position],
  [an overall surplus of ₦3 billion]
)

#mcq(25, [Which of the following would improve a country's current account?],
  [an increase in imports of consumer goods],
  [a rise in the value of its currency],
  [a rise in domestic inflation],
  [an increase in exports of services]
)

#mcq(26, [A persistent balance of payments deficit is a problem because it],
  [reduces the money supply automatically],
  [raises the exchange rate],
  [must be financed by borrowing, selling assets or running down reserves],
  [increases exports]
)

#mcq(27, [ECOWAS is best described as],
  [a West African regional economic community],
  [a common market in Europe],
  [a trade agreement between Africa and Asia],
  [a United Nations agency]
)

#mcq(28, [The main benefit of a customs union to its members is],
  [free trade among members and a common external tariff],
  [the abolition of all taxation],
  [a single central bank],
  [a common currency]
)

#mcq(29, [Nigeria's membership of OPEC gives it],
  [a voice in coordinating oil production and prices],
  [control over the world oil price],
  [a guaranteed share of world oil exports],
  [exemption from import duties]
)

#mcq(30, [Terms of trade are measured as],
  [the ratio of exports to imports by volume],
  [the ratio of export prices to import prices],
  [the growth rate of exports],
  [the difference between exports and imports]
)

#mcq(31, [A deterioration in a country's terms of trade means it],
  [has devalued its currency],
  [must export more to pay for the same imports],
  [has a trade surplus],
  [can buy more imports for the same exports]
)

#mcq(32, [Which is a visible export of Nigeria?],
  [tourism],
  [banking services],
  [insurance],
  [crude petroleum]
)

#mcq(33, [An exchange rate is the],
  [price of one currency in terms of another],
  [rate of inflation in traded goods],
  [interest rate set by the central bank],
  [ratio of exports to imports]
)

#mcq(34, [Appreciation of a currency is likely to],
  [increase the volume of exports],
  [make imports cheaper at home and worsen the trade balance],
  [make exports cheaper abroad],
  [raise the price of imports]
)

#mcq(35, [Which of these is a non-tariff barrier to trade?],
  [import duty],
  [an excise duty],
  [an import quota],
  [a value added tax on imports]
)

#mcq(36, [The theory of comparative advantage assumes, among other things, that],
  [governments intervene to protect industry],
  [transport costs are zero and factors are immobile between countries],
  [exchange rates are fixed],
  [every country produces every good]
)

#mcq(37, [A country's external reserves are held mainly to],
  [pay civil servants' salaries],
  [fund the federal budget],
  [finance state governments],
  [pay for imports and defend the exchange rate]
)

#mcq(38, [Which of the following is a capital-account inflow?],
  [shipping charges earned abroad],
  [proceeds from cocoa exports],
  [a foreign firm building a factory in the country],
  [remittances from citizens abroad]
)

#mcq(39, [A country that devalues and simultaneously has high inflation will find that],
  [imports become permanently cheaper],
  [the trade balance improves without limit],
  [exports become permanently cheaper],
  [the competitive gain from devaluation is eroded]
)

#mcq(40, [Trade liberalisation means],
  [the nationalisation of exporting firms],
  [the imposition of higher tariffs],
  [the fixing of exchange rates],
  [the removal of barriers to trade]
)

