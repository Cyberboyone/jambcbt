== 5.5 Chapter 5 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Economic growth is best defined as],
  [an improvement in welfare],
  [an increase in real national output],
  [an increase in the population],
  [a rise in the general price level]
)

#mcq(2, [Economic development differs from economic growth because development],
  [applies only to developed countries],
  [includes health, education and distribution as well as output],
  [is always faster than growth],
  [is measured in money while growth is not]
)

#mcq(3, [A country whose real GDP rises while life expectancy falls and inequality widens is experiencing],
  [both growth and development],
  [neither],
  [growth without development],
  [development without growth]
)

#mcq(4, [The three components of the human development index are],
  [income per capita, life expectancy and schooling],
  [income per capita, population and employment],
  [literacy, fertility and urbanisation],
  [inflation, unemployment and growth]
)

#mcq(5, [A country with a high income per capita but a low HDI most likely has],
  [a trade surplus],
  [a fixed exchange rate],
  [poor health and education outcomes],
  [a large population]
)

#mcq(6, [Per capita income is obtained by dividing national income by the],
  [population],
  [number of employed persons],
  [labour force],
  [number of households]
)

#mcq(7, [The dependency ratio is calculated as],
  [dependants ÷ working-age population × 100],
  [unemployed ÷ labour force × 100],
  [labour force ÷ population × 100],
  [working-age population ÷ dependants × 100]
)

#mcq(8, [A country has 30 million people under 15, 60 million aged 15 to 64 and 10 million over 64. Its dependency ratio is],
  [67 per cent],
  [25 per cent],
  [50 per cent],
  [150 per cent]
)

#mcq(9, [A high dependency ratio implies that],
  [the labour force is shrinking],
  [the population is falling],
  [unemployment must be high],
  [a large share of the population must be supported by each worker]
)

#mcq(10, [A population pyramid with a very broad base indicates],
  [a stable population],
  [a young and rapidly growing population],
  [an ageing population],
  [a declining population]
)

#mcq(11, [The labour force consists of],
  [the employed only],
  [all persons over fifteen],
  [all persons of working age],
  [the employed plus those actively seeking work]
)

#mcq(12, [The labour-force participation rate is],
  [labour force ÷ total population × 100],
  [employed ÷ labour force × 100],
  [unemployed ÷ labour force × 100],
  [labour force ÷ working-age population × 100]
)

#mcq(13, [An economy has 36 million employed, 4 million unemployed and actively seeking work. The unemployment rate is],
  [11.1 per cent],
  [10 per cent],
  [4.4 per cent],
  [4 per cent]
)

#mcq(14, [A person who is between jobs and looking for work is],
  [structurally unemployed],
  [cyclically unemployed],
  [seasonally unemployed],
  [frictionally unemployed]
)

#mcq(15, [Unemployment caused by a permanent change in the structure of the economy is],
  [structural],
  [cyclical],
  [seasonal],
  [frictional]
)

#mcq(16, [Unemployment caused by a general fall in demand during a recession is],
  [seasonal],
  [structural],
  [frictional],
  [cyclical]
)

#mcq(17, [A farmer who has no work between harvests is],
  [cyclically unemployed],
  [frictionally unemployed],
  [seasonally unemployed],
  [structurally unemployed]
)

#mcq(18, [The appropriate cure for structural unemployment is],
  [retraining and redeployment],
  [waiting for the business cycle to turn],
  [seasonal work planning],
  [increased aggregate demand]
)

#mcq(19, [The appropriate cure for cyclical unemployment is],
  [retraining programmes],
  [expansionary fiscal or monetary policy],
  [reducing the retirement age],
  [seasonal employment schemes]
)

#mcq(20, [Underemployment is best described as],
  [working for low wages],
  [being out of work and seeking it],
  [working without a contract],
  [working fewer hours or below one's skill level than one would like]
)

#mcq(21, [A country's unemployment rate can fall while its labour market deteriorates because],
  [the exchange rate is fixed],
  [the population is growing],
  [wages are rising],
  [discouraged workers leave the labour force]
)

#mcq(22, [The demographic transition describes a change from],
  [high birth and death rates to low birth and death rates],
  [low birth and death rates to high ones],
  [rural to urban living],
  [agriculture to manufacturing]
)

#mcq(23, [Population growth faster than output growth will],
  [raise wages],
  [raise per capita income],
  [lower per capita income],
  [leave per capita income unchanged]
)

#mcq(24, [A country's population is growing at 3 per cent a year and its real GDP at 2 per cent. Per capita income is],
  [falling by about 1 per cent],
  [unchanged],
  [falling by 5 per cent],
  [rising by 5 per cent]
)

#mcq(25, [Which measure best captures inequality of income?],
  [the dependency ratio],
  [the human development index],
  [the consumer price index],
  [the Gini coefficient]
)

#mcq(26, [Absolute poverty is defined by reference to],
  [the level of unemployment],
  [inequality between rich and poor],
  [the average income of the country],
  [a fixed minimum standard of living]
)

#mcq(27, [Investment in education is regarded as investment in],
  [financial capital],
  [human capital],
  [natural capital],
  [physical capital]
)

#mcq(28, [The main reason a developing economy has a large informal sector is that],
  [governments encourage it],
  [taxes are too low],
  [the formal sector cannot absorb the labour force],
  [informal work pays better]
)

#mcq(29, [Rural-urban migration in developing economies is driven mainly by],
  [higher expected wages and better services in the cities],
  [lower rents in the cities],
  [cheaper food in the cities],
  [government relocation schemes]
)

#mcq(30, [An economy with a large youth population must above all provide],
  [schools now and jobs when the cohort arrives],
  [pensions for the elderly],
  [a fixed exchange rate],
  [imports of consumer goods]
)

#mcq(31, [Which is a non-economic indicator of development?],
  [balance of payments],
  [literacy rate],
  [per capita income],
  [gross domestic product]
)

#mcq(32, [Development planning in a mixed economy typically aims to],
  [fix all prices permanently],
  [coordinate public investment and guide private activity],
  [replace the market entirely],
  [abolish taxation]
)

#mcq(33, [The 'population trap' refers to a situation in which],
  [birth rates are below replacement],
  [population growth absorbs all the gains from growth],
  [the labour force is too small],
  [population falls too fast]
)

#mcq(34, [Which of the following is a characteristic of a developing economy?],
  [complete mechanisation of farming],
  [low population growth],
  [a small informal sector],
  [a high proportion of the labour force in agriculture]
)

#mcq(35, [Full employment in the economic sense means],
  [there is no cyclical unemployment, though frictional and structural unemployment remain],
  [the unemployment rate is zero],
  [everyone works for the government],
  [every adult has a job]
)

#mcq(36, [Which of these is NOT a cause of unemployment in a developing economy?],
  [falling aggregate demand],
  [a mismatch between skills and jobs],
  [rapid population growth],
  [a high level of capital per worker]
)

#mcq(37, [Investing in labour-intensive industries in a country with surplus labour is intended to],
  [create employment alongside output],
  [raise output per worker quickly],
  [reduce the wage rate],
  [increase imports]
)

#mcq(38, [The Human Development Index is expressed as a number between],
  [1 and 10],
  [0 and 1],
  [−1 and 1],
  [0 and 100]
)

#mcq(39, [A rise in a country's HDI with no change in GDP per capita could be caused by],
  [a trade surplus],
  [a rise in the price level],
  [improvements in health and schooling],
  [a fall in unemployment]
)

#mcq(40, [Which statement about unemployment and inflation is correct?],
  [the two are unrelated],
  [unemployment causes deflation always],
  [a short-run trade-off exists but can shift],
  [the two always move in opposite directions]
)

