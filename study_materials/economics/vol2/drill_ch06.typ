== 6.5 Chapter 6 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [The body responsible for monetary policy in Nigeria is the],
  [National Bureau of Statistics],
  [Federal Ministry of Finance],
  [Securities and Exchange Commission],
  [Central Bank of Nigeria]
)

#mcq(2, [Nigeria's GDP and inflation statistics are published by the],
  [Nigeria Deposit Insurance Corporation],
  [National Bureau of Statistics],
  [Central Bank of Nigeria],
  [Federal Inland Revenue Service]
)

#mcq(3, [Federal taxes such as company income tax and VAT are assessed and collected by the],
  [Securities and Exchange Commission],
  [Fiscal Responsibility Commission],
  [Central Bank of Nigeria],
  [Federal Inland Revenue Service]
)

#mcq(4, [The institution that insures depositors' funds in Nigerian banks is the],
  [Securities and Exchange Commission],
  [Nigeria Deposit Insurance Corporation],
  [Federal Inland Revenue Service],
  [Central Bank of Nigeria]
)

#mcq(5, [The Securities and Exchange Commission is responsible for],
  [regulating the capital market],
  [publishing inflation statistics],
  [collecting customs duty],
  [issuing currency]
)

#mcq(6, [Fiscal policy in Nigeria is principally the responsibility of the],
  [Central Bank of Nigeria],
  [National Bureau of Statistics],
  [Federal Ministry of Finance],
  [Nigeria Deposit Insurance Corporation]
)

#mcq(7, [The policy rate set by the Central Bank of Nigeria is known as the],
  [cash reserve ratio],
  [exchange rate],
  [monetary policy rate],
  [liquidity ratio]
)

#mcq(8, [The largest source of Nigeria's foreign exchange earnings is],
  [manufacturing],
  [agriculture],
  [crude petroleum],
  [tourism]
)

#mcq(9, [The sector that employs the largest proportion of Nigeria's labour force is],
  [agriculture],
  [crude petroleum],
  [telecommunications],
  [manufacturing]
)

#mcq(10, [Nigeria's economy is best described as],
  [a mixed economy],
  [a command economy],
  [a subsistence economy],
  [a pure market economy]
)

#mcq(11, [The principle of revenue allocation that returns a share of revenue to the area of origin is],
  [land mass],
  [derivation],
  [population],
  [equality]
)

#mcq(12, [Revenue shared among the three tiers of government in Nigeria is paid into the],
  [Federation Account],
  [External Reserves Account],
  [Petroleum Trust Fund],
  [Consolidated Revenue Fund]
)

#mcq(13, [The three tiers of government in Nigeria are],
  [public, private and informal],
  [executive, legislature and judiciary],
  [primary, secondary and tertiary],
  [federal, state and local]
)

#mcq(14, [A country that depends on a single export commodity is vulnerable because],
  [its currency cannot be devalued],
  [it cannot produce anything else],
  [its earnings move with a price it does not control],
  [it has no need to import]
)

#mcq(15, [The consumer price index measures],
  [the value of the currency abroad],
  [the change in the general price level],
  [the level of employment],
  [the level of output]
)

#mcq(16, [An inflation rate of 12 per cent means that],
  [the naira has appreciated by 12 per cent],
  [output has grown by 12 per cent],
  [unemployment has fallen by 12 per cent],
  [prices are 12 per cent higher than a year earlier]
)

#mcq(17, [External reserves are held mainly to],
  [finance state governments],
  [fund the federal budget],
  [pay for imports and defend the exchange rate],
  [pay civil servants' salaries]
)

#mcq(18, [A rise in the monetary policy rate is intended to],
  [reduce borrowing and restrain inflation],
  [lower the exchange rate automatically],
  [encourage borrowing and investment],
  [increase government spending]
)

#mcq(19, [The informal sector is difficult to measure because],
  [it is illegal],
  [it is entirely agricultural],
  [much of its activity is unrecorded and paid in cash],
  [it produces no output]
)

#mcq(20, [Nigeria's external debt differs from domestic debt because external debt],
  [is denominated in foreign currency],
  [is always cheaper],
  [is owed to citizens],
  [need never be repaid]
)

#mcq(21, [Nigeria's manufacturing sector remains small mainly because of],
  [high energy costs and dependence on imported inputs],
  [the absence of any industrial policy],
  [a shortage of consumers],
  [excessive mechanisation of agriculture]
)

#mcq(22, [The body that monitors the federal budget and enforces fiscal rules in Nigeria is the],
  [National Bureau of Statistics],
  [Central Bank of Nigeria],
  [Fiscal Responsibility Commission],
  [Securities and Exchange Commission]
)

#mcq(23, [Structural adjustment programmes typically required developing countries to],
  [raise tariffs on all imports],
  [devalue, privatise and liberalise],
  [expand the public sector],
  [increase subsidies and tariffs]
)

#mcq(24, [The main problem with a large informal sector for public finance is that it],
  [lowers the exchange rate],
  [reduces the tax base],
  [reduces the population],
  [increases government revenue]
)

#mcq(25, [Which of the following is a source of federal government revenue in Nigeria?],
  [local rates],
  [market tolls],
  [school fees],
  [company income tax]
)

#mcq(26, [Nigeria is a member of],
  [the European Union],
  [ASEAN],
  [NAFTA],
  [OPEC]
)

#mcq(27, [The naira exchange rate is best described as the],
  [interest rate on naira deposits],
  [ratio of exports to imports],
  [price of the naira in another currency],
  [inflation rate of the naira]
)

#mcq(28, [A devaluation of the naira would be expected to],
  [make exports cheaper abroad and imports dearer at home],
  [make imports cheaper],
  [raise the external value of the naira],
  [reduce the volume of exports]
)

#mcq(29, [Which statement about Nigeria's oil sector is correct?],
  [it employs most of the labour force],
  [it is entirely owned by foreign firms],
  [it earns most of the foreign exchange but employs few people directly],
  [it contributes nothing to government revenue]
)

#mcq(30, [The human development index for Nigeria is held back mainly by],
  [a small population],
  [health and schooling outcomes as well as income],
  [high oil prices],
  [low income alone]
)

#mcq(31, [Which of these is a fiscal policy instrument?],
  [company income tax],
  [the monetary policy rate],
  [open market operations],
  [the cash reserve ratio]
)

#mcq(32, [Budget deficit financing by borrowing from the central bank is inflationary because it],
  [increases the money supply],
  [raises taxes],
  [reduces government spending],
  [reduces the debt]
)

#mcq(33, [The main aim of Nigeria's diversification policy is to],
  [abolish the tax system],
  [reduce dependence on oil for revenue and foreign exchange],
  [reduce agricultural output],
  [increase oil production]
)

#mcq(34, [A country's balance of payments records],
  [the government budget],
  [only trade in goods],
  [the money supply],
  [all transactions with the rest of the world]
)

#mcq(35, [The external reserves of Nigeria are managed by the],
  [Nigerian Stock Exchange],
  [Central Bank of Nigeria],
  [Securities and Exchange Commission],
  [Federal Ministry of Finance]
)

#mcq(36, [Which of these would most directly reduce Nigeria's import bill?],
  [an increase in the population],
  [a rise in the exchange rate],
  [an increase in government spending],
  [increased domestic refining capacity]
)

#mcq(37, [Nigeria's fiscal federalism means that],
  [local governments set income tax rates],
  [taxing powers and spending responsibilities are divided among the tiers of government],
  [only the federal government may spend],
  [each state collects all the taxes raised within it]
)

#mcq(38, [A statistical agency's figures on unemployment are likely to understate the problem because],
  [they include the whole population],
  [they measure wages rather than jobs],
  [they exclude discouraged workers and the underemployed],
  [they count discouraged workers as unemployed]
)

#mcq(39, [Which is the correct pairing of institution and function?],
  [CBN — publishing the consumer price index],
  [NBS — monetary policy],
  [SEC — issuing currency],
  [FIRS — collecting company income tax]
)

#mcq(40, [An economy described as a price taker in world markets],
  [must accept the price determined by world supply and demand],
  [can set the price of its exports],
  [has no exports],
  [does not trade at all]
)

