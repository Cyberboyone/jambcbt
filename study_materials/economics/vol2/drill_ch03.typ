== 3.7 Chapter 3 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A public budget is best described as a statement of],
  [expected revenue and planned expenditure],
  [the money supply and its growth],
  [the balance of payments],
  [the level of unemployment]
)

#mcq(2, [A budget surplus occurs when],
  [the government borrows money],
  [revenue exceeds expenditure],
  [expenditure exceeds revenue],
  [revenue equals expenditure]
)

#mcq(3, [A budget deficit exists when],
  [the country has a trade surplus],
  [government expenditure exceeds revenue],
  [the budget is balanced],
  [government revenue exceeds expenditure]
)

#mcq(4, [Deficit financing that is most inflationary is borrowing from],
  [foreign governments],
  [the World Bank],
  [the central bank],
  [the public through treasury bills]
)

#mcq(5, [Recurrent expenditure differs from capital expenditure in that recurrent expenditure],
  [is confined to the states],
  [creates new assets],
  [is always borrowed],
  [is spent on running costs such as salaries and fuel]
)

#mcq(6, [Fiscal policy is the use of],
  [wage guidelines to control incomes],
  [exchange controls to manage imports],
  [interest rates to control the money supply],
  [government spending and taxation to influence the economy]
)

#mcq(7, [Expansionary fiscal policy is most appropriate when the economy faces],
  [rapid growth],
  [high inflation],
  [a balance of payments surplus],
  [unemployment and recession]
)

#mcq(8, [Contractionary fiscal policy would involve],
  [lowering the cash reserve ratio],
  [raising taxes and cutting government spending],
  [cutting taxes and raising spending],
  [buying securities in the open market]
)

#mcq(9, [An automatic stabiliser is],
  [a tariff imposed in a recession],
  [a central bank instrument],
  [a feature of the budget that stabilises demand without a new decision],
  [a deliberate change in tax rates]
)

#mcq(10, [A direct tax is one that],
  [is levied on goods and services],
  [can always be shifted forward],
  [is collected only at the border],
  [is paid by the person on whom the burden finally falls]
)

#mcq(11, [Which of the following is a direct tax?],
  [excise duty],
  [personal income tax],
  [value added tax],
  [import duty]
)

#mcq(12, [Which of the following is an indirect tax?],
  [petroleum profit tax],
  [capital gains tax],
  [value added tax],
  [company income tax]
)

#mcq(13, [A tax that takes a larger proportion of income from the rich than from the poor is],
  [neutral],
  [proportional],
  [progressive],
  [regressive]
)

#mcq(14, [A tax that takes the same proportion of income at every level is],
  [progressive],
  [digressive],
  [regressive],
  [proportional]
)

#mcq(15, [A tax that takes ₦10,000 from an income of ₦50,000 and ₦10,000 from an income of ₦200,000 is],
  [prohibitive],
  [progressive],
  [regressive],
  [proportional]
)

#mcq(16, [VAT is regarded as regressive in effect because],
  [it is levied only on luxury goods],
  [it is collected by the seller],
  [it takes a larger share of a poor household's spending],
  [it varies with the taxpayer's income]
)

#mcq(17, [The principle that a tax should be based on ability to pay is],
  [certainty],
  [equity],
  [economy],
  [convenience]
)

#mcq(18, [Pay-as-you-earn taxation illustrates the principle of],
  [economy],
  [convenience],
  [certainty],
  [equity]
)

#mcq(19, [The Laffer curve suggests that beyond a certain point, raising the tax rate],
  [raises revenue proportionally],
  [reduces the price level],
  [reduces total revenue],
  [has no effect on revenue]
)

#mcq(20, [Tax incidence refers to],
  [the rate at which a tax is levied],
  [who finally bears the economic burden of a tax],
  [the cost of collecting a tax],
  [the legal obligation to pay a tax]
)

#mcq(21, [The burden of a tax falls most heavily on the side of the market that is],
  [larger in number],
  [less elastic],
  [better informed],
  [more elastic]
)

#mcq(22, [If demand is perfectly inelastic, a tax on the good is borne],
  [entirely by consumers],
  [entirely by producers],
  [by the government],
  [equally by both]
)

#mcq(23, [If supply is perfectly inelastic, a tax on the good is borne],
  [entirely by producers],
  [entirely by consumers],
  [by importers],
  [equally by both]
)

#mcq(24, [The public debt is best described as],
  [the deficit of the current year],
  [the country's external reserves],
  [the accumulated total of past deficits],
  [the money owed to the central bank only]
)

#mcq(25, [Debt service refers to],
  [the interest and principal paid in a year],
  [the total size of the debt],
  [the rescheduling of a loan],
  [the borrowing undertaken in a year]
)

#mcq(26, [External debt differs from domestic debt in that external debt],
  [is denominated in foreign currency],
  [never has to be repaid],
  [is owed to citizens],
  [is always cheaper]
)

#mcq(27, [Crowding out occurs when government borrowing],
  [lowers the exchange rate],
  [increases private investment],
  [raises the interest rate and reduces private investment],
  [reduces the interest rate]
)

#mcq(28, [Which of the following is a source of government revenue?],
  [unemployment],
  [inflation],
  [imports],
  [company income tax]
)

#mcq(29, [A government wishing to reduce a budget deficit should],
  [print more money],
  [borrow more from abroad],
  [raise taxes or cut spending],
  [cut taxes and raise spending]
)

#mcq(30, [The main purpose of taxation is to],
  [reduce imports],
  [redistribute income only],
  [raise revenue for government expenditure],
  [control inflation directly]
)

#mcq(31, [A tax on a commodity whose demand is elastic will],
  [have no effect on quantity],
  [be borne entirely by producers without any change in quantity],
  [raise a large revenue],
  [raise little revenue and reduce the quantity sold sharply]
)

#mcq(32, [Progressive taxation is defended mainly on the ground that it],
  [reduces inequality by taking a larger share from higher incomes],
  [encourages work],
  [raises more revenue than any other system],
  [is easy to collect]
)

#mcq(33, [Which is a capital receipt of government?],
  [customs duty],
  [proceeds from the sale of government shares in a company],
  [company income tax],
  [value added tax]
)

#mcq(34, [Public finance is concerned with],
  [the revenue and expenditure of government],
  [household budgeting],
  [the finances of private firms],
  [the profits of commercial banks]
)

#mcq(35, [A tariff is best classified as],
  [an indirect tax on imports],
  [a subsidy to exporters],
  [a form of government spending],
  [a direct tax on income]
)

#mcq(36, [When a government raises a tax on producers in a market where demand is elastic, the main effect is],
  [a fall in price],
  [a large rise in price with little change in quantity],
  [a small rise in price with a large fall in quantity],
  [no change in either]
)

#mcq(37, [The fiscal year in Nigeria runs from],
  [April to March],
  [July to June],
  [October to September],
  [January to December]
)

#mcq(38, [Which combination describes a country in the strongest fiscal position?],
  [balanced budget, rising borrowing],
  [deficit financed by the central bank],
  [large deficit, large debt service],
  [budget surplus, falling debt as a share of GDP]
)

#mcq(39, [Tax evasion differs from tax avoidance in that evasion],
  [is illegal],
  [applies only to companies],
  [is legal],
  [is a form of avoidance]
)

#mcq(40, [Public goods are those which],
  [are consumed only by the poor],
  [are non-excludable and non-rival, so the market under-provides them],
  [are produced by public corporations],
  [are provided free of charge by the state]
)

