== 1.7 Chapter 1 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [National income is best defined as the],
  [sum of all wages paid in a year],
  [total value of a country's exports],
  [money value of all goods and services produced in a country in a year],
  [total money held by a country's citizens]
)

#mcq(2, [Gross domestic product measures output produced],
  [by government-owned enterprises only],
  [inside a country's borders, whoever owns the firm],
  [in the manufacturing sector only],
  [by a country's citizens anywhere in the world]
)

#mcq(3, [Gross national product equals gross domestic product plus],
  [subsidies],
  [indirect taxes],
  [depreciation],
  [net factor income from abroad]
)

#mcq(4, [A country whose citizens earn substantial income abroad while foreign firms repatriate large profits will usually have],
  [GDP greater than GNP],
  [GNP equal to national income at market prices],
  [GNP greater than GDP],
  [GDP equal to GNP]
)

#mcq(5, [National income at factor cost differs from GNP at market prices by],
  [the addition of net exports],
  [the subtraction of indirect taxes and the addition of subsidies],
  [the addition of depreciation],
  [the subtraction of transfer payments]
)

#mcq(6, [The three methods of measuring national income are],
  [production, distribution and exchange],
  [taxation, borrowing and spending],
  [output, income and expenditure],
  [saving, investment and consumption]
)

#mcq(7, [The expenditure method of measuring national income adds],
  [C + I + G + (X − M)],
  [C + S + T],
  [C + I + G + (X + M)],
  [C + I + G]
)

#mcq(8, [The income method adds the rewards to the four factors of production, which are],
  [wages, rent, interest and profit],
  [rent, rates and royalties],
  [profit, dividends and capital gains],
  [wages, salaries and bonuses]
)

#mcq(9, [Which of the following is NOT included in the measurement of national income?],
  [the value of a new machine installed in a factory],
  [a pension paid to a retired civil servant],
  [a doctor's fee paid by a patient],
  [payment for a newly built house]
)

#mcq(10, [The sale of a second-hand car is excluded from national income because],
  [cars are not counted as output],
  [the car was counted when it was first produced],
  [second-hand goods are always imported],
  [the transaction is not taxed]
)

#mcq(11, [Double counting in national income accounting is avoided by using],
  [nominal rather than real values],
  [market prices rather than factor cost],
  [gross output rather than net output],
  [value added rather than gross output]
)

#mcq(12, [A baker buys flour for ₦40,000 and sells bread for ₦100,000. The value added is],
  [₦140,000],
  [₦40,000],
  [₦60,000],
  [₦100,000]
)

#mcq(13, [In the circular flow of income, households supply],
  [factor services to firms in return for incomes],
  [taxes to foreign governments],
  [goods and services to firms],
  [capital to commercial banks only]
)

#mcq(14, [Which of the following is an injection into the circular flow?],
  [saving],
  [taxation],
  [imports],
  [government spending]
)

#mcq(15, [Which of the following is a withdrawal from the circular flow of income?],
  [exports],
  [government expenditure],
  [imports],
  [investment]
)

#mcq(16, [Equilibrium in the circular flow requires that],
  [S + T = X + M],
  [S + T + M = I + G + X],
  [C + I = G + X],
  [S + I = T + G]
)

#mcq(17, [If injections exceed withdrawals, national income will],
  [fall],
  [become zero],
  [rise],
  [remain constant]
)

#mcq(18, [Real national income is national income measured at],
  [constant prices],
  [the prices of the base year, deflated by population],
  [factor cost only],
  [current market prices]
)

#mcq(19, [If nominal GDP is ₦200 billion and the price index is 125, real GDP is],
  [₦175 billion],
  [₦250 billion],
  [₦200 billion],
  [₦160 billion]
)

#mcq(20, [A country's nominal GDP rises by 20 per cent while the price index rises from 100 to 120. Real GDP],
  [falls by 20 per cent],
  [is unchanged],
  [rises by 40 per cent],
  [rises by 20 per cent]
)

#mcq(21, [The GDP deflator is calculated as],
  [nominal GDP ÷ real GDP × 100],
  [nominal GDP − real GDP],
  [nominal GDP × real GDP ÷ 100],
  [real GDP ÷ nominal GDP × 100]
)

#mcq(22, [Per capita income is obtained by dividing national income by],
  [the population],
  [the labour force],
  [the number of households],
  [the number of employed persons]
)

#mcq(23, [A country has a national income of ₦36 trillion and a population of 180 million. Its per capita income is],
  [₦20,000],
  [₦2,000,000],
  [₦2,000],
  [₦200,000]
)

#mcq(24, [Per capita income is a poor measure of welfare because it],
  [excludes the service sector],
  [cannot be compared between countries],
  [is measured in money rather than goods],
  [is an average that ignores the distribution of income]
)

#mcq(25, [When nominal income and the price level both double, real income],
  [falls by a quarter],
  [doubles],
  [is unchanged],
  [halves]
)

#mcq(26, [The multiplier is defined as],
  [the ratio of saving to income],
  [the ratio of consumption to income],
  [the change in investment divided by the change in consumption],
  [the ratio of a change in income to the change in an injection]
)

#mcq(27, [If the marginal propensity to consume is 0.75, the value of the multiplier is],
  [4],
  [7.5],
  [0.75],
  [1.33]
)

#mcq(28, [The multiplier is larger when the marginal propensity to],
  [tax is larger],
  [save is larger],
  [import is larger],
  [consume is larger]
)

#mcq(29, [If the marginal propensity to consume is 0.8 and investment rises by ₦5 billion, national income rises by],
  [₦25 billion],
  [₦6.25 billion],
  [₦5 billion],
  [₦4 billion]
)

#mcq(30, [The multiplier effect occurs because],
  [the government prints more money],
  [spending by one person becomes income for another, who spends part of it],
  [prices fall as output rises],
  [saving is converted into investment automatically]
)

#mcq(31, [With taxes, imports and saving all present, the multiplier is],
  [unaffected by any of the three],
  [exactly equal to 1],
  [smaller than in a closed economy without taxes],
  [larger than in a closed economy without taxes]
)

#mcq(32, [A transfer payment such as a scholarship is excluded from national income because],
  [it is paid by government],
  [it is too small to count],
  [no good or service is produced in exchange for it],
  [it is received by students]
)

#mcq(33, [Which of the following would cause GDP to understate the true level of economic activity?],
  [ignoring unpaid household work],
  [counting value added rather than gross output],
  [including government services in the total],
  [deflating nominal GDP by the price index]
)

#mcq(34, [Gross domestic product at market prices includes],
  [neither indirect taxes nor subsidies],
  [indirect taxes and subsidies],
  [only direct taxes],
  [only subsidies]
)

#mcq(35, [The stage at which a country's income per head stops being a good guide to welfare is when],
  [the exchange rate is fixed],
  [the country has a trade surplus],
  [income is very unequally distributed],
  [the population is large]
)

#mcq(36, [In the circular flow, the government sector withdraws through taxation and injects through],
  [saving],
  [exports],
  [government spending],
  [investment by firms]
)

#mcq(37, [An economy has consumption of ₦400bn, investment of ₦120bn, government spending of ₦150bn, exports of ₦90bn and imports of ₦110bn. Its GDP is],
  [₦650bn],
  [₦870bn],
  [₦850bn],
  [₦760bn]
)

#mcq(38, [Which pair is correctly matched?],
  [GDP — output at factor cost; GNP — output at market prices],
  [GDP — output by residents anywhere; GNP — output inside the border],
  [GDP — output inside the border; GNP — output by residents anywhere],
  [GDP — real output; GNP — nominal output]
)

#mcq(39, [National income figures for developing economies are usually understated because],
  [a large informal sector escapes measurement],
  [their populations are too small],
  [their currencies are overvalued],
  [they do not export enough]
)

#mcq(40, [Real national income grows by 8 per cent while the population grows by 3 per cent. Real income per head rises by approximately],
  [11 per cent],
  [8 per cent],
  [5 per cent],
  [2.7 per cent]
)

