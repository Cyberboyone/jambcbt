== 2.7 Chapter 2 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A business owned and controlled by one person is a],
  [sole proprietorship],
  [cooperative],
  [partnership],
  [private company]
)

#mcq(2, [The liability of a sole trader is],
  [limited to his capital],
  [unlimited],
  [nil],
  [limited to the value of stock]
)

#mcq(3, [One advantage of the sole proprietorship is that],
  [the owner keeps all the profit],
  [it has perpetual succession],
  [capital is unlimited],
  [liability is limited]
)

#mcq(4, [One disadvantage of the sole proprietorship is that],
  [profits are shared],
  [it must publish accounts],
  [the business lacks continuity],
  [decisions are slow]
)

#mcq(5, [The maximum number of partners in an ordinary partnership is],
  [unlimited],
  [fifty],
  [twenty],
  [ten]
)

#mcq(6, [A partnership is formed by],
  [a memorandum],
  [a statute],
  [a deed],
  [a prospectus]
)

#mcq(7, [In the absence of a deed, partnership profits are shared],
  [equally],
  [in the capital ratio],
  [according to seniority],
  [according to hours worked]
)

#mcq(8, [A partner who contributes capital but takes no part in management is a],
  [quasi partner],
  [sleeping partner],
  [nominal partner],
  [general partner]
)

#mcq(9, [A limited partner's liability is limited to],
  [the capital he contributed],
  [nothing at all],
  [twice his capital],
  [the firm's debts]
)

#mcq(10, [A nominal partner contributes],
  [capital only],
  [his name and reputation],
  [labour only],
  [nothing at all]
)

#mcq(11, [A person who behaves as a partner without being one is a],
  [nominal partner],
  [limited partner],
  [sleeping partner],
  [quasi partner]
)

#mcq(12, [Joint and several liability means],
  [a creditor may sue any one partner for the whole debt],
  [partners are not liable],
  [the firm pays and partners never do],
  [each partner pays an equal share only]
)

#mcq(13, [A cooperative society is owned by],
  [the government],
  [a single proprietor],
  [shareholders],
  [its members]
)

#mcq(14, [Cooperative surplus is shared according to],
  [patronage],
  [seniority],
  [the number of shares held],
  [capital contributed]
)

#mcq(15, [The principle of one member one vote is called],
  [service before profit],
  [democratic control],
  [open membership],
  [distribution by patronage]
)

#mcq(16, [A consumer cooperative exists mainly to],
  [lend to members],
  [make a profit for shareholders],
  [market members' crops],
  [buy in bulk and sell to members at a fair price]
)

#mcq(17, [A producer cooperative mainly],
  [sells to the final consumer],
  [collects, grades and sells members' produce],
  [lends money to members],
  [insures members' crops]
)

#mcq(18, [A thrift and credit society exists to],
  [transport goods],
  [sell goods],
  [insure property],
  [pool savings and lend to members]
)

#mcq(19, [Which is a feature of the cooperative but not of the company?],
  [one member one vote],
  [a separate legal person],
  [a registered name],
  [limited liability]
)

#mcq(20, [The aim of a cooperative is best described as],
  [service to members],
  [growth of share price],
  [maximum profit],
  [export promotion]
)

#mcq(21, [Unlimited liability means that],
  [the owner loses only the capital invested],
  [the business cannot borrow],
  [personal property may be used to settle business debts],
  [the owner is not liable at all]
)

#mcq(22, [A sole trader who wants to raise more capital is most likely to],
  [issue debentures],
  [take a partner],
  [issue shares],
  [form a cooperative]
)

#mcq(23, [The document that sets out how a partnership will be run is the],
  [memorandum],
  [certificate],
  [partnership deed],
  [articles of association]
)

#mcq(24, [Which is NOT usually found in a partnership deed?],
  [interest on capital],
  [profit-sharing ratio],
  [the partnership's tax rate],
  [procedure on retirement]
)

#mcq(25, [A partnership ends on the death of a partner unless],
  [the deed provides otherwise],
  [the bank agrees],
  [the survivors agree],
  [the court orders]
)

#mcq(26, [The liability of a member of a cooperative is],
  [nil],
  [limited to twice his shares],
  [limited to his share capital],
  [unlimited]
)

#mcq(27, [A cooperative must register with],
  [the appropriate cooperative authority],
  [the Corporate Affairs Commission as a company],
  [the Central Bank],
  [the stock exchange]
)

#mcq(28, [Which statement about a sole trader is true?],
  [He must publish accounts],
  [The business and the trader are the same person in law],
  [The business and the trader are separate in law],
  [He has limited liability]
)

#mcq(29, [A partnership with one limited partner must have],
  [no deed],
  [at least one general partner],
  [a prospectus],
  [a certificate of incorporation]
)

#mcq(30, [Which is an advantage of a partnership over a sole proprietorship?],
  [simpler accounts],
  [unlimited liability],
  [wider access to capital and skills],
  [perpetual succession]
)

#mcq(31, [A disadvantage of a partnership is that],
  [it cannot employ staff],
  [decisions require consultation, which can delay action],
  [it cannot own property],
  [profits are shared equally always]
)

#mcq(32, [The capital of a partnership comes from],
  [a prospectus],
  [the sale of shares],
  [the partners' contributions],
  [the stock exchange]
)

#mcq(33, [A cooperative that sells to non-members usually],
  [loses its registration],
  [may do so, but members get the benefit],
  [must pay a fine],
  [must stop trading]
)

#mcq(34, [Which of these businesses has perpetual succession?],
  [cooperative society],
  [none of them],
  [sole proprietorship],
  [partnership]
)

#mcq(35, [The main reason partnerships are common among professionals is],
  [limited liability],
  [access to the stock exchange],
  [shared risk and combined expertise],
  [tax exemption]
)

#mcq(36, [A partner who lends the firm his reputation without capital is a],
  [quasi partner],
  [sleeping partner],
  [limited partner],
  [nominal partner]
)

#mcq(37, [A sole trader's business is best described as],
  [a statutory body],
  [an extension of the owner],
  [a separate legal person],
  [a public corporation]
)

#mcq(38, [The three words that compare business units are],
  [capital, tax, staff],
  [owner, liability, control],
  [size, age, profit],
  [trade, industry, commerce]
)

#mcq(39, [A cooperative differs from a partnership mainly in that a cooperative],
  [has no capital],
  [cannot trade],
  [is controlled democratically by its members],
  [has unlimited liability]
)

#mcq(40, [Which is the correct order of risk to the owner, from least to most?],
  [sole trader, limited partner, cooperative member],
  [limited partner, sole trader, cooperative member],
  [sole trader, cooperative member, limited partner],
  [cooperative member, limited partner, sole trader]
)

