== 5.7 Chapter 5 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Foreign trade is trade between],
  [a wholesaler and a retailer],
  [a firm and its branch],
  [regions of one country],
  [two or more countries]
)

#mcq(2, [The balance of trade is the difference between],
  [total exports and total imports],
  [invisible exports and invisible imports],
  [visible exports and visible imports],
  [receipts and payments on capital account]
)

#mcq(3, [The balance of payments includes],
  [only services],
  [goods and services],
  [only goods],
  [only capital transfers]
)

#mcq(4, [Visible exports are],
  [goods sold abroad],
  [services sold abroad],
  [gifts received],
  [loans received]
)

#mcq(5, [Shipping and insurance earnings from foreigners are],
  [invisible exports],
  [visible exports],
  [visible imports],
  [capital imports]
)

#mcq(6, [If visible exports are ₦800m and visible imports ₦950m, the balance of trade is],
  [in balance],
  [a deficit of ₦150m],
  [a surplus of ₦150m],
  [a surplus of ₦1,750m]
)

#mcq(7, [Adding invisible earnings of ₦220m to that position gives a current account],
  [deficit of ₦370m],
  [surplus of ₦70m],
  [surplus of ₦150m],
  [deficit of ₦70m]
)

#mcq(8, [The balance of payments is said to balance because],
  [governments fix the exchange rate],
  [exports always equal imports],
  [every deficit is financed by a matching capital or reserve entry],
  [invisibles are ignored]
)

#mcq(9, [Terms of trade are measured as],
  [import prices ÷ export prices × 100],
  [visible exports ÷ visible imports × 100],
  [exports ÷ imports × 100],
  [export prices ÷ import prices × 100]
)

#mcq(10, [If the export price index is 120 and the import price index is 150, the terms of trade are],
  [120],
  [270],
  [150],
  [80]
)

#mcq(11, [A fall in the terms of trade means],
  [no change in welfare],
  [imports have become cheaper],
  [exports have become cheaper relative to imports],
  [trade is balanced]
)

#mcq(12, [A tariff is],
  [a ban on imports],
  [a subsidy to exporters],
  [a tax on imports],
  [a physical limit on imports]
)

#mcq(13, [A quota is],
  [an export subsidy],
  [a limit on the quantity imported],
  [a tax on imports],
  [a ban]
)

#mcq(14, [An embargo is],
  [a tax],
  [a licence],
  [a quota],
  [a total ban on trade in a good]
)

#mcq(15, [Import licensing requires the importer to],
  [insure the goods],
  [pay a tax],
  [advertise the goods],
  [obtain government permission]
)

#mcq(16, [Exchange control restricts],
  [warehousing],
  [access to foreign currency],
  [advertising],
  [the movement of goods]
)

#mcq(17, [A subsidy to a domestic producer],
  [lowers his costs and helps him compete],
  [bans imports],
  [taxes imports],
  [raises his costs]
)

#mcq(18, [Which is a non-tariff barrier?],
  [import quota],
  [export tax],
  [customs duty],
  [excise duty]
)

#mcq(19, [An indent is],
  [an order from an importer to an exporter],
  [a bank loan],
  [a receipt],
  [an invoice]
)

#mcq(20, [A proforma invoice is sent],
  [after the goods arrive],
  [after payment],
  [before the goods are supplied, to show the price],
  [by the bank only]
)

#mcq(21, [A bill of lading is],
  [only a contract],
  [a receipt, a contract and a document of title],
  [only a receipt],
  [a tax document]
)

#mcq(22, [Which document proves where the goods were made?],
  [certificate of origin],
  [indent],
  [commercial invoice],
  [bill of lading]
)

#mcq(23, [A bill of exchange is],
  [an insurance policy],
  [an order to pay a sum on a stated date],
  [a licence],
  [a receipt for goods]
)

#mcq(24, [A letter of credit is issued by],
  [the importer's bank],
  [the shipping line],
  [the importer],
  [the customs service]
)

#mcq(25, [The consular invoice is verified by],
  [the exporter's bank],
  [the importing country's consul],
  [the shipping company],
  [the insurer]
)

#mcq(26, [Entrepot trade means],
  [barter],
  [importing for home consumption],
  [importing goods and re-exporting them],
  [exporting local goods]
)

#mcq(27, [Which is an invisible import?],
  [imported rice],
  [imported machinery],
  [imported cars],
  [insurance paid to a foreign insurer]
)

#mcq(28, [A deficit in the balance of trade may be financed by],
  [raising tariffs immediately],
  [printing money],
  [borrowing abroad or drawing on reserves],
  [lowering the exchange rate by law]
)

#mcq(29, [Devaluation of the currency makes],
  [both cheaper],
  [both dearer],
  [exports dearer and imports cheaper],
  [exports cheaper and imports dearer]
)

#mcq(30, [A country whose terms of trade improve],
  [has balanced trade],
  [needs to export more for the same imports],
  [obtains more imports for the same exports],
  [has a trade deficit]
)

#mcq(31, [Which document is prepared by the seller and shows the amount due, with discounts?],
  [commercial invoice],
  [indent],
  [bill of lading],
  [certificate of origin]
)

#mcq(32, [The shipping company issues],
  [the letter of credit],
  [the consular invoice],
  [the bill of lading],
  [the indent]
)

#mcq(33, [A bill of lading made out to bearer is],
  [a tax document],
  [void],
  [negotiable],
  [not negotiable]
)

#mcq(34, [Which is a reason for restricting foreign trade?],
  [to protect infant industries],
  [to raise the exchange rate],
  [to reduce employment],
  [to increase imports]
)

#mcq(35, [Which is a disadvantage of protection?],
  [greater self-sufficiency],
  [higher domestic employment],
  [higher prices and less choice for consumers],
  [more tax revenue]
)

#mcq(36, [Bilateral trade is trade],
  [in two commodities],
  [within a region of many countries],
  [between two countries],
  [by two firms]
)

#mcq(37, [Multilateral trade is carried on],
  [only in services],
  [among many countries without special preference],
  [between two countries],
  [only by government]
)

#mcq(38, [A surplus on the current account means],
  [exports are less than imports],
  [the country is a net lender abroad on current transactions],
  [the country is bankrupt],
  [the currency must fall]
)

#mcq(39, [Which pair is correctly matched?],
  [tariff: tax on imports],
  [embargo: limit on quantity],
  [quota: tax on imports],
  [licence: total ban]
)

#mcq(40, [The current account of the balance of payments includes],
  [only visible goods],
  [goods, services and unilateral transfers],
  [only long-term capital],
  [only reserves]
)

