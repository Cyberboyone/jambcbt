== 8.8 Chapter 8 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Government intervenes in business through],
  [partnership and cooperation],
  [regulation, taxation, provision and protection],
  [transport and warehousing],
  [advertising and insurance]
)

#mcq(2, [Regulation of business is intended to],
  [reduce competition],
  [increase imports],
  [protect consumers and maintain standards],
  [maximise profit]
)

#mcq(3, [Which body registers companies in Nigeria?],
  [CAC],
  [FCCPC],
  [NAFDAC],
  [SON]
)

#mcq(4, [Which body sets standards for manufactured goods in Nigeria?],
  [SON],
  [CAC],
  [NIPC],
  [CBN]
)

#mcq(5, [NAFDAC regulates],
  [insurance],
  [food, drugs and related products],
  [banks],
  [companies]
)

#mcq(6, [The FCCPC protects],
  [consumers from unfair business practices],
  [companies from consumers],
  [banks from borrowers],
  [importers from exporters]
)

#mcq(7, [The CBN's main business role is],
  [registering companies],
  [regulating banks and the currency],
  [standardising goods],
  [licensing imports]
)

#mcq(8, [The NIPC is concerned with],
  [consumer complaints],
  [food and drugs],
  [promoting investment],
  [company registration]
)

#mcq(9, [A progressive tax takes],
  [nothing from companies],
  [a larger proportion from lower incomes],
  [the same proportion from all],
  [a larger proportion from higher incomes]
)

#mcq(10, [A regressive tax takes],
  [a fixed sum from everyone],
  [a larger proportion from lower incomes than from higher],
  [a larger proportion from higher incomes],
  [only from companies]
)

#mcq(11, [A proportional tax takes],
  [more from the poor],
  [more from the rich],
  [nothing from the poor],
  [the same proportion from every income]
)

#mcq(12, [A tax on company profits is],
  [a levy on goods],
  [indirect],
  [direct],
  [regressive by definition]
)

#mcq(13, [VAT is],
  [a tariff],
  [an indirect tax on spending],
  [a progressive income tax],
  [a direct tax]
)

#mcq(14, [Personal income tax in Nigeria is],
  [progressive],
  [indirect],
  [regressive],
  [proportional]
)

#mcq(15, [Which is a canon of a good tax?],
  [it should discourage work],
  [it should be certain and convenient to pay],
  [it should be expensive to collect],
  [it should be retroactive]
)

#mcq(16, [A tax whose collection cost exceeds its yield is],
  [progressive],
  [direct],
  [uneconomical],
  [economical]
)

#mcq(17, [Public enterprises are established mainly to],
  [reduce taxation],
  [compete with foreign firms],
  [maximise profit],
  [provide essential services and correct market failure]
)

#mcq(18, [Commercialisation of a public enterprise means],
  [selling it to private owners],
  [making it operate on commercial principles while state-owned],
  [closing it],
  [subsidising it]
)

#mcq(19, [Privatisation means],
  [partial commercialisation],
  [nationalisation],
  [regulation],
  [transfer of ownership to private investors]
)

#mcq(20, [A reason for privatisation is],
  [to raise taxes],
  [to increase subsidy],
  [to improve efficiency and reduce state burden],
  [to remove competition]
)

#mcq(21, [Which is a disadvantage of privatisation?],
  [possible loss of service to poor or remote areas],
  [lower prices],
  [higher efficiency],
  [more investment]
)

#mcq(22, [Consumer sovereignty means],
  [government decides what is produced],
  [producers fix prices],
  [consumers have no rights],
  [the consumer is king in the market]
)

#mcq(23, [Which is a consumer right?],
  [the right to avoid tax],
  [the right to safety and to be informed],
  [the right to set prices],
  [the right to a free product]
)

#mcq(24, [The right to redress means the consumer may],
  [choose any product],
  [seek compensation for loss or injury],
  [demand free goods],
  [ignore contracts]
)

#mcq(25, [Consumer protection is necessary because],
  [producers lose money otherwise],
  [consumers cannot test every claim and may be misled],
  [government needs revenue],
  [markets are always fair]
)

#mcq(26, [Which is an unfair business practice?],
  [clear labelling],
  [honouring warranties],
  [false or misleading advertisement],
  [issuing receipts]
)

#mcq(27, [The Consumer Protection Council in Nigeria is now part of the],
  [CAC],
  [FCCPC],
  [SON],
  [CBN]
)

#mcq(28, [Business ethics deals with],
  [maximising sales],
  [accounting rules only],
  [advertising design],
  [the standards of right and wrong in business conduct]
)

#mcq(29, [Corporate social responsibility is],
  [a legal obligation to pay tax],
  [an advertising budget],
  [a voluntary commitment to stakeholders beyond shareholders],
  [a dividend policy]
)

#mcq(30, [CSR differs from philanthropy in that CSR],
  [is built into how the business operates],
  [is a one-off gift],
  [is required by law],
  [has no cost]
)

#mcq(31, [Which is an example of CSR?],
  [paying tax],
  [laying off staff],
  [building a borehole and funding a school in the host community],
  [raising prices]
)

#mcq(32, [A business that dumps waste in a river is failing],
  [its tax duty],
  [its environmental responsibility],
  [its dividend policy],
  [its advertising duty]
)

#mcq(33, [Which is a benefit of ethical behaviour to a firm?],
  [lower prices],
  [exemption from tax],
  [reputation and customer loyalty],
  [higher short-term cost only]
)

#mcq(34, [A code of conduct in a firm],
  [regulates competitors],
  [replaces the law],
  [states the standards expected of staff],
  [sets prices]
)

#mcq(35, [Which consumer right covers the availability of basic goods?],
  [right to redress],
  [right to be informed],
  [right to safety],
  [right to satisfaction of basic needs]
)

#mcq(36, [Which is a form of government protection of local industry?],
  [import quota],
  [company registration],
  [consumer education],
  [bank supervision]
)

#mcq(37, [Regulation differs from taxation in that regulation],
  [is always voluntary],
  [raises revenue],
  [applies only to companies],
  [sets standards of conduct rather than raising money]
)

#mcq(38, [A business that pays below the minimum wage is failing],
  [its tax duty],
  [consumer rights],
  [a legal obligation to its workers],
  [its CSR only]
)

#mcq(39, [Which best describes the relationship between law and ethics?],
  [ethics sets a higher standard than law],
  [neither applies to business],
  [law is stricter than ethics in all cases],
  [they are identical]
)

#mcq(40, [Consumer education helps the buyer to],
  [make informed choices and know his rights],
  [pay more],
  [fix prices],
  [avoid all risk]
)

