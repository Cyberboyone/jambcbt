  [twenty],
  [twelve],
  [ten],
  [fifteen]
)

#mcq(10, [A citizen of one ECOWAS state may travel to another without a visa because of the protocol on],
  [taxation],
  [defence],
  [common currency],
  [free movement of persons]
)

#mcq(11, [The African Union replaced the],
  [OAU],
  [Commonwealth],
  [ECOWAS],
  [UNCTAD]
)

#mcq(12, [AfCFTA is],
  [a currency union],
  [a free-trade area for African goods and services],
  [a development bank],
  [a commodity cartel]
)

#mcq(13, [OPEC's principal instrument is],
  [balance-of-payments support],
  [long-term lending],
  [tariff reduction],
  [production quotas agreed by members]
)

#mcq(14, [OPEC was formed in],
  [1975],
  [1995],
  [1960],
  [1944]
)

#mcq(15, [Nigeria joined OPEC in],
  [1975],
  [1960],
  [1971],
  [1986]
)

#mcq(16, [Balance-of-payments support for a member in crisis is the work of the],
  [World Bank],
  [WTO],
  [ILO],
  [IMF]
)

#mcq(17, [A soft loan for a rural road in a member state would come from the],
  [WTO],
  [OPEC],
  [IMF],
  [World Bank]
)

#mcq(18, [The European Union differs from ECOWAS mainly because the EU],
  [has a single market and, for many members, a single currency],
  [has no common tariff],
  [is a military alliance],
  [does not trade]
)

#mcq(19, [A common external tariff means],
  [the same tariff on imports from outside the group],
  [free movement of people],
  [no tariffs at all],
  [a single currency]
)

