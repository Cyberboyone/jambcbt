  [the borrower joining the WTO],
  [the borrower abolishing its central bank],
  [the borrower adopting a foreign currency],
  [the borrower adopting agreed economic policies]
)

#mcq(22, [Which organisation would a country approach for technical advice on its tax system?],
  [the IMF],
  [OPEC],
  [the ILO],
  [a commodity cartel]
)

