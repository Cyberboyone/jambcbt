  [AfCFTA],
  [the EU],
  [ECOWAS],
  [the AU]
)

#mcq(25, [A continental body of African states is],
  [the WTO],
  [the African Union],
  [ECOWAS],
  [OPEC]
)

#mcq(26, [Which organisation does NOT lend money?],
  [IMF],
  [World Bank],
  [WTO],
  [African Development Bank]
)

#mcq(27, [The main benefit of a free-trade area to a member is],
  [a stronger currency],
  [higher tariffs],
  [cheaper imports only],
  [a larger market for its producers]
)

#mcq(28, [The main cost of a free-trade area to a member is],
  [loss of population],
  [higher transport costs],
  [loss of tariff revenue and pressure on weak industries],
  [loss of sovereignty over language]
)

