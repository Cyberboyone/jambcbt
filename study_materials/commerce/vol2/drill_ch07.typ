  [is collected at the port],
  [raises revenue],
  [is a tax],
  [limits the quantity imported]
)

#mcq(31, [Which body would fund a balance-of-payments deficit that is expected to last two years?],
  [the World Bank],
  [the IMF],
  [the WTO],
  [UNCTAD]
)

#mcq(32, [Which is a Nigerian membership of long standing?],
  [OPEC],
  [AfCFTA only],
  [the Commonwealth only],
  [the EU]
)

#mcq(33, [The chief aim of ECOWAS is],
  [control of oil prices],
  [political union of all Africa],
  [economic integration of West Africa],
  [settlement of global trade disputes]
)

#mcq(34, [A country that wants its exports to enter a neighbour's market duty-free within West Africa relies on],
  [the WTO],
  [OPEC],
  [the IMF],
  [ECOWAS protocols]
)

#mcq(35, [The IMF's role in an exchange-rate crisis is to],
  [set the rate itself],
  [provide foreign currency and advice],
  [close the borders],
  [raise tariffs]
)

#mcq(36, [Which organisation is concerned with the terms on which developing countries trade?],
  [the WTO only],
  [OPEC],
  [the ILO],
  [UNCTAD]
)

#mcq(37, [A commodity agreement tries to stabilise],
  [the exchange rate],
  [the price of a primary product],
  [the money supply],
  [the tariff]
)

#mcq(38, [Which statement about AfCFTA is correct?],
  [it creates a single market for African goods and services],
  [it creates a single African currency],
  [it replaces the African Union],
  [it is a lending institution]
)

#mcq(39, [Which is an advantage of belonging to a large trading bloc?],
  [higher prices at home],
  [smaller markets],
  [economies of scale and a stronger bargaining position],
  [fewer exports]
)

#mcq(40, [The organisation that supervises the international monetary system and watches members' policies is the],
  [WTO],
  [World Bank],
  [IMF],
  [ILO]
)

