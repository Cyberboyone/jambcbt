  [waves eroding a headland],
  [wind blowing sand inland],
  [longshore drift carrying sediment across a bay]
)

#mcq(24, [A bar differs from a spit because a bar],
  [is made of glacial till],
  [joins two headlands],
  [lies below low tide],
  [projects into a bay and ends free]
)

#mcq(25, [A tombolo joins],
  [two dunes],
  [two rivers],
  [two cirques],
  [the mainland to an island]
)

