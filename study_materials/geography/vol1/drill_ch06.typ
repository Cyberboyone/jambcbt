  [glaciers],
  [waves],
  [wind],
  [rivers]
)

#mcq(39, [The Sahel is best described as],
  [a semi-arid belt south of the Sahara],
  [a tropical rainforest belt],
  [a mountain range],
  [a coastal plain]
)

#mcq(40, [Desertification is the],
  [spread of desert-like conditions into dry lands],
  [expansion of fertile land],
  [raising of the water table],
  [growth of forests]
