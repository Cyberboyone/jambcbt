  [is the largest lake in Africa],
  [is salty],
  [has no outlet to the sea]
)

#mcq(33, [Lake Kainji was formed by],
  [a meander cut-off],
  [a volcanic eruption],
  [the damming of the Niger],
  [glacial action]
)

#mcq(34, [A rock that stores and transmits groundwater is called an],
  [estuary],
  [aquifer],
  [aquiclude],
  [aqueduct]
)

#mcq(35, [The top of the saturated zone in the ground is the],
  [spring line],
  [water table],
  [waterfall],
  [watershed]
)

