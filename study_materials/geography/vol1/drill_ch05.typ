)

#mcq(24, [A river that ends in a deep, drowned valley forms an],
  [alluvial fan],
  [ox-bow],
  [delta],
  [estuary]
)

#mcq(25, [Dendritic drainage develops on],
  [uniform rock such as crystalline basement],
  [a volcano],
  [a crater],
  [alternating bands of hard and soft rock]
)

#mcq(26, [Trellised drainage is typical of],
  [folded rocks of alternating resistance],
  [a flat desert],
  [a glacial valley],
  [a dome]
)

#mcq(27, [Radial drainage occurs on],
  [a flood plain],
  [a coastal plain],
  [a dome or volcano],
  [a lake basin]
)

#mcq(28, [Centripetal drainage occurs where streams flow],
  [in a straight line],
  [parallel to the coast],
  [outward from a dome],
  [inward to a basin]
)

