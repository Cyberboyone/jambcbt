== 5.9 Chapter 5 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [The cheapest mode of transport for bulky goods over long distances is],
  [rail],
  [air],
  [road],
  [water]
)

#mcq(2, [The fastest mode of transport for perishable goods is],
  [road],
  [air],
  [rail],
  [water]
)

#mcq(3, [The mode that offers door-to-door delivery is],
  [pipeline],
  [rail],
  [road],
  [water]
)

#mcq(4, [A pipeline is used to move],
  [liquids and gases],
  [livestock],
  [passengers],
  [containers]
)

#mcq(5, [Which is a disadvantage of rail transport?],
  [it is slow for bulk],
  [it is the dearest per tonne],
  [it cannot carry heavy goods],
  [it follows a fixed route]
)

#mcq(6, [The balance of trade is],
  [the value of the currency],
  [visible exports minus visible imports],
  [imports minus exports],
  [all exports minus all imports]
)

#mcq(7, [A country exports goods worth ₦6 billion and imports goods worth ₦4 billion. Its balance of trade is],
  [a surplus of ₦2 billion],
  [a deficit of ₦2 billion],
  [a deficit of ₦10 billion],
  [a surplus of ₦10 billion]
)

#mcq(8, [Invisible trade refers to],
  [services such as shipping, insurance and tourism],
  [goods in transit],
  [smuggled goods],
  [goods that cannot be seen]
)

#mcq(9, [The balance of payments includes],
  [visible trade, invisible trade and capital flows],
  [the budget deficit],
  [invisible trade only],
  [visible trade only]
)

#mcq(10, [The terms of trade are calculated as],
  [exports + imports],
  [import price index ÷ export price index × 100],
  [exports − imports],
  [export price index ÷ import price index × 100]
)

#mcq(11, [If the terms of trade fall below 100, the country],
  [has a trade surplus],
  [must export more to buy the same imports],
  [is exporting too cheaply],
  [has no trade at all]
)

#mcq(12, [A tariff is],
  [a tax on imported goods],
  [a ban on trade],
  [a subsidy to exporters],
  [a limit on the quantity imported]
)

#mcq(13, [A quota is],
  [a total ban],
  [a physical limit on the quantity imported],
  [a subsidy],
  [a tax on imports]
)

#mcq(14, [An embargo is],
  [a tax on imports],
  [a free-trade agreement],
  [a limit on quantity],
  [a total ban on trade with a country]
)

#mcq(15, [Which is a reason for protecting domestic industry?],
  [to allow infant industries to grow],
  [to encourage smuggling],
  [to reduce employment],
  [to raise the price of imports]
)

#mcq(16, [Tourism is classified as],
  [invisible trade],
  [home trade],
  [entrepot trade],
  [visible trade]
)

#mcq(17, [Leakage in tourism refers to],
  [money that leaves the host country],
  [the cost of the flight],
  [the number of visitors],
  [the length of the season]
)

#mcq(18, [A Nigerian tourist attraction that is cultural rather than natural is],
  [Cross River National Park],
  [Yankari],
  [the Osun-Osogbo festival],
  [Obudu]
)

#mcq(19, [A natural tourist attraction in Nigeria is],
  [the Nok terracotta site],
  [Yankari National Park],
  [the Osun grove],
  [the Argungu festival]
)

#mcq(20, [Nigeria's main export is],
  [groundnut],
  [cocoa],
  [textiles],
  [crude petroleum]
)

#mcq(21, [Which is a Nigerian seaport?],
  [Onne],
  [Jos],
  [Kano],
  [Abuja]
)

#mcq(22, [The Lagos–Kano railway was built mainly to],
  [serve the oil fields],
  [link two capitals],
  [move export crops and imports between the port and the interior],
  [carry tourists]
)

#mcq(23, [Inland water transport in Nigeria is most developed on the],
  [Niger and Benue],
  [Cross and Imo],
  [Ogun and Osun],
  [Sokoto and Kaduna]
)

#mcq(24, [The main problem of the Lagos port is],
  [a shortage of cargo],
  [the absence of customs],
  [shallow water],
  [congestion and poor access roads]
)

#mcq(25, [Entrepot trade is],
  [bartering goods],
  [importing goods and re-exporting them],
  [smuggling goods],
  [selling goods at home]
)

#mcq(26, [A favourable balance of payments means],
  [receipts exceed payments],
  [there is no trade],
  [exports equal imports],
  [payments exceed receipts]
)

#mcq(27, [Which service belongs to invisible exports?],
  [cocoa sold abroad],
  [machinery imported],
  [rice imported],
  [freight earned by a national shipping line]
)

#mcq(28, [Subsidies to domestic producers are intended to],
  [raise import prices],
  [ban imports],
  [lower their costs and make them competitive],
  [limit exports]
)

#mcq(29, [Which factor least affects the choice of transport mode?],
  [the cost per tonne-kilometre],
  [the distance],
  [the colour of the packaging],
  [the perishability of the goods]
)

#mcq(30, [Road transport dominates Nigerian freight because],
  [it needs no fuel],
  [it is flexible and reaches most places],
  [it is the cheapest per tonne],
  [it is the fastest]
)

#mcq(31, [The main environmental cost of road transport is],
  [noise only],
  [water pollution],
  [soil salinisation],
  [air pollution and carbon emissions]
)

#mcq(32, [A tourist multiplier effect means that],
  [tourism ends in the dry season],
  [hotels are foreign-owned],
  [visitor spending creates further income in the local economy],
  [visitors pay a tax]
)

#mcq(33, [Which is a problem of tourism in Nigeria?],
  [excessive road quality],
  [too many hotels],
  [poor infrastructure and insecurity in some sites],
  [too many visitors]
)

#mcq(34, [Which mode is best for emergency medical supplies?],
  [pipeline],
  [water],
  [air],
  [rail]
)

#mcq(35, [Nigeria's trade with other countries is recorded by the],
  [customs service and the central bank],
  [ministry of education],
  [police],
  [state governments only]
)

#mcq(36, [Which is an invisible import?],
  [rice imported],
  [insurance premiums paid to a foreign company],
  [textiles imported],
  [cars imported]
)

#mcq(37, [Trade between two states of Nigeria is],
  [foreign trade],
  [home trade],
  [entrepot trade],
  [invisible trade]
)

#mcq(38, [A country with a persistent trade deficit may],
  [reduce exports],
  [increase imports],
  [restrict imports or devalue its currency],
  [print more goods]
)

#mcq(39, [Which is a gain from tourism?],
  [a fall in the exchange rate],
  [foreign exchange and employment],
  [an increase in imports],
  [the loss of local culture]
)

#mcq(40, [The greatest Nigerian advantage in tourism is its],
  [ski slopes],
  [desert dunes],
  [cultural festivals and wildlife parks],
  [cold climate]
)

