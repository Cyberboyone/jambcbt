== 8.9 Chapter 8 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A natural hazard becomes a disaster when it],
  [reaches a high magnitude],
  [occurs at night],
  [is studied by scientists],
  [affects a vulnerable population]
)

#mcq(2, [Which is a natural hazard?],
  [a flood],
  [a bank failure],
  [a road accident],
  [a factory closure]
)

#mcq(3, [Desertification is best defined as],
  [the drying of a lake only],
  [the growth of a city],
  [the spread of desert-like conditions into productive land],
  [the movement of a sand dune]
)

#mcq(4, [The chief cause of desertification in northern Nigeria is],
  [earthquakes],
  [overgrazing and fuelwood collection],
  [acid rain],
  [volcanic eruptions]
)

#mcq(5, [The Great Green Wall is],
  [a sea wall],
  [a pipeline],
  [a system of dams],
  [a belt of trees and restored land across the Sahel]
)

#mcq(6, [Deforestation in Nigeria is driven chiefly by],
  [frost],
  [fuelwood, farm clearance and logging],
  [earthquakes],
  [volcanic ash]
)

#mcq(7, [The removal of the forest cover usually leads to],
  [cooler temperatures],
  [higher rainfall],
  [soil erosion and reduced infiltration],
  [deeper soils]
)

#mcq(8, [Sheet erosion removes],
  [rock outcrops],
  [deep gullies],
  [a thin layer of topsoil over a wide area],
  [only the subsoil]
)

#mcq(9, [Gully erosion is most severe in],
  [the steep, cleared farmland of the south-east],
  [the mangrove],
  [the flat Sahel],
  [the coastal sand]
)

#mcq(10, [Wind erosion is most severe in],
  [the coastal plain],
  [the delta],
  [the dry north],
  [the rainforest]
)

#mcq(11, [Terracing is used to],
  [reduce the speed of runoff on a slope],
  [increase the wind speed],
  [deepen gullies],
  [raise the water table]
)

#mcq(12, [Contour ploughing follows],
  [the contour lines of a slope],
  [the steepest line down the slope],
  [the river],
  [the boundary of the farm]
)

#mcq(13, [The best single measure against desertification is],
  [increasing the herd],
  [clearing the scrub],
  [protecting and planting trees],
  [burning the grass]
)

#mcq(14, [Air pollution in Nigerian cities comes chiefly from],
  [rivers],
  [vehicles, generators and gas flaring],
  [forests],
  [volcanoes]
)

#mcq(15, [Water pollution in the Niger Delta is caused chiefly by],
  [oil spills and industrial effluent],
  [wind],
  [earthquakes],
  [frost]
)

#mcq(16, [Open dumping of refuse is dangerous because],
  [it reduces rainfall],
  [it increases the wind],
  [leachate can contaminate groundwater],
  [it improves the soil]
)

#mcq(17, [E-waste is a problem because it],
  [improves the soil],
  [contains toxic metals that leach into soil and water],
  [reduces the temperature],
  [is biodegradable]
)

#mcq(18, [Conservation differs from preservation because conservation is],
  [the export of resources],
  [careful use with renewal],
  [complete non-use],
  [total destruction]
)

#mcq(19, [A national park is established chiefly to],
  [store water],
  [protect wildlife and its habitat],
  [house industries],
  [increase farmland]
)

#mcq(20, [Sustainable development is development that],
  [depends on aid],
  [stops all industry],
  [meets present needs without compromising future generations],
  [maximises growth now]
)

#mcq(21, [The three circles of sustainable development are],
  [farm, mine and factory],
  [town, village and region],
  [land, water and air],
  [environment, economy and society]
)

#mcq(22, [Climate change is expected to affect Nigeria chiefly through],
  [earthquakes],
  [frost and snow],
  [volcanic eruptions],
  [heat, erratic rain, floods and a shrinking Lake Chad]
)

#mcq(23, [The Kyoto Protocol and the Paris Agreement deal with],
  [peacekeeping],
  [world trade],
  [greenhouse gas emissions],
  [oil prices]
)

#mcq(24, [Nigeria's contribution to global greenhouse emissions is small, but its],
  [coastline is growing],
  [population is falling],
  [adaptation needs are large],
  [rainfall is falling to zero]
)

#mcq(25, [The Sustainable Development Goals replaced the],
  [Kyoto Protocol],
  [Millennium Development Goals],
  [Lagos Treaty],
  [Berlin Act]
)

#mcq(26, [SDG 13 deals with],
  [no poverty],
  [climate action],
  [clean water],
  [life on land]
)

#mcq(27, [A flood becomes a disaster in a city chiefly because],
  [the soil is old],
  [people built on the flood plain and the drains are blocked],
  [the rain is heavy],
  [the river is long]
)

#mcq(28, [Which measure reduces flood damage in a city?],
  [removing the trees],
  [building on the flood plain],
  [improving drainage and enforcing zoning],
  [blocking the drains]
)

#mcq(29, [Early warning systems reduce disaster losses by],
  [changing the soil],
  [stopping the hazard],
  [increasing the rainfall],
  [giving people time to move and protect property]
)

#mcq(30, [Coastal erosion in Lagos is caused chiefly by],
  [earthquakes],
  [volcanoes],
  [frost],
  [wave action and the removal of the beach's natural defences]
)

#mcq(31, [Afforestation means],
  [burning the bush],
  [cutting the forest],
  [draining a swamp],
  [planting trees where there was no forest]
)

#mcq(32, [Crop rotation helps the soil by],
  [removing all cover],
  [restoring nutrients and breaking pest cycles],
  [drying the soil],
  [increasing erosion]
)

#mcq(33, [Mulching is the practice of],
  [flooding the field],
  [ploughing down the slope],
  [burning the residue],
  [covering the soil with crop residue]
)

#mcq(34, [Which is a renewable source of energy?],
  [solar],
  [petroleum],
  [coal],
  [natural gas]
)

#mcq(35, [Gas flaring is wasteful because it],
  [increases rainfall],
  [burns a resource that could be sold or used for power],
  [cools the atmosphere],
  [improves the soil]
)

#mcq(36, [Which is an environmental effect of rapid population growth?],
  [the cooling of cities],
  [a fall in demand for food],
  [a rise in the water table],
  [pressure on land, water and forests]
)

#mcq(37, [The polluter-pays principle means that],
  [the firm that pollutes bears the cost of cleaning up],
  [the government pays for all pollution],
  [pollution is free],
  [the consumer pays nothing]
)

#mcq(38, [Environmental impact assessment is carried out],
  [after the project has failed],
  [only for farms],
  [only by foreign firms],
  [before a major project is approved]
)

#mcq(39, [Which Nigerian agency coordinates disaster response?],
  [NNPC],
  [WAEC],
  [NEMA],
  [CBN]
)

#mcq(40, [The best summary of Nigeria's environmental task is],
  [ignoring the climate],
  [exporting all resources],
  [growing the economy while restoring the land, water and forest it depends on],
  [stopping all development]
)

