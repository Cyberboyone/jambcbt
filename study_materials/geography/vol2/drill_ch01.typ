== 1.9 Chapter 1 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Population density is calculated as],
  [births minus deaths],
  [population multiplied by area],
  [area divided by population],
  [population divided by area]
)

#mcq(2, [The natural increase of a population is],
  [population minus area],
  [birth rate minus death rate],
  [birth rate plus death rate],
  [immigration minus emigration]
)

#mcq(3, [A country with a broad base and a narrow apex on its population pyramid has],
  [an ageing population],
  [a low birth rate and a low death rate],
  [a stationary population],
  [a high birth rate and a high death rate]
)

#mcq(4, [The dependency ratio compares],
  [urban with rural dwellers],
  [births with deaths],
  [males with females],
  [the young and the old with the working-age population]
)

#mcq(5, [The stage of the demographic transition with the fastest population growth is the one in which],
  [both rates are high],
  [both rates are low],
  [the death rate has fallen and the birth rate is still high],
  [the birth rate has fallen below the death rate]
)

#mcq(6, [Which of these is a push factor in migration?],
  [schools in the city],
  [hospitals in the city],
  [jobs in the city],
  [land shortage in the village]
)

#mcq(7, [The movement of people from villages to cities is called],
  [urban–rural migration],
  [international migration],
  [seasonal migration],
  [rural–urban migration]
)

#mcq(8, [Urbanisation is best defined as],
  [the movement of people to farms],
  [the growth of one large city],
  [the rise in the proportion of people living in towns],
  [the building of new roads]
)

#mcq(9, [A country with a population of 80 million and an area of 400 000 km² has a density of],
  [320 people per km²],
  [20 people per km²],
  [2 000 people per km²],
  [200 people per km²]
)

#mcq(10, [The doubling time of a population growing at 2 per cent a year is about],
  [20 years],
  [70 years],
  [35 years],
  [50 years]
)

#mcq(11, [Nigeria's population is best described as],
  [ageing, with a low dependency ratio],
  [shrinking, with a narrow base],
  [stationary, with equal age groups],
  [young, with a high dependency ratio]
)

#mcq(12, [The most densely populated part of Nigeria is],
  [the Sahel margin],
  [the middle-belt bush],
  [the south-west and the south-east],
  [the Chad basin]
)

#mcq(13, [Population distribution in Nigeria is chiefly explained by],
  [the age of the constitution],
  [relief, climate, water, soils and economic opportunity],
  [the length of the coastline],
  [the number of airports]
)

#mcq(14, [A sex ratio of 102 at birth means that],
  [slightly more girls than boys are born],
  [slightly more boys than girls are born],
  [the population is stationary],
  [equal numbers are born]
)

#mcq(15, [Which of the following is NOT a measure of population?],
  [the birth rate],
  [the density],
  [the balance of trade],
  [the death rate]
)

#mcq(16, [An expansive population pyramid is typical of],
  [an industrial country with low fertility],
  [a developing country with high fertility],
  [a country at war only],
  [a country with no migration]
)

#mcq(17, [The infant mortality rate measures],
  [deaths of mothers in childbirth],
  [deaths of children under one year per 1 000 live births],
  [the number of children per family],
  [the number of births per year]
)

#mcq(18, [A census is],
  [an estimate from satellite images],
  [a sample survey of households],
  [an official count of a population at a point in time],
  [a register of voters]
)

#mcq(19, [Nigeria's 2006 census recorded a population of about],
  [140 million],
  [55 million],
  [220 million],
  [90 million]
)

#mcq(20, [Rapid population growth puts the greatest pressure on],
  [housing, schools, water and jobs],
  [the height of the plateau],
  [the number of rivers],
  [the length of the coastline]
)

#mcq(21, [Malthus argued that population grows],
  [at the same rate as food],
  [arithmetically while food grows geometrically],
  [geometrically while food grows arithmetically],
  [only when food is plentiful]
)

#mcq(22, [Boserup argued that population pressure],
  [has no effect on farming],
  [ends in famine],
  [always reduces output],
  [forces agricultural intensification]
)

#mcq(23, [A country is over-populated when],
  [its people cannot be supported by its resources at a rising standard of living],
  [it has more than 100 million people],
  [its density exceeds 100 per km²],
  [it imports food]
)

#mcq(24, [The main reason for rural–urban migration in Nigeria is],
  [the search for farmland],
  [the desire to avoid electricity],
  [the search for employment and services],
  [the shortage of markets in cities]
)

#mcq(25, [Emigration is the movement of people],
  [into a country],
  [between two villages],
  [out of a country],
  [within a country]
)

#mcq(26, [Remittances are],
  [taxes paid to the host country],
  [the cost of the journey],
  [the wages paid in the village],
  [money sent home by migrants working abroad]
)

#mcq(27, [A refugee differs from an economic migrant because a refugee],
  [moves for a better salary],
  [moves only in the dry season],
  [moves within the same country],
  [has been forced to flee by conflict or persecution]
)

#mcq(28, [The population of the world is about],
  [12 billion],
  [3 billion],
  [8 billion],
  [500 million]
)

#mcq(29, [About 60 per cent of the world's people live in],
  [Asia],
  [Africa],
  [South America],
  [Europe]
)

#mcq(30, [Which of these is a consequence of a high dependency ratio?],
  [heavy spending on schools and health with few taxpayers],
  [a rise in the retirement age],
  [a falling demand for schools],
  [a surplus of workers]
)

#mcq(31, [Life expectancy at birth is],
  [the average number of years a newborn is expected to live],
  [the age at which people retire],
  [the death rate of adults],
  [the number of births per woman]
)

#mcq(32, [The total fertility rate measures],
  [the number of births per year],
  [the average number of children a woman would bear in her lifetime],
  [the death rate of infants],
  [the number of children per household now]
)

#mcq(33, [Nigeria's population growth rate is about],
  [2.4 per cent a year],
  [8 per cent a year],
  [12 per cent a year],
  [0.4 per cent a year]
)

#mcq(34, [Which of these is an effect of migration on the receiving area?],
  [a shortage of labour],
  [pressure on housing and services],
  [the closure of schools],
  [a fall in demand for goods]
)

#mcq(35, [A population pyramid with a pinched base indicates],
  [a falling birth rate],
  [a high death rate among the old],
  [a stationary population],
  [a rising birth rate]
)

#mcq(36, [The main source of population data in Nigeria is],
  [the electoral register alone],
  [the World Bank only],
  [the police],
  [the national census and the estimates of the National Population Commission]
)

#mcq(37, [The demographic transition model describes change in],
  [birth and death rates over time],
  [the shape of the coastline],
  [the pattern of trade],
  [the distribution of towns]
)

#mcq(38, [Nigeria's population policy has aimed chiefly at],
  [raising the birth rate],
  [ending the census],
  [slowing growth and improving maternal health],
  [encouraging emigration]
)

#mcq(39, [An ageing population creates a particular problem of],
  [paying pensions and health care with fewer workers],
  [a shortage of babies to carry goods],
  [too many schools],
  [too much farmland]
)

#mcq(40, [Which statement about density is correct?],
  [It can be high in a city and low in the surrounding state.],
  [It falls as the population grows.],
  [It is measured in people per hectare only.],
  [It is the same everywhere in a country.]
)

