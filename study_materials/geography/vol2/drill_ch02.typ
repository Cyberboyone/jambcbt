== 2.9 Chapter 2 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A settlement whose people work mainly on the land is described as],
  [rural],
  [suburban],
  [industrial],
  [urban]
)

#mcq(2, [The most important factor in the siting of early settlements was],
  [the railway],
  [electricity],
  [water supply],
  [the airport]
)

#mcq(3, [Houses scattered across farmland form a],
  [linear pattern],
  [dispersed pattern],
  [grid pattern],
  [nucleated pattern]
)

#mcq(4, [A settlement strung along a single road is],
  [dispersed],
  [nucleated],
  [planned],
  [linear]
)

#mcq(5, [Site differs from situation because site is],
  [the ground the settlement stands on],
  [the population of the settlement],
  [the position of the settlement in the region],
  [the age of the settlement]
)

#mcq(6, [The zone of a city with the highest land value per unit area is the],
  [residential suburb],
  [industrial estate],
  [central business district],
  [commuter village]
)

#mcq(7, [The concentric zone model places the CBD at the],
  [industrial belt],
  [centre],
  [northern side],
  [edge]
)

#mcq(8, [The proportion of a country's population living in towns is its],
  [urban hierarchy],
  [level of urbanisation],
  [urban sprawl],
  [rate of urbanisation]
)

#mcq(9, [A conurbation is],
  [a rural market],
  [a group of towns that have grown into one continuous area],
  [a single large village],
  [a planned capital]
)

#mcq(10, [The minimum number of customers needed to support a service is its],
  [threshold],
  [hierarchy],
  [range],
  [catchment]
)

#mcq(11, [Which service is found only in a city?],
  [a well],
  [a university],
  [a primary school],
  [a village shop]
)

#mcq(12, [The main cause of rapid urban growth in Nigeria is],
  [a falling death rate only],
  [international migration only],
  [rural–urban migration and natural increase],
  [government decrees]
)

#mcq(13, [A problem that follows rapid urbanisation is],
  [too much farmland],
  [a shortage of people],
  [a fall in demand for housing],
  [overcrowding and pressure on water supply]
)

#mcq(14, [Abuja was chosen as a new capital chiefly to],
  [serve the ports],
  [relieve pressure on Lagos and site the capital centrally],
  [replace Kano as a market],
  [be close to the oil fields]
)

#mcq(15, [A settlement pattern laid out in advance on a grid is],
  [linear],
  [planned],
  [nucleated],
  [dispersed]
)

#mcq(16, [Ibadan's early growth is best explained by],
  [a defensible site and the surrounding farmland],
  [its airport],
  [its port facilities],
  [its oil refinery]
)

#mcq(17, [Which of these is a function rather than a form of settlement?],
  [market town],
  [dispersed hamlet],
  [linear settlement],
  [nucleated village]
)

#mcq(18, [The commuter belt lies],
  [at the centre of a city],
  [under the CBD],
  [inside the CBD],
  [at the outer edge of a city, within daily travelling distance]
)

#mcq(19, [High rural population density is usually associated with],
  [thin soils and drought],
  [a cold climate],
  [fertile soils and reliable rainfall],
  [steep slopes]
)

#mcq(20, [The transition zone of a city typically contains],
  [the main banks and offices],
  [market gardens only],
  [warehouses, wholesalers and decaying housing],
  [the airport]
)

#mcq(21, [Linear settlements are commonly found along],
  [the middle of a plain],
  [the centre of a lake],
  [the top of a plateau],
  [roads, rivers and levees]
)

#mcq(22, [A hamlet is best described as],
  [a very small settlement with a few services],
  [a city of over 100 000],
  [a planned capital],
  [a port town]
)

#mcq(23, [The hierarchy of settlements is based on],
  [the height above sea level],
  [population size and the range of services],
  [the number of roads only],
  [the age of the buildings]
)

#mcq(24, [Rural–urban migration usually has which effect on the village?],
  [a rise in farm output],
  [a fall in land prices],
  [loss of young and skilled people],
  [an increase in the birth rate]
)

#mcq(25, [The chief problem of unplanned settlements in Nigerian cities is],
  [too much open space],
  [too few residents],
  [low land values],
  [flooding, fire and the absence of services]
)

#mcq(26, [A satellite town is built to],
  [serve as a capital],
  [store oil],
  [replace a port],
  [house overspill from a large city]
)

#mcq(27, [Which factor explains the siting of Kano?],
  [its deep-water port],
  [its coal mine],
  [its oil refinery],
  [its position at the southern end of the trans-Saharan route]
)

#mcq(28, [Land use in a city is decided chiefly by],
  [the rent people are willing to pay for access],
  [the number of schools],
  [the direction of the wind],
  [the age of the buildings]
)

#mcq(29, [A settlement with a port function is most likely to grow],
  [on a flood plain far inland],
  [on a mountain top],
  [at a natural harbour or river mouth],
  [in a desert]
)

#mcq(30, [Depopulation of rural areas is caused by],
  [the building of new schools],
  [out-migration of the young to towns],
  [a rise in the birth rate],
  [an influx of city workers]
)

#mcq(31, [Which statement about site and situation is correct?],
  [A town can have a poor site and an excellent situation.],
  [Situation is the same as site.],
  [A town cannot grow on a poor site.],
  [Site decides the regional importance.]
)

#mcq(32, [The CBD is characterised by],
  [the largest houses],
  [high-rise offices, banks and the main market],
  [open farmland],
  [the sewage works]
)

#mcq(33, [A settlement's catchment is],
  [its road network only],
  [its population],
  [the area from which it draws customers and services],
  [the land it is built on]
)

#mcq(34, [Urban sprawl refers to],
  [the uncontrolled outward spread of a city],
  [the building of a dam],
  [the rise of a market],
  [the growth of a village]
)

#mcq(35, [Which is a pull factor for migration to a city?],
  [better schools and hospitals],
  [insecurity],
  [land shortage],
  [drought]
)

#mcq(36, [The main difference between a town and a city in the hierarchy is],
  [the age of the settlement],
  [the colour of the roofs],
  [the number of roads],
  [the size of the population and the range of services]
)

#mcq(37, [Slum upgrading is a response to the problem of],
  [poor housing and services in unplanned areas],
  [air pollution from industry],
  [traffic congestion],
  [a shortage of farmland]
)

#mcq(38, [A market town in a rural area typically grows at],
  [the top of a mountain],
  [a crossroads or a river crossing],
  [the mouth of a delta],
  [the centre of a forest reserve]
)

#mcq(39, [The population threshold for an urban settlement in Nigeria is usually taken as],
  [500 people],
  [5 000 people],
  [20 000 people],
  [1 million people]
)

#mcq(40, [A ribbon development is another name for],
  [a planned estate],
  [a conurbation],
  [a nucleated village],
  [a linear settlement along a road]
)

