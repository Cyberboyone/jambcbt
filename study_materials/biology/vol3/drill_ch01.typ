  [nuclear RNA],
  [transfer RNA],
  [ribosomal RNA]
)

#mcq(13, [Which of the following is *not* a function of mitosis?],
  [Replacement of worn-out cells],
  [Repair of damaged tissue],
  [Growth of the body],
  [Formation of gametes]
