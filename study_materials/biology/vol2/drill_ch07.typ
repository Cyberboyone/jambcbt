== 7.8 Chapter 7 Practice Drill — 30 Questions

30 questions graded in the order the CBT engine is likely to meet them. Allow 33 minutes; the key and a full solution for every question follow.

#mcq(1, [Health is best defined as],
  [the absence of pain],
  [the ability to work hard],
  [a state of complete physical, mental and social well-being],
  [the absence of any disease]
)

#mcq(2, [Which of the following is a non-infectious disease?],
  [Tuberculosis],
  [Typhoid],
  [Cholera],
  [Sickle-cell anaemia]
)

#mcq(3, [Malaria in humans is caused by],
  [the protozoan Plasmodium],
  [the female Anopheles mosquito],
  [a virus],
  [a bacterium]
)

#mcq(4, [The vector of sleeping sickness is],
  [the Anopheles mosquito],
  [the housefly],
  [the flea],
  [the tsetse fly]
)

#mcq(5, [A disease that is spread by droplets in the air is],
  [ringworm],
  [cholera],
  [tuberculosis],
  [guinea worm]
)

#mcq(6, [Cholera is spread mainly by],
  [the bite of a mosquito],
  [droplets in the air],
  [water and food contaminated with faeces],
  [direct skin contact]
)

#mcq(7, [Guinea worm is transmitted when a person],
  [drinks water containing the Cyclops crustacean],
  [breathes in dust],
  [is bitten by a tsetse fly],
  [walks barefoot on contaminated soil]
)

#mcq(8, [Which of these diseases is caused by a fungus?],
  [Malaria],
  [Typhoid],
  [Ringworm],
  [Measles]
)

#mcq(9, [Antibiotics are effective against],
  [protozoa only],
  [all pathogens],
  [viruses],
  [bacteria]
)

#mcq(10, [The first line of defence of the body includes],
  [lymphocytes],
  [the skin and mucous membranes],
  [memory cells],
  [antibodies]
)

#mcq(11, [Phagocytes protect the body by],
  [making mucus],
  [engulfing and digesting pathogens],
  [producing antibodies],
  [releasing histamine only]
)

#mcq(12, [Antibodies are produced by],
  [red blood cells],
  [phagocytes],
  [lymphocytes],
  [platelets]
)

#mcq(13, [An antigen is],
  [a marker on the surface of a pathogen that the body recognises as foreign],
  [a white blood cell],
  [a protein made by a lymphocyte],
  [a type of antibiotic]
)

#mcq(14, [Which of the following gives active immunity?],
  [Recovery from an infection],
  [Antibodies in colostrum],
  [An injection of an antiserum],
  [Antibodies across the placenta]
)

#mcq(15, [A vaccine works because it],
  [replaces the white blood cells],
  [stimulates the body to make its own antibodies and memory cells],
  [supplies ready-made antibodies],
  [kills all bacteria in the blood]
)

#mcq(16, [A child who receives antibodies in colostrum acquires],
  [active artificial immunity],
  [passive artificial immunity],
  [active natural immunity],
  [passive natural immunity]
)

#mcq(17, [An antiserum given after a snake bite provides],
  [permanent immunity],
  [active artificial immunity],
  [active natural immunity],
  [passive artificial immunity]
)

#mcq(18, [The main reason for immunising a whole community is to],
  [eliminate all bacteria from the environment],
  [reduce the number of susceptible hosts so the pathogen cannot spread],
  [replace the need for clean water],
  [make every individual completely immune]
)

#mcq(19, [Which measure would most directly reduce the incidence of malaria?],
  [Covering the mouth when coughing],
  [Vaccinating against tuberculosis],
  [Draining stagnant water and using insecticide-treated nets],
  [Boiling drinking water]
)

#mcq(20, [The BCG vaccine protects against],
  [polio],
  [tuberculosis],
  [cholera],
  [tetanus]
)

#mcq(21, [Poliomyelitis is spread mainly by],
  [the bite of a mosquito],
  [droplets in the air],
  [contaminated water and food],
  [direct skin contact]
)

#mcq(22, [A fever helps in defence because it],
  [stops the heart from beating too fast],
  [slows the growth of many pathogens and speeds up the immune response],
  [kills all the body's own cells],
  [prevents dehydration]
)

#mcq(23, [The mucus and cilia of the respiratory tract],
  [produce antibodies],
  [trap dust and micro-organisms and sweep them upwards],
  [absorb oxygen],
  [digest bacteria]
)

#mcq(24, [Tetanus is acquired through],
  [breathing droplets],
  [a mosquito bite],
  [drinking contaminated water],
  [a wound contaminated with soil]
)

#mcq(25, [Which is not a route of transmission of HIV?],
  [Unprotected sexual intercourse],
  [Sharing a meal with an infected person],
  [From an infected mother to her child],
  [Transfusion of infected blood]
)

#mcq(26, [The main control measure for a water-borne disease is],
  [providing safe water and sanitation],
  [wearing a face mask],
  [vaccinating livestock],
  [killing mosquitoes]
)

#mcq(27, [A person who is a carrier of a disease],
  [cannot be treated],
  [shows all the symptoms of the disease],
  [harbours the pathogen and can pass it on without being ill],
  [is immune to the disease for life]
)

#mcq(28, [Which of these is an example of a mechanical vector?],
  [A person with measles],
  [A contaminated well],
  [A mosquito in which the malaria parasite multiplies],
  [A housefly carrying bacteria on its legs]
)

#mcq(29, [Which of the following is the most important reason for the continued spread of tuberculosis in crowded cities?],
  [Close contact and poor ventilation],
  [Lack of vitamin C],
  [Mosquito bites],
  [Contaminated water]
)

#mcq(30, [Oral rehydration therapy is used to treat],
  [tuberculosis],
  [ringworm],
  [malaria],
  [dehydration caused by diarrhoea]
)

