  [1.0 mm],
  [0.4 mm],
  [0.01 mm],
  [0.1 mm]
)

#mcq(17, [A quadrat is used to],
  [trap ground insects],
  [catch flying insects],
  [measure the temperature of the soil],
  [estimate the number of plants in a habitat]
)

