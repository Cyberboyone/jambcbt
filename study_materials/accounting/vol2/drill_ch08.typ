== 8.6 Chapter 8 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Public-sector accounting is primarily concerned with],
  [accounting for money raised and spent by law],
  [maximising profit],
  [valuing shares],
  [preparing a trial balance for shareholders]
)

#mcq(2, [The statement that compares the approved estimate with the actual expenditure is the],
  [vote account],
  [appropriation account],
  [statement of affairs],
  [realisation account]
)

#mcq(3, [A vote is],
  [a tax],
  [a unit of government revenue],
  [the sum approved by the legislature for a stated purpose],
  [a loan from the World Bank]
)

#mcq(4, [A ministry was voted ₦80,000,000 and spent ₦74,000,000. The unspent balance is],
  [₦154,000,000],
  [₦6,000,000],
  [nil],
  [₦74,000,000]
)

#mcq(5, [An unspent balance on a vote is],
  [a profit available for distribution],
  [paid to the accounting officer],
  [returned or carried forward under the financial regulations],
  [added to capital]
)

#mcq(6, [If actual expenditure exceeds the approved estimate, the accounting officer needs],
  [a new accounting system],
  [a supplementary vote before the overspend can be regularised],
  [a loan from a bank],
  [nothing, because the total vote may still be under]
)

#mcq(7, [Public-sector accounting in the traditional Nigerian system is kept on the],
  [cash basis],
  [marginal basis],
  [break-up basis],
  [accruals basis]
)

#mcq(8, [The public-sector equivalent of profit is],
  [capital employed],
  [value for money],
  [the trial balance],
  [cash flow]
)

#mcq(9, [Buying at the lowest proper price is the test of],
  [economy],
  [equity],
  [efficiency],
  [effectiveness]
)

#mcq(10, [Getting the most output from the resources used is the test of],
  [economy],
  [effectiveness],
  [equity],
  [efficiency]
)

#mcq(11, [Achieving the objective the money was voted for is the test of],
  [efficiency],
  [effectiveness],
  [economy],
  [prudence]
)

#mcq(12, [The Auditor-General reports to],
  [the president alone],
  [the legislature],
  [the Central Bank],
  [the ministry of finance]
)

#mcq(13, [A fund in public-sector accounting is],
  [a self-balancing set of accounts kept for a stated purpose],
  [a loan from a donor],
  [a bank account held abroad],
  [a reserve for the auditor]
)

#mcq(14, [Money for capital projects is kept in the],
  [consolidated revenue fund],
  [trust fund],
  [development fund],
  [contingency fund]
)

#mcq(15, [A fund set aside for unforeseen expenditure is the],
  [consolidated revenue fund],
  [development fund],
  [special fund],
  [contingency fund]
)

#mcq(16, [Money held for a stated beneficiary is kept in a],
  [trust fund],
  [contingency fund],
  [revenue fund],
  [development fund]
)

#mcq(17, [A surplus on the development fund],
  [is distributed as a dividend],
  [may not be used for a different purpose],
  [may be used to pay salaries],
  [is transferred to capital]
)

#mcq(18, [The transfer of funds between sub-heads of a vote with approval is called],
  [reconciliation],
  [virement],
  [appropriation],
  [realisation]
)

#mcq(19, [A computerised accounting system performs],
  [no double entry at all],
  [only the final accounts],
  [only one side of each transaction],
  [both sides of each transaction from a single entry]
)

#mcq(20, [The record of who entered what, and when, is the],
  [audit trail],
  [bank statement],
  [chart of accounts],
  [trial balance]
)

#mcq(21, [Validation in a computerised system],
  [checks that the entry is correct in law],
  [rejects an entry that is malformed or outside the rules],
  [reconciles the bank],
  [computes the depreciation]
)

#mcq(22, [Access rights in an accounting package exist to],
  [limit what each user may do],
  [back up the data],
  [speed up posting],
  [compute the VAT]
)

#mcq(23, [A back-up is a copy of the data kept],
  [in the trial balance],
  [in the audit trail],
  [away from the machine, so that it survives a failure],
  [on the same machine]
)

#mcq(24, [A computerised trial balance balances because],
  [each entry posts both sides automatically],
  [the auditor reviews every entry],
  [the chart of accounts is short],
  [the software checks every entry for economic meaning]
)

#mcq(25, [Which error would a computerised system fail to detect?],
  [an entry with no debit],
  [a purchase posted to the wrong expense account],
  [an amount in words instead of figures],
  [a transaction dated next year]
)

#mcq(26, [The main advantage of computerised accounting over a manual system is],
  [it needs no training],
  [it removes the need for judgement],
  [speed and accuracy of processing],
  [it eliminates fraud]
)

#mcq(27, [A disadvantage of computerised accounting is],
  [it cannot handle a large volume of transactions],
  [the loss of the trial balance],
  [the cost of hardware, software and training],
  [slower posting]
)

#mcq(28, [If the computer system fails without a back-up, the firm risks],
  [the loss of its accounting records],
  [a lower tax bill],
  [a higher profit],
  [a better audit]
)

#mcq(29, [The chart of accounts is],
  [the trial balance],
  [the list of the firm's customers],
  [the list of ledger accounts and their codes],
  [the bank statement]
)

#mcq(30, [In a computerised system, the source document is],
  [replaced by the audit trail],
  [no longer needed],
  [still needed as evidence of the transaction],
  [the computer printout of the trial balance]
)

#mcq(31, [A vote account is prepared by],
  [a company for its shareholders],
  [a government department for the legislature],
  [a partnership for its partners],
  [a club for its members]
)

#mcq(32, [Fund accounting is necessary because],
  [it increases the profit],
  [it replaces the vote account],
  [governments have no bank accounts],
  [each fund's money may be used only for its stated purpose]
)

#mcq(33, [The accounting basis that records revenue when it is earned and expenses when they are incurred is],
  [the cash basis],
  [the vote basis],
  [the break-up basis],
  [the accruals basis]
)

#mcq(34, [Which is a public-sector financial statement?],
  [the manufacturing account],
  [the appropriation account of a company],
  [the realisation account],
  [the statement of assets and liabilities]
)

#mcq(35, [Which control would stop a clerk posting a payment twice?],
  [a password change],
  [a new chart of accounts],
  [a bank reconciliation],
  [a printed trial balance]
)

#mcq(36, [The main risk created by a computerised system is that],
  [the audit trail is unnecessary],
  [errors are made more slowly],
  [a single wrong entry is replicated in every report built on it],
  [the trial balance cannot be produced]
)

#mcq(37, [An accounting package's report generator is useful because it],
  [replaces the accountant's judgement],
  [guarantees accuracy],
  [removes the need for source documents],
  [produces statements for any period quickly]
)

#mcq(38, [Which is NOT part of the accounting cycle in either a manual or a computerised system?],
  [extracting the trial balance],
  [electing the auditor],
  [posting to the ledger],
  [recording the transaction]
)

#mcq(39, [A government department spends ₦2,000,000 on a sub-head approved at ₦1,800,000. The vote account shows],
  [an unspent balance of ₦200,000],
  [a profit of ₦200,000],
  [an overspend of ₦200,000 which requires regularisation],
  [nothing unusual]
)

#mcq(40, [The main difference between a public entity and a company in accounting terms is that a public entity],
  [has shareholders],
  [accounts for voted funds rather than for profit],
  [keeps no records],
  [pays dividends]
)

