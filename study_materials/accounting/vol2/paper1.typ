== Section A — Manufacturing and the Elements of Cost (Questions 1–8)

#mcq(1, [The cost of production of a manufacturer is transferred to the],
  [manufacturing account],
  [trading account],
  [balance sheet],
  [profit and loss account]
)

#mcq(2, [Direct materials consumed is computed as],
  [purchases − carriage inwards + closing stock],
  [opening stock + purchases + carriage inwards − closing stock],
  [purchases + closing stock − opening stock],
  [opening stock + purchases − closing stock]
)

#mcq(3, [A manufacturer paid: opening raw materials ₦30,000, purchases ₦220,000, carriage inwards ₦10,000, closing raw materials ₦40,000. Material consumed is],
  [₦200,000],
  [₦220,000],
  [₦240,000],
  [₦230,000]
)

#mcq(4, [Which cost is a factory overhead?],
  [salary of the factory storekeeper],
  [wages of machine operators],
  [royalty paid per unit produced],
  [carriage outwards on finished goods]
)

#mcq(5, [Prime cost ₦240,000 and factory overhead ₦90,000. If opening work in progress is ₦20,000 and closing work in progress is ₦30,000, production cost is],
  [₦330,000],
  [₦360,000],
  [₦340,000],
  [₦320,000]
)

#mcq(6, [The cost of carriage outwards is charged to the],
  [work in progress],
  [trading account],
  [profit and loss account],
  [manufacturing account]
)

#mcq(7, [Goods completed at a cost of ₦150,000 are transferred to the trading account at ₦180,000. The manufacturing profit is],
  [nil],
  [₦180,000],
  [₦30,000],
  [₦150,000]
)

#mcq(8, [Which of these is NOT a cost of the factory?],
  [depreciation of factory machinery],
  [depreciation of the office computer],
  [factory power],
  [insurance of the factory building]
)

