== 5.6 Chapter 5 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A budget is best described as],
  [a financial plan prepared in advance for a defined period],
  [a trial balance for the year],
  [a record of past expenditure],
  [a statement of actual results]
)

#mcq(2, [Budgetary control is the process of],
  [auditing the accounts],
  [preparing a budget only],
  [comparing actual results with the budget and acting on the difference],
  [recording transactions]
)

#mcq(3, [The budget prepared first in the master budget is the],
  [materials budget],
  [sales budget],
  [production budget],
  [cash budget]
)

#mcq(4, [Budgeted sales 8,000 units, opening stock 500, closing stock 700. Production is],
  [8,000 units],
  [8,700 units],
  [8,200 units],
  [7,800 units]
)

#mcq(5, [Using the last figure, if each unit needs 3 kg of material, usage is],
  [24,000 kg],
  [8,200 kg],
  [24,600 kg],
  [24,900 kg]
)

#mcq(6, [Material usage 24,600 kg, opening stock 1,000 kg, closing stock 1,300 kg. Purchases are],
  [24,900 kg],
  [24,300 kg],
  [26,900 kg],
  [23,300 kg]
)

#mcq(7, [Using the last figure, at ₦4 a kg the purchases budget is],
  [₦99,600],
  [₦107,600],
  [₦97,200],
  [₦96,000]
)

#mcq(8, [The master budget is],
  [the cash budget alone],
  [the budget committee's minutes],
  [the set of all the functional budgets, summarised in the budgeted profit and loss, balance sheet and cash flow],
  [the sales budget alone]
)

#mcq(9, [The budget committee's main role is to],
  [keep the books],
  [co-ordinate the functional budgets and settle disputes between them],
  [prepare the trial balance],
  [audit the accounts]
)

#mcq(10, [A budget centre is],
  [the smallest unit for which a budget is prepared and a manager held responsible],
  [the firm's head office],
  [a department with no costs],
  [the bank account used for the budget]
)

#mcq(11, [Zero-based budgeting requires],
  [last year's figures plus an allowance for inflation],
  [no budget committee],
  [every cost to be justified afresh from zero],
  [the budget to start from zero profit]
)

#mcq(12, [Incremental budgeting is criticised because it],
  [is too detailed],
  [ignores inflation],
  [cannot be used by a firm],
  [carries forward past inefficiencies]
)

#mcq(13, [A fixed budget is one which],
  [does not change during the year],
  [is prepared by the government],
  [contains only fixed costs],
  [is prepared for a single level of activity]
)

#mcq(14, [A flexible budget is prepared],
  [at the actual level of activity],
  [at the beginning of the year only],
  [only for cash],
  [without any variable costs]
)

#mcq(15, [Budgeted fixed cost ₦20,000 and variable cost ₦6 a unit. The flexible budget at 3,000 units is],
  [₦20,000],
  [₦26,000],
  [₦18,000],
  [₦38,000]
)

#mcq(16, [Using the last figures, the actual cost at 3,000 units was ₦41,000. The variance against the flexible budget is],
  [₦3,000 adverse],
  [₦3,000 favourable],
  [nil],
  [₦21,000 adverse]
)

#mcq(17, [A variance is favourable when],
  [the budget was not prepared],
  [it is reported late],
  [actual profit is lower than budgeted],
  [actual cost is lower than budgeted, or revenue higher]
)

#mcq(18, [The materials price variance is usually the responsibility of the],
  [production supervisor],
  [accountant],
  [purchasing officer],
  [sales manager]
)

#mcq(19, [The materials usage variance is usually the responsibility of the],
  [sales manager],
  [purchasing officer],
  [cashier],
  [production supervisor]
)

#mcq(20, [Which item does NOT appear in a cash budget?],
  [wages paid],
  [depreciation of plant],
  [proceeds of a loan],
  [payment to a creditor]
)

#mcq(21, [A credit sale made in January, for which the debtor pays in March, enters the cash budget in],
  [January],
  [February],
  [March],
  [never]
)

#mcq(22, [Opening cash ₦15,000, receipts ₦80,000, payments ₦70,000. The closing balance is],
  [₦10,000],
  [₦5,000],
  [₦25,000],
  [₦95,000]
)

#mcq(23, [Opening cash ₦8,000, receipts ₦40,000, payments ₦60,000, minimum balance ₦5,000. The loan needed is],
  [₦7,000],
  [₦17,000],
  [₦5,000],
  [₦12,000]
)

#mcq(24, [A cash budget that ends in a negative balance shows that],
  [the firm is profitable],
  [the firm needs finance or must delay payments],
  [the budget is unnecessary],
  [the arithmetic is wrong]
)

#mcq(25, [The cash budget differs from the profit and loss account because it records],
  [only credit transactions],
  [only capital items],
  [cash received and cash paid],
  [income earned and expenses incurred]
)

#mcq(26, [Which of these is a cash receipt?],
  [a provision for doubtful debts],
  [a debtor paying his account],
  [a bad debt written off],
  [a credit sale]
)

#mcq(27, [Budget slack is],
  [the difference between budgeted and actual sales],
  [the padding a manager builds into his budget to make it easy to meet],
  [the difference between the cash and profit budgets],
  [unspent cash]
)

#mcq(28, [Participative budgeting means],
  [the budget is imposed from above],
  [no budget is prepared],
  [the managers who will be held to it help to prepare it],
  [the budget is prepared by the auditor]
)

#mcq(29, [A budget period is usually],
  [one year, divided into shorter control periods],
  [one month],
  [five years],
  [the life of the firm]
)

#mcq(30, [The sales budget is expressed in],
  [units only],
  [units and revenue],
  [labour hours],
  [cash only]
)

#mcq(31, [Labour hours required are computed as],
  [production units × standard hours per unit],
  [sales units × standard hours per unit],
  [production units ÷ hours per unit],
  [fixed cost ÷ wage rate]
)

#mcq(32, [A firm plans to sell 5,000 units at ₦40, with variable cost ₦25 and fixed cost ₦50,000. Budgeted profit is],
  [₦75,000],
  [₦200,000],
  [₦125,000],
  [₦25,000]
)

#mcq(33, [If the sales budget is not achieved, the first consequence for the production budget is],
  [fewer units are needed, so material and labour budgets fall],
  [fixed cost rises],
  [the cash budget is unaffected],
  [more units must be produced]
)

#mcq(34, [Budgeting helps co-ordination because],
  [it sets the tax rate],
  [it replaces the ledger],
  [it records past transactions],
  [each department's plan is reconciled with the others before the year begins]
)

#mcq(35, [The principal purpose of a cash budget is to],
  [value stock],
  [plan the timing of receipts and payments],
  [measure profit],
  [calculate depreciation]
)

#mcq(36, [An adverse variance in labour efficiency means],
  [fewer hours were worked than standard],
  [more hours were worked than standard for the output achieved],
  [the budget was not flexed],
  [the wage rate was lower than standard]
)

#mcq(37, [Which budget would show the purchase of a new machine?],
  [the production budget],
  [the materials budget],
  [the cash budget and the capital expenditure budget],
  [the sales budget]
)

#mcq(38, [A budget that is set too tightly is likely to],
  [reduce budget slack to zero],
  [motivate the workforce to exceed it],
  [demotivate the workforce because it cannot be met],
  [increase sales]
)

#mcq(39, [Which sequence is correct?],
  [production, sales, materials, cash],
  [sales, production, materials, cash],
  [cash, sales, production, materials],
  [materials, sales, production, cash]
)

#mcq(40, [Budgetary control compares],
  [cash with profit],
  [actual with budget, and investigates the difference],
  [this year with last year only],
  [budget with budget]
)

