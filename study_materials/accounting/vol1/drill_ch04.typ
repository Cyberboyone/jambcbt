== 4.6 Chapter 4 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A sales ledger control account summarises],
  [the debtors ledger],
  [the purchases ledger],
  [the nominal ledger],
  [the cash book]
)

#mcq(2, [The balance of the sales ledger control account should equal],
  [the cash received],
  [the total of the credit sales],
  [the total of the debit balances in the debtors ledger],
  [the total of the sales day book]
)

#mcq(3, [Which item increases what debtors owe?],
  [receipts from debtors],
  [credit sales],
  [returns inwards],
  [discounts allowed]
)

#mcq(4, [Which item reduces what debtors owe?],
  [interest charged on overdue accounts],
  [credit sales],
  [dishonoured cheques],
  [returns inwards]
)

#mcq(5, [Opening debtors ₦320,000; credit sales ₦1,450,000; receipts ₦1,300,000; returns inwards ₦40,000; bad debts ₦15,000. Closing debtors are],
  [₦455,000],
  [₦415,000],
  [₦405,000],
  [₦735,000]
)

#mcq(6, [Closing debtors ₦250,000; opening debtors ₦180,000; receipts from debtors ₦500,000; returns inwards ₦20,000. Credit sales were],
  [₦590,000],
  [₦610,000],
  [₦650,000],
  [₦550,000]
)

#mcq(7, [Opening creditors ₦200,000; credit purchases ₦800,000; payments ₦750,000; returns outwards ₦30,000. Closing creditors are],
  [₦280,000],
  [₦220,000],
  [₦250,000],
  [₦780,000]
)

#mcq(8, [A dishonoured cheque in the sales ledger control account is],
  [ignored],
  [added],
  [treated as a discount],
  [deducted]
)

#mcq(9, [Discounts allowed appear on which side of the sales ledger control account?],
  [both],
  [credit],
  [debit],
  [neither]
)

#mcq(10, [A contra entry in control accounts arises when],
  [a debtor also owes the firm],
  [a bad debt is written off],
  [a customer is also a supplier],
  [a cheque is dishonoured]
)

#mcq(11, [The purchases ledger control account is used to],
  [record cash purchases],
  [value stock],
  [control the creditors ledger],
  [compute profit]
)

#mcq(12, [A bank statement is a record kept by],
  [the bank],
  [the firm],
  [the customer],
  [the auditor]
)

#mcq(13, [Unpresented cheques are cheques that],
  [have not been recorded in the cash book],
  [have not yet been presented to the bank],
  [the bank has refused to pay],
  [have been lost in the post]
)

#mcq(14, [Lodgements not yet credited are receipts that],
  [were dishonoured],
  [the bank has not yet credited],
  [the firm has not recorded],
  [the bank has credited twice]
)

#mcq(15, [A bank statement shows a credit balance of ₦800,000; unpresented cheques are ₦120,000 and uncredited lodgements ₦60,000. The cash book balance is],
  [₦620,000],
  [₦860,000],
  [₦740,000],
  [₦980,000]
)

#mcq(16, [A cash book has a debit balance of ₦610,000. Bank charges ₦12,000, a standing order ₦45,000 and a direct credit ₦80,000 have not been recorded. The adjusted cash book balance is],
  [₦618,000],
  [₦648,000],
  [₦633,000],
  [₦667,000]
)

#mcq(17, [Bank charges are recorded in the cash book by],
  [crediting the cash book],
  [debiting the cash book],
  [ignoring them],
  [debiting the bank statement]
)

#mcq(18, [A direct credit from a customer, appearing only on the statement, is],
  [added to the cash book],
  [deducted from the cash book],
  [ignored],
  [added to the statement]
)

#mcq(19, [A standing order paid by the bank is],
  [a discount received],
  [added to the cash book],
  [added to capital],
  [deducted from the cash book]
)

#mcq(20, [A dishonoured cheque is recorded by],
  [debiting bank charges],
  [no entry],
  [crediting the cash book and debiting the debtor],
  [debiting the cash book and crediting the debtor]
)

#mcq(21, [In a bank reconciliation, unpresented cheques are],
  [deducted from the statement balance],
  [ignored],
  [added to the cash book],
  [added to the statement balance]
)

#mcq(22, [An error made by the bank in the firm's account should be],
  [reported to the bank for correction],
  [corrected in the cash book],
  [charged to profit],
  [ignored]
)

#mcq(23, [A credit balance on the bank statement means],
  [the cash book is wrong],
  [the firm is overdrawn],
  [the firm has money in the account],
  [the bank owes the firm nothing]
)

#mcq(24, [A debit balance in the cash book column of the cash book means],
  [an overdraft],
  [a bank error],
  [a loan],
  [money at the bank]
)

#mcq(25, [The first step in a bank reconciliation is to],
  [prepare the trial balance],
  [adjust the bank statement],
  [write off bad debts],
  [adjust the cash book]
)

#mcq(26, [Which item appears in the cash book but never in the bank statement until it is presented?],
  [bank charges],
  [a direct debit],
  [interest credited by the bank],
  [an unpresented cheque]
)

#mcq(27, [Which item appears on the bank statement but not in the cash book until it is posted?],
  [a lodgement not yet credited],
  [a standing order],
  [a cheque written but not presented],
  [an unpresented cheque]
)

#mcq(28, [If the cash book shows an overdraft of ₦50,000 and the bank charges ₦10,000 are unrecorded, the adjusted position is],
  [a balance of ₦40,000],
  [an overdraft of ₦60,000],
  [an overdraft of ₦40,000],
  [a balance of ₦60,000]
)

#mcq(29, [The purpose of a bank reconciliation is to],
  [compute profit],
  [increase the cash book balance],
  [hide an error],
  [explain the difference between two records]
)

#mcq(30, [A control account is also known as a],
  [nominal account],
  [suspense account],
  [memorandum account],
  [total account]
)

#mcq(31, [The balance on the sales ledger control account is a],
  [capital balance],
  [nil balance],
  [credit balance],
  [debit balance]
)

#mcq(32, [The balance on the purchases ledger control account is a],
  [debit balance],
  [drawings balance],
  [credit balance],
  [nil balance]
)

#mcq(33, [Discount received is recorded in the purchases ledger control account as],
  [a bad debt],
  [a debit],
  [an addition to purchases],
  [a credit]
)

#mcq(34, [Interest charged to a customer on an overdue account is recorded in the control account as],
  [a debit],
  [a bad debt],
  [a discount],
  [a credit]
)

#mcq(35, [Which of these is a timing difference, not an error?],
  [a wrong addition in the cash book],
  [an unpresented cheque],
  [a transposition],
  [a posting to the wrong account]
)

#mcq(36, [If the trial balance difference is entered in a suspense account, the bank reconciliation],
  [is unaffected],
  [must be prepared first],
  [cannot be prepared],
  [absorbs the difference]
)

#mcq(37, [A cheque paid into the bank and returned marked "refer to drawer" is],
  [a dishonoured cheque],
  [an unpresented cheque],
  [a direct credit],
  [a standing order]
)

#mcq(38, [The bank column of the cash book showed a debit balance of ₦240,000; the bank statement showed ₦180,000. The most likely cause is],
  [uncredited lodgements exceeding unpresented cheques by ₦60,000],
  [unpresented cheques exceeding uncredited lodgements by ₦60,000],
  [an overdraft],
  [a bank error of ₦240,000]
)

#mcq(39, [Which reconciliation item requires an entry in the cash book?],
  [a cheque written but not presented],
  [a lodgement not yet credited],
  [bank charges],
  [an unpresented cheque]
)

#mcq(40, [A bank reconciliation statement is prepared by],
  [the auditor],
  [the tax office],
  [the firm],
  [the bank]
)

