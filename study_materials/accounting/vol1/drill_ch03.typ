== 3.6 Chapter 3 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A source document is],
  [the ledger account],
  [the paper that proves a transaction took place],
  [the trial balance],
  [the balance sheet]
)

#mcq(2, [An invoice is issued by],
  [the carrier],
  [the seller],
  [the buyer],
  [the bank]
)

#mcq(3, [A credit note is issued by],
  [the bank, for charges],
  [the seller, to reduce the buyer's account],
  [the carrier, for loss in transit],
  [the buyer, for goods returned]
)

#mcq(4, [A debit note is issued by],
  [the buyer],
  [the bank],
  [the auditor],
  [the seller]
)

#mcq(5, [A delivery note differs from an invoice because it],
  [replaces a receipt],
  [shows prices],
  [is issued by the buyer],
  [does not show prices]
)

#mcq(6, [A cheque stub is evidence of],
  [a return],
  [a credit sale],
  [a receipt of cash],
  [a payment made]
)

#mcq(7, [A petty cash voucher supports],
  [a wage sheet],
  [a credit sale],
  [a bank loan],
  [a small payment from the imprest]
)

#mcq(8, [A statement of account is],
  [an order],
  [a demand for immediate payment],
  [a summary of transactions and the balance due],
  [a receipt]
)

#mcq(9, [Credit sales are first recorded in the],
  [cash book],
  [general journal],
  [purchases day book],
  [sales day book]
)

#mcq(10, [Credit purchases are first recorded in the],
  [sales day book],
  [returns outwards book],
  [general journal],
  [purchases day book]
)

#mcq(11, [Goods returned by customers are recorded in the],
  [general journal],
  [sales day book],
  [returns inwards book],
  [returns outwards book]
)

#mcq(12, [Goods returned to suppliers are recorded in the],
  [cash book],
  [returns outwards book],
  [purchases day book],
  [returns inwards book]
)

#mcq(13, [Which transaction goes in the general journal?],
  [cash received from a debtor],
  [a credit purchase],
  [the purchase of a motor van on credit],
  [a credit sale]
)

#mcq(14, [The cash book is unusual because it is],
  [not a book of original entry],
  [kept by the bank],
  [only a memorandum],
  [both a book of original entry and a ledger account]
)

#mcq(15, [The ledger is best described as],
  [a statement of profit],
  [a list of balances],
  [a book of documents],
  [a set of accounts]
)

#mcq(16, [The personal ledger contains],
  [expense accounts],
  [asset accounts],
  [debtors and creditors accounts],
  [capital accounts]
)

#mcq(17, [The total of the sales day book is posted to],
  [debit sales, credit debtors],
  [debit cash, credit sales],
  [debit debtors, credit sales],
  [debit purchases, credit sales]
)

#mcq(18, [The total of the purchases day book is posted to],
  [debit stock, credit cash],
  [debit cash, credit purchases],
  [debit creditors, credit purchases],
  [debit purchases, credit creditors]
)

#mcq(19, [A trial balance is a list of],
  [all transactions],
  [the debtors only],
  [the balances in the ledger],
  [the source documents]
)

#mcq(20, [Which account would appear in the credit column of a trial balance?],
  [rent],
  [sales],
  [debtors],
  [machinery]
)

#mcq(21, [Which account would appear in the debit column of a trial balance?],
  [purchases],
  [creditors],
  [bank overdraft],
  [capital]
)

#mcq(22, [The trial balance does NOT prove that],
  [the arithmetic of the ledger is correct],
  [debits equal credits],
  [the totals agree],
  [no transaction was omitted]
)

#mcq(23, [A trial balance shows debits of ₦860,000 and credits of ₦803,000. The difference is],
  [₦57,000 debit],
  [₦57,000 credit],
  [nil],
  [₦1,663,000]
)

#mcq(24, [The document sent by a seller to confirm that goods have been returned by a customer is],
  [an invoice],
  [a receipt],
  [a credit note],
  [a debit note]
)

#mcq(25, [A receipt is evidence that],
  [money has been paid],
  [goods were ordered],
  [a discount was allowed],
  [goods were delivered]
)

#mcq(26, [Which document would a firm use to claim a reduction from a supplier?],
  [debit note],
  [statement],
  [invoice],
  [credit note]
)

#mcq(27, [Posting from the returns inwards book is],
  [debit cash, credit returns inwards],
  [debit sales, credit returns inwards],
  [debit debtors, credit returns inwards],
  [debit returns inwards, credit debtors]
)

#mcq(28, [Posting from the returns outwards book is],
  [debit purchases, credit creditors],
  [debit returns outwards, credit cash],
  [debit creditors, credit returns outwards],
  [debit returns outwards, credit creditors]
)

#mcq(29, [Which is a real account?],
  [sales],
  [wages],
  [machinery],
  [rent]
)

#mcq(30, [Which is a nominal account?],
  [creditors],
  [wages],
  [cash],
  [debtors]
)

#mcq(31, [A trial balance is prepared],
  [instead of the ledger],
  [only at the end of the firm's life],
  [before the ledger is written],
  [after the ledger has been balanced off]
)

#mcq(32, [If a trial balance has equal totals, an error of principle],
  [is not disclosed],
  [must be corrected in the suspense account],
  [doubles the difference],
  [is disclosed]
)

#mcq(33, [The document that accompanies goods and is signed by the buyer is the],
  [statement],
  [invoice],
  [delivery note],
  [credit note]
)

#mcq(34, [A firm that records a sale of ₦5,000 as ₦500 in both the sales account and the debtor's account has made],
  [an error of original entry],
  [a compensating error],
  [an error of principle],
  [an error of omission]
)

#mcq(35, [Which book would record the purchase of office furniture on credit?],
  [general journal],
  [returns outwards book],
  [cash book],
  [purchases day book]
)

#mcq(36, [The debtors ledger is a],
  [cash book],
  [nominal ledger],
  [personal ledger],
  [private ledger]
)

#mcq(37, [A trial balance is taken mainly to],
  [detect arithmetic errors in the double entry],
  [value the stock],
  [prepare the bank reconciliation],
  [compute the profit]
)

#mcq(38, [Which of these would NOT appear in a trial balance?],
  [closing stock],
  [wages],
  [cash],
  [capital]
)

#mcq(39, [The correct sequence is],
  [document, journal, ledger, trial balance],
  [ledger, document, journal, trial balance],
  [trial balance, ledger, journal, document],
  [journal, document, trial balance, ledger]
)

#mcq(40, [The total of the returns inwards book is posted to],
  [debit sales, credit debtors],
  [debit debtors, credit returns inwards],
  [debit cash, credit returns inwards],
  [debit returns inwards, credit debtors]
)

