== 6.6 Chapter 6 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [Which error leaves a trial balance in agreement?],
  [omitting a credit balance from the trial balance],
  [recording a sale without its double entry],
  [overcasting the debit column of the trial balance],
  [posting a purchase to the wrong supplier's account]
)

#mcq(2, [An error of omission occurs when],
  [an entry is made on the wrong side],
  [a transaction is left out of the books altogether],
  [a transaction is entered twice],
  [a wrong amount is entered]
)

#mcq(3, [An error of commission is],
  [a reversed figure],
  [an omitted transaction],
  [a capital item treated as revenue],
  [a posting to the wrong account of the same class]
)

#mcq(4, [An error of principle is],
  [a transaction left out],
  [a wrong amount in both accounts],
  [a wrong addition],
  [a capital item treated as revenue or the reverse]
)

#mcq(5, [Goods bought for the owner were debited to purchases. This is an error of],
  [commission],
  [original entry],
  [principle],
  [omission]
)

#mcq(6, [A motor vehicle was debited to motor expenses. This is an error of],
  [omission],
  [transposition],
  [commission],
  [principle]
)

#mcq(7, [Sales of ₦4,500 were entered as ₦5,400 in both accounts. This is an error of],
  [principle],
  [commission],
  [original entry],
  [omission]
)

#mcq(8, [Two errors that cancel each other are called],
  [errors of principle],
  [compensating errors],
  [errors of commission],
  [errors of original entry]
)

#mcq(9, [The difference on a trial balance is ₦900. The most likely cause is],
  [an error of omission],
  [an error of principle],
  [a compensating error],
  [a transposition]
)

#mcq(10, [The difference on a trial balance is ₦240. This may be caused by],
  [an entry posted to the wrong side of an account],
  [an omission],
  [a compensating error],
  [a transposition]
)

#mcq(11, [If the debits exceed the credits, the suspense account is],
  [closed to capital],
  [not used],
  [credited],
  [debited]
)

#mcq(12, [A suspense account is opened to],
  [allow a trial balance to be produced while errors are found],
  [record profit],
  [replace the ledger],
  [hide errors]
)

#mcq(13, [A credit sale of ₦30,000 was not posted to the debtor's account. The correction is],
  [debit sales, credit suspense],
  [debit suspense, credit debtor],
  [debit suspense, credit sales],
  [debit debtor, credit suspense]
)

#mcq(14, [A purchase of ₦18,000 was not posted to the creditor's account. The correction is],
  [debit creditor, credit purchases],
  [debit suspense, credit creditor],
  [debit creditor, credit suspense],
  [debit purchases, credit suspense]
)

#mcq(15, [Sales were undercast by ₦25,000. The correction is],
  [debit sales, credit debtors],
  [debit suspense, credit sales],
  [debit debtors, credit sales],
  [debit sales, credit suspense]
)

#mcq(16, [Sales were overcast by ₦45,000. Reported profit of ₦300,000 should be corrected to],
  [₦300,000],
  [₦345,000],
  [₦245,000],
  [₦255,000]
)

#mcq(17, [Rent was undercast by ₦20,000. Profit will be],
  [overstated by ₦40,000],
  [unaffected],
  [overstated by ₦20,000],
  [understated by ₦20,000]
)

#mcq(18, [Purchases overcast by ₦25,000 will cause profit to be],
  [understated by ₦25,000],
  [understated by ₦50,000],
  [overstated by ₦25,000],
  [unaffected]
)

#mcq(19, [Cash received from a debtor was completely omitted. Profit is],
  [overstated],
  [understated by half],
  [understated],
  [unaffected]
)

#mcq(20, [Which error affects the balance sheet but not the profit?],
  [sales overcast],
  [rent undercast],
  [a purchase of a vehicle debited to machinery],
  [wages omitted]
)

#mcq(21, [The journal entry to correct an error must include],
  [a narration],
  [a trial balance],
  [a receipt],
  [a bank statement]
)

#mcq(22, [After all errors are corrected, the suspense account must show],
  [a nil balance],
  [a credit balance],
  [a debit balance],
  [a capital balance]
)

#mcq(23, [A trial balance has a debit balance in the suspense account of ₦57,000. This means],
  [the account was closed],
  [debits exceeded credits],
  [an error of principle occurred],
  [credits exceeded debits]
)

#mcq(24, [The correction of an error of principle involving a fixed asset requires],
  [a reversal of the trial balance],
  [an entry through the suspense account],
  [a new trial balance],
  [no suspense entry, because both sides were posted]
)

#mcq(25, [Which is an error of original entry?],
  [a transaction left out],
  [a purchase of ₦9,000 entered as ₦900],
  [a vehicle in the repairs account],
  [a sale to Musa posted to Bello]
)

#mcq(26, [If both an asset and a liability are overstated by the same amount, this is],
  [a compensating error],
  [a transposition],
  [an error of commission],
  [an error of principle]
)

#mcq(27, [A bank statement was debited instead of the cash book. This is],
  [an error of commission],
  [a transposition],
  [an error of principle],
  [a compensating error]
)

#mcq(28, [The effect of failing to record a credit purchase is],
  [profit overstated and creditors understated],
  [profit and creditors overstated],
  [no effect on profit],
  [profit and creditors understated]
)

#mcq(29, [Which item would be corrected through the general journal rather than a day book?],
  [a credit sale],
  [the correction of a wrong posting],
  [a credit purchase],
  [cash received]
)

#mcq(30, [Undercasting the sales day book will],
  [have no effect],
  [overstate sales and debtors],
  [affect only the cash book],
  [understate sales and debtors]
)

#mcq(31, [Interest allowed to a customer on an overdue account, entered only in the customer's account, gives],
  [an error of principle],
  [a suspense balance],
  [a compensating error],
  [no difference]
)

#mcq(32, [A trial balance difference of ₦1,200 was traced to a purchase of ₦600 entered on the wrong side. The error is],
  [₦600],
  [₦2,400],
  [₦1,200],
  [nil]
)

#mcq(33, [Which is NOT an error that affects the trial balance?],
  [posting a sale to the wrong debtor],
  [entering a debit as a credit],
  [adding a column wrongly],
  [omitting a credit balance from the trial balance]
)

#mcq(34, [Correcting an error of principle involving revenue expenditure treated as capital will],
  [have no effect on profit],
  [increase profit and increase the asset],
  [increase profit and reduce the asset],
  [reduce profit and reduce the asset]
)

#mcq(35, [A compensating error is dangerous because],
  [it affects the stock],
  [it conceals two errors at once],
  [it changes the bank balance],
  [it shows in the trial balance]
)

#mcq(36, [The general journal is used for],
  [credit purchases],
  [corrections and other non-routine entries],
  [cash payments],
  [credit sales]
)

#mcq(37, [If the suspense account balance is not cleared by the year end, the accounts are],
  [automatically rebalanced],
  [incomplete and the error must be disclosed],
  [illegal],
  [correct]
)

#mcq(38, [Which pairing is correct?],
  [error of commission — a reversed figure],
  [compensating error — a capital item in revenue],
  [error of omission — a transaction left out of the books],
  [error of principle — wrong amount in both accounts]
)

#mcq(39, [Recording a credit sale of ₦5,000 as a cash sale of ₦5,000 is an error of],
  [commission],
  [principle],
  [original entry],
  [omission]
)

#mcq(40, [A sale of ₦6,000 to Musa was posted to Musa's account only. The effect is],
  [no difference],
  [a suspense balance of ₦6,000],
  [a compensating error],
  [an error of principle]
)

