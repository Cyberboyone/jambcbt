== 7.7 Chapter 7 Practice Drill — 40 Questions

40 questions graded in the order the CBT engine is likely to meet them. Allow 44 minutes; the key and a full solution for every question follow.

#mcq(1, [A partnership is formed by],
  [at least ten persons],
  [one person and a company only],
  [at least seven persons],
  [at least two persons]
)

#mcq(2, [The maximum number of partners in an ordinary partnership is],
  [twenty],
  [ten],
  [unlimited],
  [fifty]
)

#mcq(3, [Where there is no partnership deed, profits are shared],
  [equally],
  [in the capital ratio],
  [according to age],
  [according to time devoted]
)

#mcq(4, [With no deed, interest on capital is],
  [5%],
  [allowed at the bank rate],
  [not allowed],
  [10%]
)

#mcq(5, [Partners' salaries are],
  [a deduction from capital],
  [a current liability],
  [an appropriation of profit],
  [an expense in the profit and loss account]
)

#mcq(6, [Interest on drawings is],
  [credited in the appropriation account],
  [added to drawings],
  [debited in the appropriation account],
  [an expense]
)

#mcq(7, [Interest on capital is calculated on],
  [the current account],
  [drawings],
  [the opening capital],
  [the closing capital]
)

#mcq(8, [A partner's capital account is normally],
  [closed every year],
  [used for salaries],
  [kept fixed unless new capital is introduced],
  [debited with drawings]
)

#mcq(9, [A partner's current account is credited with],
  [drawings],
  [his share of loss],
  [interest on drawings],
  [salary, interest on capital and share of profit]
)

#mcq(10, [A debit balance on a partner's current account means],
  [the firm owes him],
  [the account has been closed],
  [he has no capital],
  [he owes the firm]
)

#mcq(11, [Net profit ₦800,000; salaries ₦200,000; interest on capital ₦50,000. The residual profit is],
  [₦1,050,000],
  [₦550,000],
  [₦600,000],
  [₦650,000]
)

#mcq(12, [Residual profit ₦550,000 shared 3 : 2. The larger share is],
  [₦220,000],
  [₦275,000],
  [₦360,000],
  [₦330,000]
)

#mcq(13, [A partner with salary ₦120,000, interest ₦30,000 and residual share ₦330,000 receives in total],
  [₦330,000],
  [₦480,000],
  [₦450,000],
  [₦510,000]
)

#mcq(14, [A current account opens at ₦60,000 credit; salary ₦120,000; interest ₦30,000; profit share ₦330,000; drawings ₦150,000. The closing balance is],
  [₦390,000 debit],
  [₦330,000 credit],
  [₦270,000 credit],
  [₦390,000 credit]
)

#mcq(15, [Interest on capital at 6% on capitals of ₦800,000 and ₦500,000 totals],
  [₦58,000],
  [₦130,000],
  [₦78,000],
  [₦48,000]
)

#mcq(16, [Goodwill raised on the admission of a partner is credited to],
  [the firm's creditors],
  [the revaluation account],
  [the old partners in the old ratio],
  [the new partner]
)

#mcq(17, [On admission, assets are revalued so that],
  [the new partner shares past gains],
  [goodwill disappears],
  [the new partner does not share past gains],
  [the firm pays less tax]
)

#mcq(18, [On dissolution, which is paid first?],
  [partners' loans],
  [outside creditors],
  [partners' capitals],
  [the partners' drawings]
)

#mcq(19, [A partnership deed usually provides for all EXCEPT],
  [interest on capital],
  [the profit-sharing ratio],
  [the procedure for admitting a partner],
  [the price at which goods are sold]
)

#mcq(20, [A partner who contributes capital but takes no part in management is a],
  [quasi partner],
  [limited partner],
  [nominal partner],
  [sleeping partner]
)

#mcq(21, [A partner whose liability is limited to his capital is a],
  [sleeping partner],
  [limited partner],
  [nominal partner],
  [active partner]
)

#mcq(22, [A person who lends his name to the firm without contributing capital is a],
  [limited partner],
  [sleeping partner],
  [nominal partner],
  [quasi partner]
)

#mcq(23, [A retired partner who allows his name to remain in the firm is a],
  [quasi partner],
  [nominal partner],
  [limited partner],
  [sleeping partner]
)

#mcq(24, [In the absence of a deed, a partner who incurs a loss must bear it],
  [alone],
  [not at all],
  [according to capital],
  [equally]
)

#mcq(25, [The appropriation account begins with],
  [capital],
  [sales],
  [net profit],
  [gross profit]
)

#mcq(26, [If drawings exceed the profit share, the partner's current account],
  [shows a credit balance],
  [is transferred to capital],
  [shows a debit balance],
  [is closed]
)

#mcq(27, [Interest on a partner's loan to the firm is],
  [a drawing],
  [an expense of the firm],
  [an appropriation],
  [a dividend]
)

#mcq(28, [A partner's share of residual loss is debited to],
  [the profit and loss account],
  [his current account],
  [the appropriation account],
  [the revaluation account]
)

#mcq(29, [Goodwill is],
  [a liability],
  [a reserve],
  [a tangible asset],
  [an intangible asset representing reputation and custom]
)

#mcq(30, [On the retirement of a partner, the balance on his current account is],
  [settled or transferred to a loan account],
  [ignored],
  [written off],
  [transferred to goodwill]
)

#mcq(31, [Which statement about a partnership is true?],
  [it ends on the death of a partner unless the deed provides otherwise],
  [it is a separate legal person],
  [it has perpetual succession],
  [its accounts must be published]
)

#mcq(32, [A partnership that has no written agreement is governed by],
  [the court's discretion alone],
  [the deed of the nearest firm],
  [the Companies Act],
  [the Partnership Act]
)

#mcq(33, [Which is an advantage of a partnership over a sole proprietorship?],
  [perpetual succession],
  [greater capital and shared skills],
  [freedom from tax],
  [unlimited liability]
)

#mcq(34, [A partner's salary is credited to his],
  [current account],
  [capital account],
  [loan account],
  [drawings account]
)

#mcq(35, [When a partner is admitted, the revaluation gain is shared by],
  [all partners in the new ratio],
  [the old partners in the old ratio],
  [the new partner alone],
  [the creditors]
)

#mcq(36, [Interest on drawings is calculated on],
  [the opening capital],
  [the closing capital],
  [the salary],
  [the amount drawn and the period it was outstanding]
)

#mcq(37, [The capital accounts of partners appear in the balance sheet as],
  [current liabilities],
  [part of the owners' equity],
  [long-term liabilities],
  [fixed assets]
)

#mcq(38, [If the partnership deed provides for interest on capital but the firm makes a loss, the interest is],
  [not charged],
  [still charged, increasing the loss],
  [paid by the bank],
  [added to goodwill]
)

#mcq(39, [A partnership's profit and loss account is prepared],
  [before the appropriation account],
  [after the appropriation account],
  [instead of the appropriation account],
  [only when there is a deed]
)

#mcq(40, [Which is NOT a characteristic of a partnership?],
  [joint and several liability],
  [shared profits],
  [mutual agency],
  [limited liability for all partners]
)

